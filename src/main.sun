using std;

/** Hosts the video workflow on the GTK thread while polling subprocesses between event turns. */
module sun_video_editor {

  /** Services chooser requests without allowing native objects into application state. */
  function dialogs(renderer: ref ui_gtk.Renderer, state: ref State) bool throws {
    var changed = false;
    if (state.open_requested) {
      state.open_requested = false;
      renderer.choose_input();
    }
    if (state.save_requested) {
      state.save_requested = false;
      state.capture_save_source = String("");
      var filename = String("converted");
      filename.append(video.extension(state.settings.format));
      renderer.choose_output(filename);
    }
    if (state.capture_save_requested) {
      state.capture_save_requested = false;
      state.capture_save_source = state.capture.saved.clone(make_heap_allocator());
      var filename = String(
        state.capture.kind == 0 ? "Screenshot.png" : (state.capture.saved.ends_with(".mp4") ? "Recording.mp4" : "Recording.webm")
      );

      try {
        renderer.choose_output(filename);
      } catch (error: std.Error) {
        state.capture.message = (error.message()).clone(make_heap_allocator());
        state.capture_save_source = String("");
        changed = true;
      } catch (error: std.AllocationError) {
        state.capture.message = (error.message()).clone(make_heap_allocator());
        state.capture_save_source = String("");
        changed = true;
      } catch (error: std.InvalidArgumentError) {
        state.capture.message = (error.message()).clone(make_heap_allocator());
        state.capture_save_source = String("");
        changed = true;
      } catch (error: std.OverflowError) {
        state.capture.message = (error.message()).clone(make_heap_allocator());
        state.capture_save_source = String("");
        changed = true;
      }
    }
    match renderer.take_input_path() {
      Option.Some(path) => {
        if (state.job.mode == 0) {
          open_source(state, path);
          changed = true;
        }
      },
      Option.None => {}
    };
    match renderer.take_output_path() {
      Option.Some(path) => {
        if (not state.capture_save_source.is_empty()) {
          try {
            state.capture.save_copy(state.capture_save_source, path);
          } catch (error: std.Error) {
            state.capture.message = (error.message()).clone(make_heap_allocator());
          } catch (error: std.AllocationError) {
            state.capture.message = (error.message()).clone(make_heap_allocator());
          } catch (error: std.InvalidArgumentError) {
            state.capture.message = (error.message()).clone(make_heap_allocator());
          } catch (error: std.OverflowError) {
            state.capture.message = (error.message()).clone(make_heap_allocator());
          }
          state.capture_save_source = String("");
          changed = true;
        } else if (state.job.mode == 0) {
          state.confirm_export = false;
          state.settings.output = path;
          state.settings.overwrite = false;
          changed = true;
        }
      },
      Option.None => {}
    };
    return changed;
  }

  /** Checks external tools and the selected encoder before the first conversion. */
  public function dependencies() void throws {
    var a = make_heap_allocator();
    var tools = (String("ffmpeg ffprobe")).split_whitespace(a);
    for (var tool: ref String in tools) {
      var version = std.process.Command(a, tool);
      version.add_arg("-version");
      var banner = video.capture(version);
      if (not (video.supported_tool_version(banner))) {
        throw Error(1, "Install FFmpeg and ffprobe version 8 or newer");
      }
    }
    var command = std.process.Command(a, "ffmpeg");
    command.add_arg("-hide_banner");
    command.add_arg("-encoders");
    var encoders_outcome: std.Option<String> = std.Option.None;

    try {
      var value = video.capture(command);

      encoders_outcome = std.Option.Some(value);
    } catch {
      throw Error(1, "Install FFmpeg (including ffprobe) before running this example");
    }

    var encoders = match encoders_outcome {
      std.Option.Some(value) => value,
      std.Option.None => {
        throw std.Error(1, "Exception handler produced no value");
      }
    };
    if (not encoders.contains("libx264") or not encoders.contains(" aac ")) {
      throw Error(1, "Install FFmpeg with libx264 and AAC encoders");
    }
    var scale = std.process.Command(a, "ffmpeg");
    scale.add_arg("-hide_banner");
    scale.add_arg("-h");
    scale.add_arg("filter=scale");
    var capabilities = video.capture(scale);
    if (not capabilities.contains("reset_sar")) {
      throw Error(
        1,
        "This example requires FFmpeg with scale reset_sar support (use FFmpeg 8 or newer)"
      );
    }
    return;
  }

  /** Runs a bounded nonblocking turn and redraws only when asynchronous state changes. */
  function turn(renderer: ref ui_gtk.Renderer, session: ref ui.Session<State>) void throws {
    var previous_page = session.state.page;
    renderer.poll(session.tree, session.queue, false);
    if (not renderer.running()) {
      session.state.job.process.stop();
      return;
    }
    session.dispatch(renderer);
    var percent = session.state.job.percent;
    var mode = session.state.job.mode;
    var changed = false;
    try {
      var value = session.state.capture.tick();
      changed = value;
    } catch (error: std.Error) {
      session.state.capture.cancel();
      session.state.capture.message = (error.message()).clone(make_heap_allocator());
      changed = true;
    } catch (error: std.AllocationError) {
      session.state.capture.cancel();
      session.state.capture.message = (error.message()).clone(make_heap_allocator());
      changed = true;
    } catch (error: std.InvalidArgumentError) {
      session.state.capture.cancel();
      session.state.capture.message = (error.message()).clone(make_heap_allocator());
      changed = true;
    } catch (error: std.OverflowError) {
      session.state.capture.cancel();
      session.state.capture.message = (error.message()).clone(make_heap_allocator());
      changed = true;
    } catch (error: std.IndexOutOfBoundsError) {
      session.state.capture.cancel();
      session.state.capture.message = (error.message()).clone(make_heap_allocator());
      changed = true;
    } catch (error: std.NotFoundError) {
      session.state.capture.cancel();
      session.state.capture.message = (error.message()).clone(make_heap_allocator());
      changed = true;
    } catch (error: std.EmptyError) {
      session.state.capture.cancel();
      session.state.capture.message = (error.message()).clone(make_heap_allocator());
      changed = true;
    } catch (error: std.IOError) {
      session.state.capture.cancel();
      session.state.capture.message = (error.message()).clone(make_heap_allocator());
      changed = true;
    } catch (error: std.ConversionError) {
      session.state.capture.cancel();
      session.state.capture.message = (error.message()).clone(make_heap_allocator());
      changed = true;
    } catch (error: std.DivisionByZeroError) {
      session.state.capture.cancel();
      session.state.capture.message = (error.message()).clone(make_heap_allocator());
      changed = true;
    } catch (error: std.ArithmeticError) {
      session.state.capture.cancel();
      session.state.capture.message = (error.message()).clone(make_heap_allocator());
      changed = true;
    } catch (error: std.json.JsonError) {
      session.state.capture.cancel();
      session.state.capture.message = (error.message()).clone(make_heap_allocator());
      changed = true;
    } catch (error: std.xml.XmlError) {
      session.state.capture.cancel();
      session.state.capture.message = (error.message()).clone(make_heap_allocator());
      changed = true;
    } catch (error: std.ProtoDecodeError) {
      session.state.capture.cancel();
      session.state.capture.message = (error.message()).clone(make_heap_allocator());
      changed = true;
    }
    try {
      var value = dialogs(renderer, session.state);
      changed = changed or value;
    } catch (error: std.Error) {
      if (not session.state.capture_save_source.is_empty()) {
        session.state.capture.message = (error.message()).clone(make_heap_allocator());
        session.state.capture_save_source = String("");
      } else {
        session.state.job.fail(error);
      }
      changed = true;
    } catch (error: std.AllocationError) {
      if (not session.state.capture_save_source.is_empty()) {
        session.state.capture.message = (error.message()).clone(make_heap_allocator());
        session.state.capture_save_source = String("");
      } else {
        session.state.job.fail(error);
      }
      changed = true;
    } catch (error: std.InvalidArgumentError) {
      if (not session.state.capture_save_source.is_empty()) {
        session.state.capture.message = (error.message()).clone(make_heap_allocator());
        session.state.capture_save_source = String("");
      } else {
        session.state.job.fail(error);
      }
      changed = true;
    } catch (error: std.OverflowError) {
      if (not session.state.capture_save_source.is_empty()) {
        session.state.capture.message = (error.message()).clone(make_heap_allocator());
        session.state.capture_save_source = String("");
      } else {
        session.state.job.fail(error);
      }
      changed = true;
    }
    try {
      session.state.job.tick();
    } catch (error: std.Error) {
      session.state.job.fail(error);
      changed = true;
    } catch (error: std.AllocationError) {
      session.state.job.fail(error);
      changed = true;
    } catch (error: std.InvalidArgumentError) {
      session.state.job.fail(error);
      changed = true;
    } catch (error: std.OverflowError) {
      session.state.job.fail(error);
      changed = true;
    }
    if (mode == 1 and session.state.job.mode == 0 and session.state.job.ready) {
      session.state.settings.start = String("0");
      session.state.settings.end = timestamp(duration_us(session.state));
      session.state.position = 0;
      if (session.state.settings.output.is_empty()) {
        session.state.settings.output = session.state.job.loaded.clone(make_heap_allocator());
        session.state.settings.output.append(".converted");
        session.state.settings.output.append(video.extension(session.state.settings.format));
      }
    }
    if (changed or percent != session.state.job.percent or mode != session.state.job.mode) {
      session.render(renderer);
    }
    if (previous_page != session.state.page) {
      renderer.set_default_size(
        session.state.page == 0 ? 544 : 1160,
        session.state.page == 0 ? 288 : 860
      );
    }
    return;
  }

  /** Runs the interactive application or the headless acceptance scenario. */
  public function run(
    automated: bool,
    initial: const ref String,
    helper: const ref String
  ) void throws {
    dependencies();
    var title = String("Sun Video Editor");
    var renderer = ui_gtk.Renderer(
      title,
      String("org.namo_robotics.VideoEditor")
    );
    var state = State();
    state.capture.helper = helper.clone(make_heap_allocator());
    if (not initial.is_empty()) {
      try {
        open_source(state, initial);
      } catch (error: Error) {
        report(state, error);
      }
    }
    renderer.set_default_size(state.page == 0 ? 544 : 1160, state.page == 0 ? 288 : 860);
    var session = ui.Session<State>(state, view, handle);
    session.render(renderer);
    if (automated) {
      return acceptance(renderer, session);
    }
    while (renderer.running()) {
      renderer.wait_events(
        session.tree,
        session.queue,
        session.state.job.mode == 0 and not session.state.capture.process.running and
          session.state.capture.preview.mode == 0 and
          not session.state.capture.copy_process.running ? 0 : 20
      );
      turn(renderer, session);
    }
    session.state.job.process.stop();
    session.tree.shutdown(renderer);
    return;
  }
}

/** Reports startup failures and selects the native acceptance test when requested. */
function main(argc: i32, argv: raw_ptr<raw_ptr<i8>>) i32 throws {
  var a = make_heap_allocator();
  var env = std.env.Env(a);
  var args = env.args(argc, argv);
  if (args.size() == 2 and args[1].equals_literal("--check-dependencies")) {
    sun_video_editor.dependencies();
    std.io.println("FFmpeg 8+ ready");
    return 0;
  }
  var automated = args.size() == 2 and args[1].equals_literal("--self-test");
  var initial = String("");
  if (args.size() == 2 and not automated) {
    initial = args[1].clone(a);
  }
  if (args.size() > 2) {
    std.io.eprintln("Usage: sun_video_editor [VIDEO|--self-test]");
    return 1;
  }
  sun_video_editor.run(automated, initial, screencast.helper_path(args[0]));
  return 0;
}
manifest {
  libraries: [
    "stdlib.moon",
    "${namo-robotics/sun_ui}/lib/sun_ui.moon",
    "${namo-robotics/sun_ui}/lib/sun_ui_gtk.moon"
  ]
  source_files: [
    "results.sun",
    "capture.sun",
    "process.sun",
    "media.sun",
    "job.sun",
    "state.sun",
    "view.sun",
    "$SUN_BUILD/generated/sun_video_editor.view.sun",
    "../tests/fixtures.sun",
    "../tests/acceptance.sun"
  ]
}
