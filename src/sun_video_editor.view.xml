<Views module="sun_video_editor">
  <Include source="theme.view.xml" />
  <View name="editor_view" state="State" resources="{editor_theme.resources()}" themeResource="studio">
    <Scroll expandX="true" expandY="true" backgroundResource="canvas">
      <Column margin="24" spacing="20" expandY="true">
        <Row spacing="16">
          <Button text="Home" action="100" enabled="{state.job.mode == 0}" />
          <Column spacing="4" expandX="true">
            <Label text="Sun Video Editor" styleResource="title" horizontal="Start" />
            <Label text="A lighter file. Just the part you want." styleResource="muted" horizontal="Start" />
          </Column>
          <Button text="Open video…" action="13" enabled="{state.job.mode == 0}" styleResource="primary" width="145" />
        </Row>
        <Grid spacing="24" expandX="true" expandY="true">
          <Grid.Columns><Track kind="Weight" value="3" /><Track kind="Fixed" value="300" /></Grid.Columns>
          <Grid.Rows><Track kind="Weight" value="1" /></Grid.Rows>
          <Panel key="source" column="{0}" expandX="{true}">
            <Panel.header>
              <Section text="01   SOURCE &amp; PREVIEW" expandX="{false}" />
            </Panel.header>
            <Panel.body>
              <Label text="{source_name(state)}" horizontal="Start" />
              <Label text="{metadata(state)}" styleResource="muted" horizontal="Start" />
              <Video text="{preview_source(state)}" duration="{duration_us(state)}" trimStart="{start_us(state)}" trimEnd="{end_us(state)}" position="{state.position}" changeAction="15" enabled="{state.job.mode == 0}" spacing="12" expandX="true" expandY="true" />
              <Row spacing="12">
                <Section text="02   TRIM YOUR CLIP" expandX="{true}" />
                <Button text="Reset trim" action="16" enabled="{state.job.ready and state.job.mode == 0}" />
              </Row>
              <Label text="Drag the mint handles to keep a section. Click the track to seek." styleResource="muted" horizontal="Start" />
              <Grid spacing="8" expandX="true">
                <Grid.Columns><Track kind="Weight" value="1" /><Track kind="Weight" value="1" /></Grid.Columns>
                <Grid.Rows><Track kind="Auto" /><Track kind="Auto" /></Grid.Rows>
                <Label text="Start time" horizontal="Start" styleResource="muted" />
                <Label column="1" text="End time" horizontal="Start" styleResource="muted" />
                <TextInput row="1" value="{state.settings.start.clone(a)}" changeAction="3" enabled="{state.job.ready and state.job.mode == 0}" expandX="true" />
                <TextInput row="1" column="1" value="{state.settings.end.clone(a)}" changeAction="4" enabled="{state.job.ready and state.job.mode == 0}" expandX="true" />
              </Grid>
              <Label text="{selection_summary(state)}" foregroundResource="accent" horizontal="Start" />
            </Panel.body>
          </Panel>
          <Panel key="export" column="{1}" expandX="{false}">
            <Panel.header>
              <Section text="03   EXPORT SETTINGS" expandX="{false}" />
            </Panel.header>
            <Panel.body>
              <LabeledField text="Format">
                <LabeledField.body>
                  <Select selected="{state.settings.format}" changeAction="5" enabled="{state.job.mode == 0}">
                    <Select.Options><Option key="{0}" text="MP4 · widely compatible" /><Option key="{1}" text="MOV · QuickTime" /><Option key="{2}" text="WebM · web video" /><Option key="{3}" text="MKV · flexible container" /><Option key="{4}" text="AVI · legacy devices" /><Option key="{5}" text="GIF · animated image" /></Select.Options>
                  </Select>
                </LabeledField.body>
              </LabeledField>
              <LabeledField text="Quality &amp; compression">
                <LabeledField.body>
                  <Select selected="{state.settings.quality}" changeAction="6" enabled="{state.job.mode == 0}">
                    <Select.Options><Option key="{0}" text="Best quality · largest file" /><Option key="{1}" text="High quality" /><Option key="{2}" text="Balanced · recommended" /><Option key="{3}" text="Smaller file" /><Option key="{4}" text="Smallest file · lower detail" /></Select.Options>
                  </Select>
                </LabeledField.body>
              </LabeledField>
              <LabeledField text="Maximum resolution">
                <LabeledField.body>
                  <Select selected="{state.settings.resolution}" changeAction="7" enabled="{state.job.mode == 0}">
                    <Select.Options><Option key="{0}" text="Keep original" /><Option key="{1}" text="Fit within 2160 px" /><Option key="{2}" text="Fit within 1080 px" /><Option key="{3}" text="Fit within 720 px" /><Option key="{4}" text="Fit within 480 px" /></Select.Options>
                  </Select>
                </LabeledField.body>
              </LabeledField>
              <Checkbox text="Keep audio" checked="{state.settings.audio and state.settings.format != 5}" changeAction="8" enabled="{state.job.mode == 0 and state.settings.format != 5}" />
              <LabeledField text="Save as">
                <LabeledField.body>
                  <TextInput value="{state.settings.output.clone(a)}" changeAction="2" enabled="{state.job.mode == 0}" />
                </LabeledField.body>
              </LabeledField>
              <Button text="Choose destination…" action="14" enabled="{state.job.mode == 0}" />
              <Checkbox text="Replace existing output" checked="{state.settings.overwrite}" changeAction="9" enabled="{state.job.mode == 0}" />
              <Button text="Export" action="11" enabled="{state.job.mode == 0 and state.job.ready}" height="48" styleResource="primary" />
              <Button text="Cancel export" action="12" visible="{state.job.mode != 0}" enabled="{state.job.mode != 0}" />
              <Label text="{progress_label(state)}" foregroundResource="accent" horizontal="Start" />
              <Label text="Your original stays untouched." styleResource="muted" horizontal="Start" />
            </Panel.body>
          </Panel>
        </Grid>
        <Label text="{status_text(state)}" styleResource="muted" horizontal="Start" />
      </Column>
    </Scroll>
  </View>
  <View name="home_view" state="State" resources="{editor_theme.resources()}" themeResource="studio">
    <Scroll expandX="true" expandY="true" backgroundResource="canvas">
      <Grid margin="24" spacing="16" expandX="true">
        <Grid.Columns><Track kind="Weight" value="1" /><Track kind="Weight" value="1" /></Grid.Columns>
        <Grid.Rows><Track kind="Auto" /></Grid.Rows>
        <Column spacing="12">
          <Image text="{capture_icon(state, &quot;editor&quot;)}" width="160" height="120" horizontal="Center" vertical="Center" />
          <Button text="Video Editor" action="101" width="240" height="72" expandX="true" styleResource="homeTile" />
        </Column>
        <Column spacing="12" column="1">
          <Image text="{capture_icon(state, &quot;screen&quot;)}" width="160" height="120" horizontal="Center" vertical="Center" />
          <Button text="Screencast" action="102" width="240" height="72" expandX="true" styleResource="homeTile" />
        </Column>
      </Grid>
    </Scroll>
  </View>
  <View name="capture_view" state="State" resources="{editor_theme.resources()}" themeResource="studio">
    <Scroll expandX="true" expandY="true" backgroundResource="canvas">
      <Column margin="32" spacing="20">
        <Row spacing="16"><Button text="Home" action="100" enabled="{not state.capture.process.running and not state.capture.copy_process.running}" /><Label text="Screencast" styleResource="title" /></Row>
        <Label text="Take a screenshot or record a screen, window, or selected area." horizontal="Start" />
        <Column styleResource="panel" spacing="16">
          <Label text="Capture" horizontal="Start" />
          <Row spacing="12">
            <Column spacing="12">
              <Image text="{capture_icon(state, &quot;camera&quot;)}" width="160" height="120" horizontal="Center" vertical="Center" />
              <Button key="capture-photo" text="Screenshot · PNG" action="111" width="240" height="64" enabled="{not state.capture.process.running and not state.capture.copy_process.running}" styleResource="captureMode" background="{state.capture.kind == 0 ? 0x73e2cb : 0x293d55}" foreground="{state.capture.kind == 0 ? 0x082b2a : 0xeaf2ff}" />
            </Column>
            <Column spacing="12">
              <Image text="{capture_icon(state, &quot;record&quot;)}" width="160" height="120" horizontal="Center" vertical="Center" />
              <Button key="capture-video" text="Recording · WebM" action="112" width="240" height="64" enabled="{not state.capture.process.running and not state.capture.copy_process.running}" styleResource="captureMode" background="{state.capture.kind == 1 ? 0x73e2cb : 0x293d55}" foreground="{state.capture.kind == 1 ? 0x082b2a : 0xeaf2ff}" />
            </Column>
          </Row>
          <Label text="Source" horizontal="Start" />
          <Row spacing="12">
            <Column spacing="12">
              <Image text="{capture_icon(state, &quot;screen&quot;)}" width="160" height="120" horizontal="Center" vertical="Center" />
              <Button key="capture-screen" text="Screen" action="120" width="160" height="64" enabled="{not state.capture.process.running and not state.capture.copy_process.running}" styleResource="captureSource" background="{state.capture.source == 0 ? 0x73e2cb : 0x293d55}" foreground="{state.capture.source == 0 ? 0x082b2a : 0xeaf2ff}" />
            </Column>
            <Column spacing="12">
              <Image text="{capture_icon(state, &quot;window&quot;)}" width="160" height="120" horizontal="Center" vertical="Center" />
              <Button key="capture-window" text="Window" action="121" width="160" height="64" enabled="{not state.capture.process.running and not state.capture.copy_process.running}" styleResource="captureSource" background="{state.capture.source == 1 ? 0x73e2cb : 0x293d55}" foreground="{state.capture.source == 1 ? 0x082b2a : 0xeaf2ff}" />
            </Column>
            <Column spacing="12">
              <Image text="{capture_icon(state, &quot;selection&quot;)}" width="160" height="120" horizontal="Center" vertical="Center" />
              <Button key="capture-selection" text="Selection" action="122" width="160" height="64" enabled="{not state.capture.process.running and not state.capture.copy_process.running}" styleResource="captureSource" background="{state.capture.source == 2 ? 0x73e2cb : 0x293d55}" foreground="{state.capture.source == 2 ? 0x082b2a : 0xeaf2ff}" />
            </Column>
          </Row>
          <Label text="Share a screen, then drag directly on it. Release to confirm; Esc to cancel." visible="{state.capture.source == 2}" horizontal="Start" styleResource="muted" />
          <Label text="Delay in seconds" horizontal="Start" />
          <TextInput value="{state.capture.delay.clone(a)}" changeAction="110" enabled="{not state.capture.process.running and not state.capture.copy_process.running}" />
          <Checkbox text="Include pointer" checked="{state.capture.cursor}" changeAction="113" enabled="{not state.capture.process.running and not state.capture.copy_process.running}" />
          <If test="{state.capture.kind == 1}">
            <Checkbox key="capture-camera" text="Record camera" checked="{state.capture.camera}" changeAction="126" enabled="{not state.capture.process.running and not state.capture.copy_process.running}" />
            <Checkbox key="capture-microphone" text="Record microphone" checked="{state.capture.microphone}" changeAction="127" enabled="{not state.capture.process.running and not state.capture.copy_process.running}" />
            <Label text="Uses the default camera and microphone. Allow device access when prompted." horizontal="Start" styleResource="muted" />
            <If test="{state.capture.camera}">
              <Label text="Camera position" horizontal="Start" />
              <Select key="camera-position" selected="{state.capture.corner}" changeAction="128" enabled="{not state.capture.process.running and not state.capture.copy_process.running}">
                <Select.Options><Option key="{0}" text="Lower right" /><Option key="{1}" text="Lower left" /><Option key="{2}" text="Upper right" /><Option key="{3}" text="Upper left" /></Select.Options>
              </Select>
              <Label text="Camera size" horizontal="Start" />
              <Select key="camera-size" selected="{state.capture.camera_size}" changeAction="129" enabled="{not state.capture.process.running and not state.capture.copy_process.running}">
                <Select.Options><Option key="{0}" text="Small · 20%" /><Option key="{1}" text="Medium · 30%" /><Option key="{2}" text="Large · 40%" /></Select.Options>
              </Select>
            </If>
          </If>
          <Row spacing="12">
            <Button text="Choose source and start" action="114" enabled="{not state.capture.process.running and not state.capture.copy_process.running}" styleResource="primary" />
            <Button visible="{state.capture.kind == 1}" text="Stop and save" action="115" enabled="{state.capture.recording and not state.capture.stopping}" />
            <Button text="Cancel" action="116" enabled="{state.capture.process.running and not state.capture.stopping}" />
          </Row>
          <Label text="{state.capture.message.clone(a)}" horizontal="Start" />
          <If test="{not state.capture.saved.is_empty() and state.capture.kind == 0 and not state.capture.process.running}">
            <Row spacing="12"><Label text="Screenshot preview" horizontal="Start" /><Button text="Save as…" action="124" enabled="{not state.capture.copy_process.running}" /></Row>
            <Image key="screenshot-preview" text="{state.capture.saved.clone(a)}" height="360" expandX="true" />
          </If>
          <If test="{not state.capture.saved.is_empty() and state.capture.kind == 1 and not state.capture.process.running}">
            <Row spacing="12">
              <Label text="Recording preview" horizontal="Start" />
              <Button text="Save as…" action="124" enabled="{not state.capture.copy_process.running}" />
              <Button text="Open in Video Editor" action="125" enabled="{not state.capture.copy_process.running and state.job.mode == 0}" />
            </Row>
            <If test="{state.capture.preview.ready}">
              <Video trimControls="false" key="recording-preview" text="{state.capture.saved.clone(a)}" duration="{_convert&lt;i64&gt;(state.capture.preview.media.duration * 1000000.0)}" trimStart="{state.capture.preview_start}" trimEnd="{state.capture.preview_end}" position="{state.capture.preview_position}" changeAction="123" height="360" expandX="true" spacing="12" />
            </If>
            <If test="{not state.capture.preview.ready}">
              <Label text="{state.capture.preview.message.clone(a)}" horizontal="Start" styleResource="muted" />
            </If>
          </If>
        </Column>
        <Label text="Allow screen sharing when prompted. Enable Record microphone to include audio. Captures are saved in Pictures, Movies, or Videos." styleResource="muted" horizontal="Start" />
      </Column>
    </Scroll>
  </View>
</Views>
