using std;

/** Describes local video inputs and constructs validated FFmpeg operations. */
module video {

  /** Accepts released FFmpeg and ffprobe version banners with the required major version. */
  public function supported_tool_version(banner: const ref String) AllocationResult<bool> {
    var a = make_heap_allocator();
    var fields = try banner.split_whitespace(a);
    if (fields.size() < 3) {
      return AllocationResult.Ok(false);
    }
    if (not fields[0].equals_literal("ffmpeg") and not fields[0].equals_literal("ffprobe")) {
      return AllocationResult.Ok(false);
    }
    if (not fields[1].equals_literal("version")) {
      return AllocationResult.Ok(false);
    }
    var major = try String("");
    for (var i: i64 = 0; i < fields[2].length(); i += 1) {
      var c = match fields[2].at(i) {
        AccessResult.Ok(value) => value,
        AccessResult.OutOfBounds(_) => 0
      };
      if (c == 46 or c == 45) {
        break;
      }
      if (c < 48 or c > 57) {
        return AllocationResult.Ok(false);
      }
      try major.append_char(c);
    }
    return AllocationResult.Ok(
      match major.parse_i64() {
        Option.Some(value) => value >= 8,
        Option.None => false
      }
    );
  }

  /** Stores the supported input stream and container properties. */
  public class Media {
    public var duration: f64 = 0.0;
    public var frame_rate_num: i64 = 0;
    public var frame_rate_den: i64 = 1;
    public var size: i64 = 0;
    public var width: i64 = 0;
    public var height: i64 = 0;
    public var codec: String;
    public var audio: String;
    public var hdr: bool = false;

    /** Initializes owned storage and reports allocation failure. */
    init() AllocationResult<void> {
      this.codec = try String("");
      this.audio = try String("none");
    }
  }

  /** Owns one kept section with a stable identity and editable source timestamps. */
  public class Section {
    public var id: i64;
    public var start: String;
    public var end: String;

    /** Takes ownership of the section's identity and time fields. */
    init(id: i64, start: String, end: String) {
      this.id = id;
      this.start = start;
      this.end = end;
    }
  }

  /** Holds one validated source interval in seconds. */
  public class Interval {
    public var start: f64;
    public var end: f64;

    /** Stores a positive source interval for chronological export. */
    init(start: f64, end: f64) {
      this.start = start;
      this.end = end;
    }
  }

  /** Owns editable export settings, independent of platform widgets and processes. */
  public class Settings {
    public var input: String;
    public var output: String;
    public var start: String;
    public var end: String;
    public var format: i64 = 0;
    public var quality: i64 = 2;
    public var resolution: i64 = 0;
    public var audio: bool = true;
    public var overwrite: bool = false;
    public var sections: Vec<Section>;

    /** Allocates owned section storage for this export configuration. */
    init() AllocationResult<void> {
      this.input = try String("");
      this.output = try String("");
      this.start = try String("0");
      this.end = try String("");

      var a = make_heap_allocator();
      this.sections = try Vec<Section>(a, 4);
    }
  }

  /** Returns the filename suffix for a validated format index. */
  public function extension(format: i64) static_ptr<u8> {
    if (format == 1) {
      return ".mov";
    }
    if (format == 2) {
      return ".webm";
    }
    if (format == 3) {
      return ".mkv";
    }
    if (format == 4) {
      return ".avi";
    }
    if (format == 5) {
      return ".gif";
    }
    return ".mp4";
  }

  /** Updates a known video suffix, preserving the directory and filename stem. */
  public function output_path(path: const ref String, format: i64) AllocationResult<String> {
    var a = make_heap_allocator();
    if (path.is_empty()) {
      return AllocationResult.Ok(try String(""));
    }
    var length = path.length();
    for (var i: i64 = 0; i < 6; i += 1) {
      if (path.ends_with(extension(i))) {
        length -= i == 2 ? 5 : 4;
        break;
      }
    }
    var result = match try sun_video_editor_results.substring(path, a, 0, length) {
      AccessResult.Ok(value) => value,
      AccessResult.OutOfBounds(_) => try path.clone(a)
    };
    try result.append(extension(format));
    return AllocationResult.Ok(result);
  }

  /** Describes the compatible codecs chosen automatically for the container. */
  public function encoding_label(format: i64, audio: bool) AllocationResult<String> {
    if (format == 5) {
      return AllocationResult.Ok(
        try String("Animated GIF · loops forever · no audio")
      );
    }
    if (format == 2) {
      return AllocationResult.Ok(
        try String(audio ? "VP9 video · Opus audio" : "VP9 video · no audio")
      );
    }
    if (format == 4) {
      return AllocationResult.Ok(
        try String(audio ? "MPEG-4 video · MP3 audio" : "MPEG-4 video · no audio")
      );
    }
    return AllocationResult.Ok(
      try String(audio ? "H.264 video · AAC audio" : "H.264 video · no audio")
    );
  }

  /** Reads an optional string field without retaining a reference into JSON storage. */
  function field(object: ref std.json.Json, key: static_ptr<u8>) AllocationResult<String> {
    var a = make_heap_allocator();
    match object.get(key) {
      std.json.JsonResult.Ok(value) => {
        match value.as_string() {
          std.json.JsonResult.Ok(text) => {
            return AllocationResult.Ok(try text.clone(a));
          },
          std.json.JsonResult.Error(_) => {}
        };
      },
      std.json.JsonResult.Error(_) => {}
    };
    return AllocationResult.Ok(try String(""));
  }

  /** Reads an optional integer field from ffprobe output. */
  function integer(object: ref std.json.Json, key: static_ptr<u8>) i64 {
    match object.get(key) {
      std.json.JsonResult.Ok(value) => {
        match value.as_i64() {
          std.json.JsonResult.Ok(number) => {
            return number;
          },
          std.json.JsonResult.Error(_) => {}
        };
      },
      std.json.JsonResult.Error(_) => {}
    };
    return 0;
  }

  /** Parses finite, nonnegative seconds or a colon-separated time with optional fractional seconds. */
  public function seconds(text: const ref String) SystemResult<f64> {
    var parts = try text.split(make_heap_allocator(), b':');
    if (parts.size() < 1 or parts.size() > 3 or text.is_empty()) {
      return SystemResult.Error(Error(1, "Enter seconds or HH:MM:SS"));
    }
    var total: f64 = 0.0;
    for (var i: i64 = 0; i < parts.size(); i += 1) {
      var part = try parts[i].clone(make_heap_allocator());
      if (part.is_empty()) {
        return SystemResult.Error(Error(1, "Time contains an empty field"));
      }
      for (var j: i64 = 0; j < part.length(); j += 1) {
        var ch = match part.at(j) {
          AccessResult.Ok(value) => value,
          AccessResult.OutOfBounds(_) => b' '
        };
        if ((ch < b'0' or ch > b'9') and not (ch == b'.' and i == parts.size() - 1)) {
          return SystemResult.Error(Error(1, "Time must contain nonnegative numbers"));
        }
      }
      var number = match try part.parse_f64() {
        Option.Some(value) => value,
        Option.None => -1.0
      };
      if (number < 0.0 or number != number or number > 1000000000.0 or (i > 0 and number >= 60.0)) {
        return SystemResult.Error(Error(1, "Invalid time value"));
      }
      total = total * 60.0 + number;
    }
    return SystemResult.Ok(total);
  }

  /** Reads a bounded rational frame rate, leaving unknown rates available for fallback. */
  function frame_rate(media: ref Media, text: const ref String) AllocationResult<void> {
    var parts = try text.split(make_heap_allocator(), b'/');
    if (parts.size() != 2) {
      return AllocationResult.Ok;
    }
    var numerator = match parts[0].parse_i64() {
      Option.Some(value) => value,
      Option.None => 0
    };
    var denominator = match parts[1].parse_i64() {
      Option.Some(value) => value,
      Option.None => 0
    };
    if (numerator <= 0 or numerator > 1000000000 or denominator <= 0 or denominator > 1000000000 or
      numerator > denominator * 1000000) {
      return AllocationResult.Ok;
    }
    media.frame_rate_num = numerator;
    media.frame_rate_den = denominator;
    return AllocationResult.Ok;
  }

  /** Converts bounded probe JSON into a supported video description. */
  function decode(document: ref std.json.Json) Result<Media> {
    var result = try Media();
    var format = try document.get("format");
    var duration = try field(format, "duration");
    result.duration = match try duration.parse_f64() {
      Option.Some(value) => value,
      Option.None => 0.0
    };
    var size = try field(format, "size");
    result.size = match size.parse_i64() {
      Option.Some(value) => value,
      Option.None => 0
    };
    var streams = try document.get("streams");
    for (var i: i64 = 0; i < streams.len(); i += 1) {
      var stream = try streams.at(i);
      var kind = try field(stream, "codec_type");
      if (kind.equals_literal("video") and result.width == 0) {
        result.width = integer(stream, "width");
        result.height = integer(stream, "height");
        result.codec = try field(stream, "codec_name");
        try frame_rate(result, try field(stream, "avg_frame_rate"));
        if (result.frame_rate_num == 0) {
          try frame_rate(result, try field(stream, "r_frame_rate"));
        }
        var transfer = try field(stream, "color_transfer");
        var primaries = try field(stream, "color_primaries");
        result.hdr = transfer.equals_literal("smpte2084") or
          transfer.equals_literal("arib-std-b67") or primaries.equals_literal("bt2020");
      } else if (kind.equals_literal("audio") and result.audio.equals_literal("none")) {
        result.audio = try field(stream, "codec_name");
      }
    }
    return Result.Ok(result);
  }

  /** Rejects malformed or unbounded input metadata before it reaches export logic. */
  public function parse_probe(text: const ref String) SystemResult<Media> {
    var a = make_heap_allocator();
    var document = match std.json.parse_json(a, text) {
      Result.Ok(value) => value,
      Result.Allocation(error) => {
        return SystemResult.Allocation(error);
      },
      Result.InvalidArgument(error) => {
        return SystemResult.InvalidArgument(error);
      },
      Result.Overflow(error) => {
        return SystemResult.Overflow(error);
      },
      _ => {
        return SystemResult.Error(Error(1, "ffprobe returned invalid metadata"));
      }
    };
    var media = match decode(document) {
      Result.Ok(value) => value,
      Result.Allocation(error) => {
        return SystemResult.Allocation(error);
      },
      Result.InvalidArgument(error) => {
        return SystemResult.InvalidArgument(error);
      },
      Result.Overflow(error) => {
        return SystemResult.Overflow(error);
      },
      _ => {
        return SystemResult.Error(Error(1, "Input has no readable video metadata"));
      }
    };
    if (media.width < 2 or media.height < 2 or media.duration <= 0.0 or
      media.duration != media.duration or media.duration > 1000000000.0) {
      return SystemResult.Error(Error(1, "Input must contain a video with a finite duration"));
    }
    if (media.hdr) {
      return SystemResult.Error(
        Error(1, "HDR / BT.2020 conversion is not supported yet; use an SDR source")
      );
    }
    return SystemResult.Ok(media);
  }

  /** Selects GNU coreutils by their Homebrew-prefixed names on macOS. */
  public function coreutils_command(tool: static_ptr<u8>) SystemResult<std.process.Command> {
    var a = make_heap_allocator();
    var platform = try std.process.Command(a, "uname");
    try platform.add_arg("-s");
    var name = try capture(platform);
    var executable = try String(name.equals_literal("Darwin") ? "g" : "");

    try executable.append(tool);
    return SystemResult.Ok(
      try std.process.Command(a, executable)
    );
  }

  /** Resolves local paths, including missing outputs, with GNU coreutils and literal arguments. */
  public function absolute(path: ref String) SystemResult<String> {
    if (path.is_empty() or path.contains("\0")) {
      return SystemResult.Error(Error(1, "Choose a local file path"));
    }
    var command = try coreutils_command("realpath");
    try command.add_arg("-m");
    try command.add_arg("--");
    try command.add_arg(path);
    return capture(command);
  }

  /** Builds a probe command restricted to the metadata used by this example. */
  public function probe_command(input: const ref String) AllocationResult<std.process.Command> {
    var command = try std.process.Command(make_heap_allocator(), "ffprobe");

    try command.add_arg("-v");
    try command.add_arg("error");
    try command.add_arg("-show_entries");
    try command.add_arg(
      "format=duration,size:stream=codec_type,codec_name,width,height,color_transfer,color_primaries,avg_frame_rate,r_frame_rate"
    );
    try command.add_arg("-of");
    try command.add_arg("json");
    try command.add_arg(input);
    return AllocationResult.Ok(command);
  }

  /** Validates kept sections and orders them without duplicating overlapping source material. */
  public function kept_intervals(
    settings: const ref Settings,
    media: const ref Media
  ) SystemResult<Vec<Interval>> {
    var a = make_heap_allocator();
    var result = try Vec<Interval>(a, 4);
    if (settings.sections.size() > 64) {
      return SystemResult.Error(Error(1, "A clip can contain at most 64 kept sections"));
    }
    var count = settings.sections.size() == 0 ? 1 : settings.sections.size();
    for (var i: i64 = 0; i < count; i += 1) {
      var first_text = try settings.start.clone(a);
      var text = try settings.end.clone(a);
      if (settings.sections.size() > 0) {
        first_text = try settings.sections[i].start.clone(a);
        text = try settings.sections[i].end.clone(a);
      }
      var start = try seconds(first_text);
      var end = text.is_empty() ? media.duration : try seconds(text);
      if (start >= end or end > media.duration + 0.001) {
        return SystemResult.Error(
          Error(1, "Each kept section must satisfy 0 <= start < end <= video duration")
        );
      }
      try result.push(Interval(start, end));
      for (var j = result.size() - 1; j > 0 and result[j].start < result[j - 1].start; j -= 1) {
        var first = result[j].start;
        var last = result[j].end;
        result[j].start = result[j - 1].start;
        result[j].end = result[j - 1].end;
        result[j - 1].start = first;
        result[j - 1].end = last;
      }
    }
    for (var i: i64 = 1; i < result.size(); i += 1) {
      if (result[i].start < result[i - 1].end) {
        return SystemResult.Error(Error(1, "Kept sections must not overlap"));
      }
    }
    return SystemResult.Ok(result);
  }

  /** Totals kept duration and validates presets before starting an export. */
  public function trim_length(
    settings: const ref Settings,
    media: const ref Media
  ) SystemResult<f64> {
    var intervals = try kept_intervals(settings, media);
    if (settings.format < 0 or settings.format > 5 or settings.quality < 0 or settings.quality > 4 or
      settings.resolution < 0 or settings.resolution > 4) {
      return SystemResult.Error(Error(1, "Invalid export preset"));
    }
    var duration: f64 = 0.0;
    for (var interval: ref Interval in intervals) {
      duration += interval.end - interval.start;
    }
    return SystemResult.Ok(duration);
  }

  /** Joins frame-accurate kept video and optional audio intervals with timestamps reset per section. */
  function section_filter(
    settings: const ref Settings,
    media: const ref Media
  ) SystemResult<String> {
    var intervals = try kept_intervals(settings, media);
    var audio = settings.audio and settings.format != 5 and not media.audio.equals_literal("none");
    var graph = try String("");
    var inputs = try String("");
    for (var i: i64 = 0; i < intervals.size(); i += 1) {
      var first = intervals[i].start;
      var last = intervals[i].end;
      try graph.append(
        try `[0:v:0]trim=start=${first}:end=${last},setpts=PTS-STARTPTS[v${i}];`
      );

      try inputs.append(try `[v${i}]`);

      if (audio) {
        try graph.append(
          try `[0:a:0]atrim=start=${first}:end=${last},asetpts=PTS-STARTPTS[a${i}];`
        );

        try inputs.append(try `[a${i}]`);
      }
    }
    try graph.append(
      try `${inputs}concat=n=${intervals.size()}:v=1:a=${audio ? 1 : 0}[joined]`
    );

    if (audio) {
      try graph.append("[audio]");
    }
    try graph.append(";");
    return SystemResult.Ok(graph);
  }

  /** Shares aspect-preserving resolution limits between video and animation exports. */
  function scale_filter(resolution: i64) AllocationResult<String> {
    if (resolution == 0) {
      return AllocationResult.Ok(try String("scale=w=-2:h=trunc(ih/2)*2:reset_sar=1"));
    }
    var limit = resolution == 1 ? 2160 : (resolution == 2 ? 1080 : (resolution == 3 ? 720 : 480));
    return AllocationResult.Ok(
      try `scale=w='min(iw,${limit})':h='min(ih,${limit})':force_original_aspect_ratio=decrease:force_divisible_by=2:reset_sar=1`
    );
  }

  /** Constructs a container-compatible export with frame-accurate transcoding and bounded CPU use. */
  public function export_command(
    settings: const ref Settings,
    media: const ref Media,
    temporary: const ref String
  ) SystemResult<std.process.Command> {
    var duration = try trim_length(settings, media);
    var start = try seconds(settings.start);
    var command = try std.process.Command(make_heap_allocator(), "ffmpeg");

    try command.add_arg("-hide_banner");
    try command.add_arg("-loglevel");
    try command.add_arg("error");
    try command.add_arg("-nostdin");
    try command.add_arg("-nostats");
    try command.add_arg("-n");
    try command.add_arg("-progress");
    try command.add_arg("pipe:1");
    var multiple = settings.sections.size() > 0;
    if (not multiple) {
      try command.add_arg("-ss");
      try command.add_arg(try `${start}`);
    }
    try command.add_arg("-i");
    try command.add_arg(settings.input);
    try command.add_arg("-t");
    try command.add_arg(try `${duration}`);
    if (settings.format == 5) {
      var fps = settings.quality == 0 ? 30 : (settings.quality == 1 ? 24 : (settings.quality == 2 ? 20 : (settings.quality ==
        3 ? 15 : 10)));
      var colors = settings.quality < 2 ? 256 : (settings.quality == 2 ? 128 : (settings.quality ==
        3 ? 96 : 64));
      var scale = try scale_filter(settings.resolution);
      try command.add_arg("-filter_complex_threads");
      try command.add_arg("1");
      try command.add_arg("-filter_complex");
      var graph = try String("");
      if (multiple) {
        graph = try section_filter(settings, media);
      }
      var source = try String(multiple ? "[joined]" : "[0:v:0]");
      try graph.append(
        try `${source}trim=duration=${duration},setpts=PTS-STARTPTS,fps=${fps},${scale},split[frames][colors];[colors]palettegen=max_colors=${colors}:reserve_transparent=0[palette];[frames][palette]paletteuse=dither=sierra2_4a[gif]`
      );

      try command.add_arg(graph);
      try command.add_arg("-map");
      try command.add_arg("[gif]");
      try command.add_arg("-an");
      try command.add_arg("-c:v");
      try command.add_arg("gif");
      try command.add_arg("-threads");
      try command.add_arg("2");
      try command.add_arg("-loop");
      try command.add_arg("0");
      try command.add_arg("-map_metadata");
      try command.add_arg("-1");
      try command.add_arg("-f");
      try command.add_arg("gif");
      try command.add_arg(temporary);
      return SystemResult.Ok(command);
    }
    if (multiple) {
      var graph = try section_filter(settings, media);
      try graph.append(
        try `[joined]${try scale_filter(settings.resolution)}[video]`
      );

      try command.add_arg("-filter_complex_threads");
      try command.add_arg("1");
      try command.add_arg("-filter_complex");
      try command.add_arg(graph);
    }
    try command.add_arg("-map");
    try command.add_arg(multiple ? "[video]" : "0:v:0");
    if (settings.audio and (not multiple or not media.audio.equals_literal("none"))) {
      try command.add_arg("-map");
      try command.add_arg(multiple ? "[audio]" : "0:a:0?");
    }
    try command.add_arg("-c:v");
    try command.add_arg(
      settings.format == 2 ? "libvpx-vp9" : (settings.format == 4 ? "mpeg4" : "libx264")
    );
    try command.add_arg("-threads");
    try command.add_arg("2");
    try command.add_arg("-filter_threads");
    try command.add_arg("1");
    if (settings.format == 2) {
      try command.add_arg("-deadline");
      try command.add_arg("good");
      try command.add_arg("-cpu-used");
      try command.add_arg("3");
      try command.add_arg("-b:v");
      try command.add_arg("0");
      try command.add_arg("-crf");
      try command.add_arg(try `${24 + settings.quality * 4}`);
    } else if (settings.format == 4) {
      try command.add_arg("-q:v");
      var quality = settings.quality == 0 ? 2 : (settings.quality == 1 ? 3 : (settings.quality ==
        2 ? 5 : (settings.quality == 3 ? 8 : 12)));
      try command.add_arg(try `${quality}`);
    } else {
      try command.add_arg("-preset");
      try command.add_arg("medium");
      try command.add_arg("-crf");
      var quality = settings.quality == 0 ? 18 : (settings.quality == 1 ? 21 : (settings.quality ==
        2 ? 23 : (settings.quality == 3 ? 26 : 30)));
      try command.add_arg(try `${quality}`);
    }
    try command.add_arg("-pix_fmt");
    try command.add_arg("yuv420p");
    if (not multiple) {
      try command.add_arg("-vf");
      try command.add_arg(try scale_filter(settings.resolution));
    }
    if (settings.audio) {
      try command.add_arg("-c:a");
      try command.add_arg(
        settings.format == 2 ? "libopus" : (settings.format == 4 ? "libmp3lame" : "aac")
      );
      try command.add_arg("-b:a");
      try command.add_arg("128k");
    } else {
      try command.add_arg("-an");
    }
    try command.add_arg("-map_metadata");
    try command.add_arg("-1");
    if (settings.format == 0 or settings.format == 1) {
      try command.add_arg("-movflags");
      try command.add_arg("+faststart");
    }
    try command.add_arg("-f");
    try command.add_arg(
      settings.format == 0 ? "mp4" : (settings.format == 1 ? "mov" : (settings.format == 2 ? "webm" : (settings.format ==
        3 ? "matroska" : "avi")))
    );
    try command.add_arg(temporary);
    return SystemResult.Ok(command);
  }
}
