using std;

/** Supplies presentation values for the generated XML view without constructing widgets. */
module sun_video_editor {

  /** Expresses the loaded duration in microseconds for the preview widget. */
  function duration_us(state: const ref State) i64 {
    return state.job.ready ? _convert<i64>(state.job.media.duration * 1000000.0) : 0;
  }

  /** Clamps editable time fields to a valid preview while leaving validation to the exporter. */
  function time_us(text: const ref String, fallback: i64, duration: i64) i64 {
    var value = match video.seconds(text) {
      SystemResult.Ok(value) => value,
      SystemResult.Error(_) => {
        return fallback;
      }
    };
    if (value >= _convert<f64>(duration) / 1000000.0) {
      return duration;
    }
    return _convert<i64>(value * 1000000.0);
  }

  /** Resolves an in point without letting an invalid manual edit collapse the native range. */
  function start_us(state: const ref State) i64 {
    var duration = duration_us(state);
    var start = time_us(state.settings.start, 0, duration);
    var end = time_us(state.settings.end, duration, duration);
    return start < end ? start : 0;
  }

  /** Resolves an out point, treating a blank field as the full duration. */
  function end_us(state: const ref State) i64 {
    var duration = duration_us(state);
    var end = time_us(state.settings.end, duration, duration);
    return end > start_us(state) ? end : duration;
  }

  /** Returns a source only after probing succeeded, keeping preview errors separate from export. */
  function preview_source(state: const ref State) String {
    if (state.job.ready) {
      return state.job.loaded.clone(make_heap_allocator());
    }
    return String("");
  }

  /** Formats an exact millisecond timestamp accepted by the export time parser. */
  function timestamp(value: i64) String {
    var milliseconds = value / 1000;
    var hours = milliseconds / 3600000;
    var minutes = milliseconds / 60000 % 60;
    var seconds = milliseconds / 1000 % 60;
    var fraction = milliseconds % 1000;
    var result = String("");
    if (hours < 10) {
      result.append("0");
    }
    result.append(hours);
    result.append(":");
    if (minutes < 10) {
      result.append("0");
    }
    result.append(minutes);
    result.append(":");
    if (seconds < 10) {
      result.append("0");
    }
    result.append(seconds);
    result.append(".");
    if (fraction < 100) {
      result.append("0");
    }
    if (fraction < 10) {
      result.append("0");
    }
    result.append(fraction);
    return result;
  }

  /** Shows the selected filename or a prompt to use the file chooser. */
  function source_name(state: const ref State) String {
    if (state.settings.input.is_empty()) {
      return String("Choose Open video… to get started.");
    }
    var a = make_heap_allocator();
    var parts = state.settings.input.split(a, b'/');
    return parts[parts.size() - 1].clone(a);
  }

  /** Presents compact source information after loading. */
  function metadata(state: const ref State) String {
    if (not state.job.ready) {
      return String("MOV or MP4 · local processing · no upload");
    }
    var length = timestamp(duration_us(state));
    return `${state.job.media.width} × ${state.job.media.height}   ·   ${length}   ·   ${state.job.media.size / 1024} KB`;
  }

  /** Reports exactly the selected interval's length, or flags invalid manual times. */
  function selection_summary(state: const ref State) String {
    if (not state.job.ready) {
      return String("Open a video to select the part you want to keep.");
    }
    var length = match video.trim_length(state.settings, state.job.media) {
      SystemResult.Ok(value) => value,
      SystemResult.Error(_) => {
        return String("Check the start and end times before exporting.");
      }
    };
    var time = timestamp(_convert<i64>(length * 1000000.0));
    return `Selected clip: ${time}`;
  }

  /** Shows export progress without implying completion before the file is published. */
  function progress_label(state: const ref State) String {
    if (state.job.mode == 1) {
      return String("Reading video…");
    }
    if (state.job.mode == 2) {
      return `Exporting ${state.job.percent}%`;
    }
    if (state.job.percent == 100) {
      return String("Export complete");
    }
    return video.encoding_label(state.settings.format, state.settings.audio);
  }

  /** Keeps status text readable while preserving full errors in the terminal. */
  function status_text(state: const ref State) String {
    var a = make_heap_allocator();
    var lines = state.job.message.split(a, b'\n');
    if (lines[0].length() > 110) {
      var text = match lines[0].substr(a, 0, 107) {
        AccessResult.Ok(value) => value,
        AccessResult.OutOfBounds(_) => String("")
      };
      text.append("…");
      return text;
    }
    return lines[0].clone(a);
  }
}
