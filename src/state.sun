using std;

/** Routes typed form events into the platform-independent media workflow. */
module sun_video_editor {

  /** Owns form values, asynchronous work, and requests for platform dialogs. */
  class State {
    var page: i32 = 0;
    var capture: screencast.Capture;
    var settings: video.Settings;
    var job: video.Job;
    var open_requested: bool = false;
    var save_requested: bool = false;
    var confirm_export: bool = false;
    var capture_save_requested: bool = false;
    var capture_save_source: String;
    var position: i64 = 0;
    var active_section: i64 = 0;
    var next_section: i64 = 1;

    /** Initializes owned storage and reports allocation failure. */
    init() throws {
      this.job = video.Job();

      this.settings = video.Settings();

      this.capture = screencast.Capture();

      this.capture_save_source = String("");
    }
  }

  /** Reports a handled operation failure without abandoning the active child. */
  function report(state: ref State, error: const ref Error) void throws {
    std.io.eprintln(error.message());
    state.job.fail(error);
  }

  /** Selects a source and immediately starts reading its media information. */
  function open_source(state: ref State, path: const ref String) void throws {
    state.confirm_export = false;
    state.page = 1;
    state.settings.input = path.clone(make_heap_allocator());
    state.position = 0;
    state.settings.sections.clear();
    state.active_section = 0;
    return state.job.probe(state.settings.input);
  }

  /** Persists the selected section's editable fields without borrowing UI storage. */
  function store_section(state: ref State) void throws {
    var a = make_heap_allocator();
    for (var i: i64 = 0; i < state.settings.sections.size(); i += 1) {
      if (state.settings.sections[i].id == state.active_section) {
        state.settings.sections[i].start = state.settings.start.clone(a);
        state.settings.sections[i].end = state.settings.end.clone(a);
      }
    }

    return;
  }

  /** Selects a kept section for exact field edits and moves the playhead to its start. */
  function select_section(state: ref State, id: i64) void throws {
    var a = make_heap_allocator();
    for (var i: i64 = 0; i < state.settings.sections.size(); i += 1) {
      if (state.settings.sections[i].id == id) {
        state.active_section = id;
        state.settings.start = state.settings.sections[i].start.clone(a);
        state.settings.end = state.settings.sections[i].end.clone(a);
        state.position = start_us(state);
      }
    }

    return;
  }

  /** Splits a kept section at the playhead, initially preserving both sides without a gap. */
  function split_section(state: ref State) void throws {
    if (not can_split(state)) {
      return;
    }
    var a = make_heap_allocator();
    var end = state.settings.end.clone(a);
    var boundary = timestamp(state.position);
    if (state.settings.sections.size() == 0) {
      state.active_section = state.next_section;
      state.next_section += 1;
      state.settings.sections.push(
        video.Section(
          state.active_section,
          state.settings.start.clone(a),
          end.clone(a)
        )
      );
    }
    state.settings.end = boundary.clone(a);
    store_section(state);
    var id = state.next_section;
    state.next_section += 1;
    state.settings.sections.push(video.Section(id, boundary, end));

    select_section(state, id);
    return;
  }

  /** Deletes the selected kept section while preserving at least one editable interval. */
  function remove_section(state: ref State) void throws {
    if (state.settings.sections.size() < 2) {
      return;
    }
    for (var i: i64 = 0; i < state.settings.sections.size(); i += 1) {
      if (state.settings.sections[i].id == state.active_section) {
        try {
          state.settings.sections.remove(i);
        } catch (error: std.IndexOutOfBoundsError) {}
        break;
      }
    }
    select_section(state, state.settings.sections[0].id);
    if (state.settings.sections.size() == 1) {
      state.settings.sections.clear();
      state.active_section = 0;
    }

    return;
  }

  /** Applies captured events while rejecting edits during probing or conversion. */
  function handle(
    state: ref State,
    event: const ref ui.Event,
    queue: ref ui.EventQueue
  ) void throws {
    var a = make_heap_allocator();
    if (event.action != 11 and event.action != 15) {
      state.confirm_export = false;
    }
    if (event.action >= 100) {
      if (event.action == 116) {
        state.capture.cancel();
      }
      if (event.action == 115) {
        state.capture.finish();
      }
      if (state.capture.process.running or state.capture.copy_process.running or
        state.job.mode != 0) {
        return;
      }
      if (event.action == 125 and state.capture.kind == 1 and not state.capture.saved.is_empty()) {
        var recording = state.capture.saved.clone(a);
        state.settings.output = String("");
        state.settings.overwrite = false;
        try {
          open_source(state, recording);
        } catch (error: Error) {
          report(state, error);
        }
      }
      if (event.action == 124 and not state.capture.saved.is_empty() and
        not state.capture.copy_process.running) {
        state.capture_save_requested = true;
      }
      if (event.action == 100) {
        state.page = 0;
      }
      if (event.action == 101) {
        state.page = 1;
      }
      if (event.action == 102) {
        state.page = 2;
      }
      if (event.action == 110 and event.value.kind == ui.ValueKind.Text) {
        state.capture.delay = event.value.text.clone(a);
      }
      if (event.action >= 120 and event.action <= 122) {
        state.capture.source = event.action - 120;
      }
      if ((event.action == 111 or event.action == 112) and
        state.capture.kind != event.action - 111) {
        state.capture.kind = event.action - 111;
        state.capture.saved = String("");
      }
      if (event.action == 113 and event.value.kind == ui.ValueKind.Boolean) {
        state.capture.cursor = event.value.boolean;
      }
      if (event.action == 126 and event.value.kind == ui.ValueKind.Boolean) {
        state.capture.camera = event.value.boolean;
      }
      if (event.action == 127 and event.value.kind == ui.ValueKind.Boolean) {
        state.capture.microphone = event.value.boolean;
      }
      if ((event.action == 128 or event.action == 129) and
        event.value.kind == ui.ValueKind.Selection) {
        for (var i: i64 = 0; i < (event.action == 128 ? 4 : 3); i += 1) {
          if (event.value.selection.equals(ui.Key(i))) {
            if (event.action == 128) {
              state.capture.corner = i;
            } else {
              state.capture.camera_size = i;
            }
          }
        }
      }
      if (event.action == 114) {
        try {
          state.capture.start();
        } catch (error: std.Error) {
          state.capture.message = (error.message()).clone(a);
        }
      }
      if (event.action == 123 and event.value.kind == ui.ValueKind.Range and
        state.capture.preview.ready) {
        var duration = _convert<i64>(state.capture.preview.media.duration * 1000000.0);
        if (event.value.range_start >= 0 and event.value.range_end > event.value.range_start and
          event.value.range_end <= duration and event.value.position >= 0 and
          event.value.position <= duration) {
          state.capture.preview_start = event.value.range_start;
          state.capture.preview_end = event.value.range_end;
          state.capture.preview_position = event.value.position;
        }
      }
      return;
    }
    if (event.action == 12) {
      state.job.cancel();
      return;
    }
    if (state.job.mode != 0) {
      return;
    }
    if (event.value.kind == ui.ValueKind.Range and event.action == 15 and state.job.ready) {
      var duration = duration_us(state);
      if (event.value.range_start >= 0 and event.value.range_end > event.value.range_start and
        event.value.range_end <= duration and event.value.position >= 0 and
        event.value.position <= duration) {
        var known = state.settings.sections.size() == 0 and event.value.range_id == 0;
        for (var i: i64 = 0; i < state.settings.sections.size(); i += 1) {
          known = known or state.settings.sections[i].id == event.value.range_id;
        }
        if (not known) {
          return;
        }
        if (event.value.range_start != start_us(state) or event.value.range_end != end_us(state)) {
          state.confirm_export = false;
        }
        state.active_section = event.value.range_id;
        state.settings.start = timestamp(event.value.range_start);
        state.settings.end = timestamp(event.value.range_end);
        state.position = event.value.position;
        store_section(state);
      }
    } else if (event.value.kind == ui.ValueKind.Text) {
      if (event.action == 2) {
        state.settings.output = event.value.text.clone(a);
        state.settings.overwrite = false;
      }
      if (event.action == 3 and event.payload == state.active_section) {
        state.settings.start = event.value.text.clone(a);
        store_section(state);
      }
      if (event.action == 4 and event.payload == state.active_section) {
        state.settings.end = event.value.text.clone(a);
        store_section(state);
      }
    } else if (event.value.kind == ui.ValueKind.Selection) {
      var value: i64 = -1;
      for (var i: i64 = 0; i < (event.action == 5 ? 6 : 5); i += 1) {
        var key = ui.Key(i);
        if (event.value.selection.equals(key)) {
          value = i;
        }
      }
      if (value < 0) {
        return;
      }
      if (event.action == 5) {
        state.settings.format = value;
        state.settings.output = video.output_path(state.settings.output, value);
        state.settings.overwrite = false;
      }
      if (event.action == 6) {
        state.settings.quality = value;
      }
      if (event.action == 7) {
        state.settings.resolution = value;
      }
    } else if (event.value.kind == ui.ValueKind.Boolean) {
      if (event.action == 8 and state.settings.format != 5) {
        state.settings.audio = event.value.boolean;
      }
      if (event.action == 9) {
        state.settings.overwrite = event.value.boolean;
      }
    } else {
      if (event.action == 11) {
        var overwrite = state.settings.overwrite;
        state.settings.overwrite = overwrite or state.confirm_export;
        state.confirm_export = false;
        try {
          state.job.convert(state.settings);
        } catch (error: Error) {
          report(state, error);
        }
        state.settings.overwrite = overwrite;
        if (state.job.needs_overwrite) {
          state.confirm_export = true;
          state.job.message = String(
            "Destination exists. Click Replace and export to save your edits there."
          );
        }
      }
      if (event.action == 13) {
        state.open_requested = true;
      }
      if (event.action == 17) {
        split_section(state);
      }
      if (event.action == 18) {
        select_section(state, event.payload);
      }
      if (event.action == 19) {
        remove_section(state);
      }
      if (event.action == 16) {
        state.settings.sections.clear();
        state.active_section = 0;
        state.settings.start = String("0");
        state.settings.end = String("");
        state.position = 0;
      }
      if (event.action == 14) {
        state.save_requested = true;
      }
    }
    return;
  }
}
