using std;

/** Owns one video workflow and its temporary output independently of GTK. */
module video {

  /** Tracks probing, conversion, cancellation, and atomic publication of one result. */
  public class Job {
    public var process: Process;
    public var media: Media;
    public var loaded: String;
    public var message: String;
    public var ready: bool = false;
    public var mode: i64 = 0;
    public var percent: i64 = 0;
    public var cancelled: bool = false;
    public var output_size: i64 = 0;
    public var needs_overwrite: bool = false;
    var destination: String;
    var directory: String;
    var temporary: String;
    var overwrite: bool = false;
    var duration: f64 = 0.0;
    var started: std.time.Instant = std.time.now();

    /** Stops the child before removing only the files owned by this job. */
    deinit() {
      this.process.stop();
      this.cleanup();
    }

    /** Removes a partial export and its private directory after failure or completion. */
    method cleanup() void {
      if (not this.temporary.is_empty()) {
        try {
          std.io.remove_file(this.temporary);
        } catch {}
      }
      if (not this.directory.is_empty()) {
        try {
          std.io.remove_dir(this.directory);
        } catch {}
      }
      this.temporary.clear();
      this.directory.clear();
    }

    /** Starts probing a local regular file, clearing previously accepted metadata. */
    public method probe(path: ref String) void throws {
      if (this.mode != 0) {
        throw Error(1, "Wait for the current operation");
      }
      this.ready = false;
      this.percent = 0;
      this.output_size = 0;
      this.loaded = absolute(path);
      if (not std.io.is_file(this.loaded)) {
        throw Error(1, "Input must be a local regular file");
      }
      var command = probe_command(this.loaded);
      this.process.start(command);
      this.mode = 1;
      this.cancelled = false;
      this.started = std.time.now();
      this.message = String("Reading video information...");
      return;
    }

    /** Rejects the source itself, including aliases and hard links, as a destination. */
    method check_destination() void throws {
      var same = std.process.Command(make_heap_allocator(), "test");

      same.add_arg(this.loaded);
      same.add_arg("-ef");
      same.add_arg(this.destination);
      if (this.loaded.equals(this.destination) or same.status() == 0) {
        throw Error(1, "Output must not replace the input video");
      }
      if (std.io.is_dir(this.destination)) {
        throw Error(1, "Output is a directory");
      }
      if (std.io.exists(this.destination) and not this.overwrite) {
        this.needs_overwrite = true;
        throw Error(1, "Destination exists. Check Replace existing output to confirm.");
      }
      return;
    }

    /** Validates settings and starts conversion into an exclusive directory beside the destination. */
    public method convert(settings: ref Settings) void throws {
      if (this.mode != 0 or not this.ready) {
        throw Error(1, "Load a video before converting");
      }
      this.needs_overwrite = false;
      this.percent = 0;
      var input = absolute(settings.input);
      if (not input.equals(this.loaded)) {
        throw Error(1, "Input changed. Load its information first.");
      }
      this.duration = trim_length(settings, this.media);
      this.destination = absolute(settings.output);
      if (not this.destination.ends_with(extension(settings.format))) {
        throw Error(1, "Output extension must match the selected format");
      }
      this.overwrite = settings.overwrite;
      this.check_destination();
      this.cleanup();
      var directory = std.process.Command(make_heap_allocator(), "mktemp");

      directory.add_arg("-d");
      directory.add_arg("--");
      var pattern = this.destination.clone(make_heap_allocator());

      pattern.append(".sun-video.XXXXXX");
      directory.add_arg(pattern);
      this.directory = capture(directory);
      this.temporary = this.directory.clone(make_heap_allocator());
      this.temporary.append("/output");
      settings.input = input;
      var command = export_command(settings, this.media, this.temporary);
      try {
        this.process.start(command);
      } catch (error: std.Error) {
        this.cleanup();
        throw error;
      } catch (error: std.AllocationError) {
        this.cleanup();
        throw error;
      } catch (error: std.InvalidArgumentError) {
        this.cleanup();
        throw error;
      } catch (error: std.OverflowError) {
        this.cleanup();
        throw error;
      }
      this.mode = 2;
      this.cancelled = false;
      this.percent = 0;
      this.output_size = 0;
      this.message = String("Converting...");
      return;
    }

    /** Requests cancellation while leaving the event loop free to drain and reap the child. */
    public method cancel() void throws {
      if (this.mode != 0) {
        this.cancelled = true;
        this.process.cancel();
        this.message = String("Cancelling...");
      }

      return;
    }

    /** Stops failed work and exposes a user-readable diagnostic. */
    public method fail(error: const ref IError) void throws {
      this.process.stop();
      this.mode = 0;
      this.percent = 0;
      this.cleanup();
      this.message = (error.message()).clone(make_heap_allocator());

      return;
    }

    /** Consumes complete progress lines, retaining an incomplete suffix for the next turn. */
    method progress() void throws {
      var a = make_heap_allocator();
      var lines = this.process.text.split(a, b'\n');
      for (var i: i64 = 0; i + 1 < lines.size(); i += 1) {
        var pair = lines[i].split(a, b'=');
        if (pair.size() == 2 and pair[0].equals_literal("out_time_us")) {
          match pair[1].parse_i64() {
            Option.Some(value) => {
              var fraction = _convert<f64>(value) / (this.duration * 1000000.0);
              if (fraction >= 0.0) {
                this.percent = fraction >= 0.99 ? 99 : _convert<i64>(fraction * 100.0);
              }
            },
            Option.None => {}
          };
        }
      }
      this.process.text = lines[lines.size() - 1].clone(a);

      return;
    }

    /** Polls work, updates progress, and publishes only a successful nonempty output. */
    public method tick() void throws {
      if (this.mode == 0) {
        return;
      }
      this.process.tick();
      if (this.mode == 1 and this.started.elapsed().as_secs() > 15) {
        this.process.stop();
        this.mode = 0;
        throw Error(1, "Reading video information timed out");
      }
      if (this.mode == 2) {
        this.progress();
      }
      if (this.process.running) {
        return;
      }
      var previous = this.mode;
      this.mode = 0;
      if (this.cancelled) {
        this.cleanup();
        this.message = String("Cancelled. No output was published.");
        return;
      }
      if (this.process.status != 0) {
        this.cleanup();
        var message = String("Media operation failed: ");
        message.append(this.process.diagnostics);
        throw Error(this.process.status, message);
      }
      if (previous == 1) {
        this.media = parse_probe(this.process.text);
        this.ready = true;
        this.message = String("Ready. Choose output settings and Convert.");
      } else {
        this.output_size = std.io.get_file_size(this.temporary);
        if (this.output_size <= 0) {
          throw Error(1, "FFmpeg produced an empty output");
        }
        this.check_destination();
        if (this.overwrite) {
          std.io.rename_file(this.temporary, this.destination);
        } else {
          // A hard link fails atomically if another file appeared at the destination.
          var publish = coreutils_command("ln");
          publish.add_arg("-T");
          publish.add_arg("--");
          publish.add_arg(this.temporary);
          publish.add_arg(this.destination);
          capture(publish);
        }
        this.cleanup();
        this.percent = 100;
        var saved = this.media.size - this.output_size;
        if (saved >= 0) {
          this.message = `Complete: ${this.output_size} bytes; saved ${saved} bytes.`;
        } else {
          this.message = `Complete: ${this.output_size} bytes; output is ${0 - saved} bytes larger.`;
        }
      }
      return;
    }

    /** Initializes owned storage and reports allocation failure. */
    init() throws {
      this.process = Process();
      this.media = Media();
      this.loaded = String("");
      this.message = String("Choose a video to begin.");
      this.destination = String("");
      this.directory = String("");
      this.temporary = String("");
    }
  }
}
