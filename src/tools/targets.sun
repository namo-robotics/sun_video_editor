using std;

/** Reads this project's named build products from sun-config.json. */
module build_targets {

  /** Owns the source, artifact paths, and kind of one configured build product. */
  public class Target {
    public var source: String;
    public var output: String;
    public var tests: String;
    public var library: bool;

    /** Takes ownership of the configured paths used by compilation and execution. */
    init(source: String, output: String, tests: String, library: bool) {
      this.source = source;
      this.output = output;
      this.tests = tests;
      this.library = library;
    }
  }

  /** Selects a named local entry with explicit paths and a binary or library type. */
  function select(document: ref Json, name: static_ptr<u8>) JsonResult<Target> {
    var a = make_heap_allocator();
    var entries = try document.get("entrypoints");
    for (var i: i64 = 0; i < entries.len(); i += 1) {
      var entry = try entries.at(i);
      var entry_name = try (try entry.get("name")).as_string();
      if (entry_name.equals_literal(name)) {
        var source = try (try entry.get("path")).as_string();
        var output = try (try entry.get("output_name")).as_string();
        var kind = try (try entry.get("type")).as_string();
        if (kind.equals_literal("library") == false and kind.equals_literal("binary") == false) {
          return JsonResult.Error(JsonError("Expected a binary or library entrypoint", -1));
        }
        var tests = output.clone(a);
        tests.append("_test");
        tests = match entry.get("test_binary_name") {
          JsonResult.Ok(value) => (try value.as_string()).clone(a),
          JsonResult.Error(_) => tests.clone(a)
        };
        return JsonResult.Ok(
          Target(source.clone(a), output.clone(a), tests, kind.equals_literal("library"))
        );
      }
    }
    return JsonResult.Error(JsonError("Unknown build target", -1));
  }

  /** Queries the compiler so tools share its target selection and resolved paths. */
  function query(action: static_ptr<u8>, dependency: static_ptr<u8>) SystemResult<String> {
    var a = make_heap_allocator();
    var env = std.env.Env(a);
    var executable = match env.get("SUN_EXECUTABLE") {
      Option.Some(value) => value.clone(a),
      Option.None => String("sun")
    };
    var command = std.process.Command(a, executable);
    command.add_arg(action);
    command.add_arg("--config");
    command.add_arg("sun-config.json");
    if (not String(dependency).is_empty()) {
      command.add_arg("--dependency");
      command.add_arg(dependency);
    }
    var output = try command.output();
    if (output.status() != 0) {
      eprint(output.stderr());
      return SystemResult.Error(Error(output.status(), "Cannot resolve build configuration"));
    }
    return SystemResult.Ok(output.stdout().clone(a));
  }

  /** Copies one resolved string property from the compiler's JSON response. */
  function property(document: ref Json, key: static_ptr<u8>) JsonResult<String> {
    return JsonResult.Ok((try (try document.get(key)).as_string()).clone(make_heap_allocator()));
  }

  /** Resolves a directory property and translates malformed responses into build errors. */
  function directory(
    action: static_ptr<u8>,
    key: static_ptr<u8>,
    dependency: static_ptr<u8>
  ) SystemResult<String> {
    var text = try query(action, dependency);
    var document = match parse_json(make_heap_allocator(), text) {
      JsonResult.Ok(value) => value,
      JsonResult.Error(error) => {
        return SystemResult.Error(Error(1, "Invalid compiler configuration response"));
      }
    };
    return match property(document, key) {
      JsonResult.Ok(value) => SystemResult.Ok(value),
      JsonResult.Error(error) => SystemResult.Error(
        Error(1, "Missing compiler configuration property")
      )
    };
  }

  /** Returns the selected directory for this project's intermediates. */
  public function build_directory() SystemResult<String> {
    return directory("describe", "build_root", "");
  }

  /** Returns the selected package root for a declared dependency. */
  public function dependency(name: static_ptr<u8>) SystemResult<String> {
    return directory("resolve", "root", name);
  }

  /** Loads one target, reporting malformed configuration or missing targets as build errors. */
  public function load(name: static_ptr<u8>) SystemResult<Target> {
    var a = make_heap_allocator();
    var text = try query("describe", "");
    var document = match parse_json(a, text) {
      JsonResult.Ok(value) => value,
      JsonResult.Error(error) => {
        eprintln(error.message());
        return SystemResult.Error(Error(1, "Cannot parse sun-config.json"));
      }
    };
    return match select(document, name) {
      JsonResult.Ok(value) => SystemResult.Ok(value),
      JsonResult.Error(error) => {
        eprintln(name);
        eprintln(error.message());
        return SystemResult.Error(Error(1, "Cannot load configured build target"));
      }
    };
  }
}
