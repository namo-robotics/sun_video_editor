using std;

/** Builds the editor against independently managed UI and GTK dependency bundles. */
module editor_build {

  /** Runs a noninteractive build command without exposing the controlling terminal. */
  function run(command: ref std.process.Command) void throws {
    command.set_stdin(std.process.Stdio.Null);
    var status = command.status();
    if (status != 0) {
      throw Error(status, "Build command failed");
    }
    return;
  }

  /** Reads a dependency override or copies its workspace default. */
  function setting(name: static_ptr<u8>, fallback: static_ptr<u8>) String throws {
    var a = make_heap_allocator();
    var env = std.env.Env(a);
    return match env.get(name) {
      Option.Some(value) => value.clone(a),
      Option.None => String(fallback)
    };
  }

  /** Builds a named product through the compiler's config scheduler. */
  function compile(name: static_ptr<u8>, gtk: bool) void throws {
    var command = std.process.Command(
      make_heap_allocator(),
      setting("SUN_EXECUTABLE", "sun")
    );

    command.add_arg("build");
    command.add_arg("--config");
    command.add_arg("sun-config.json");
    command.add_arg("--package");
    command.add_arg("namo-robotics/sun_video_editor");
    command.add_arg("--entrypoint");
    command.add_arg(name);
    return run(command);
  }

  /** Compiles the Sun capture helper and links its reusable Apple framework bindings. */
  function macos_capture() void throws {
    var a = make_heap_allocator();
    var target = build_targets.load("sun_video_editor_capture");
    compile("sun_video_editor_capture", false);
    var sign = std.process.Command(a, "codesign");
    sign.add_arg("--force");
    sign.add_arg("--sign");
    sign.add_arg("-");
    sign.add_arg("--identifier");
    sign.add_arg("org.namo_robotics.VideoEditor.capture");
    sign.add_arg(target.output);
    run(sign);
    var check = std.process.Command(a, target.output);
    check.add_arg("--self-test");
    return run(check);
  }

  /** Generates the XML screen and builds the app and platform-independent tests. */
  public function build() void throws {
    var a = make_heap_allocator();
    var mkdir = std.process.Command(a, "mkdir");
    mkdir.add_arg("-p");
    mkdir.add_arg("build");
    mkdir.add_arg("tmp");
    run(mkdir);
    var version = std.process.Command(a, setting("SUN_EXECUTABLE", "sun"));

    version.add_arg("--version");
    var version_output = version.output();
    if (version_output.status() != 0) {
      throw Error(1, "Cannot identify the Sun compiler");
    }
    var version_text = version_output.stdout().clone(a);
    version_text.append(version_output.stderr());
    var version_path = String("build/sun-version.txt");
    std.io.write_string(version_path, version_text);
    var platform = std.process.Command(a, "uname");
    platform.add_arg("-s");
    var platform_output = platform.output();
    if (platform_output.stdout().starts_with("Linux")) {
      compile("sun_video_editor_capture", false);
      compile("capture_tests", false);
    } else if (platform_output.stdout().starts_with("Darwin")) {
      macos_capture();
    }
    compile("editor_tests", false);
    return compile("sun_video_editor", true);
  }

  /** Runs media tests and the native acceptance scenario in an isolated desktop session. */
  public function test() void throws {
    var a = make_heap_allocator();
    var tests = build_targets.load("editor_tests");
    var check = std.process.Command(a, tests.tests);
    check.add_arg("--test-sequential");
    run(check);
    var app = build_targets.load("sun_video_editor");
    var acceptance = std.process.Command(a, "sh");
    acceptance.add_arg("-eu");
    acceptance.add_arg("-c");
    var platform = std.process.Command(a, "uname");
    platform.add_arg("-s");
    var platform_output = platform.output();
    if (platform_output.stdout().starts_with("Darwin")) {
      acceptance.add_arg(
        "export G_DEBUG=fatal-criticals GTK_A11Y=none GSK_RENDERER=cairo; gtimeout 60s \"$1\" --self-test"
      );
    } else {
      var capture_tests = std.process.Command(a, "dbus-run-session");

      capture_tests.add_arg("--");
      capture_tests.add_arg("xvfb-run");
      capture_tests.add_arg("-a");
      var capture_target = build_targets.load("capture_tests");
      capture_tests.add_arg(capture_target.tests);
      capture_tests.add_arg("--test-sequential");
      run(capture_tests);
      // The virtual desktop has no portal services; keep GTK warnings fatal without activating host portals.
      acceptance.add_arg(
        "export G_DEBUG=fatal-warnings GDK_DEBUG=no-portals GTK_A11Y=none GSK_RENDERER=cairo; timeout 40s dbus-run-session -- xvfb-run -a -s \"-screen 0 1600x1600x24\" \"$1\" --self-test"
      );
    }
    acceptance.add_arg("editor-acceptance");
    acceptance.add_arg(app.output);
    return run(acceptance);
  }

  /** Packages only after rebuilding and testing the standalone application. */
  public function package() void throws {
    build();
    test();
    compile("editor_package_tool", false);
    var target = build_targets.load("editor_package_tool");
    var command = std.process.Command(make_heap_allocator(), target.output);

    command.add_arg("deb");
    return run(command);
  }
}

/** Dispatches standalone editor build tasks from its workspace root. */
function main(argc: i32, argv: raw_ptr<raw_ptr<i8>>) i32 throws {
  var a = make_heap_allocator();
  var env = std.env.Env(a);
  var args = env.args(argc, argv);
  try {
    if (args.size() == 2 and args[1].equals_literal("build")) {
      editor_build.build();
    } else if (args.size() == 2 and args[1].equals_literal("test")) {
      editor_build.test();
    } else if (args.size() == 2 and args[1].equals_literal("package")) {
      editor_build.package();
    } else {
      std.io.eprintln("Usage: sun src/tools/build.sun -- [build|test|package]");
      return 1;
    }

    return 0;
  } catch (error: std.Error) {
    std.io.eprintln(error.message());
    return 1;
  } catch (error: std.AllocationError) {
    std.io.eprintln(error.message());
    return 1;
  } catch (error: std.InvalidArgumentError) {
    std.io.eprintln(error.message());
    return 1;
  } catch (error: std.OverflowError) {
    std.io.eprintln(error.message());
    return 1;
  }
}
manifest {
  libraries: [
    "stdlib.moon"
  ], source_files: [
    "../results.sun",
    "targets.sun"
  ]
}
