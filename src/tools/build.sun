using std;

/** Builds the editor against independently managed UI and GTK dependency bundles. */
module editor_build {

  /** Runs a noninteractive build command without exposing the controlling terminal. */
  function run(command: ref std.process.Command) SystemResult<void> {
    command.set_stdin(std.process.Stdio.Null);
    var status = try command.status();
    if (status != 0) {
      return SystemResult.Error(Error(status, "Build command failed"));
    }
    return SystemResult.Ok;
  }

  /** Reads a dependency override or copies its workspace default. */
  function setting(name: static_ptr<u8>, fallback: static_ptr<u8>) String {
    var a = make_heap_allocator();
    var env = std.env.Env(a);
    return match env.get(name) {
      Option.Some(value) => value.clone(a),
      Option.None => String(fallback)
    };
  }

  /** Rebuilds a configured product so editor freshness checks see the current sources. */
  function compile(name: static_ptr<u8>, gtk: bool) SystemResult<void> {
    var a = make_heap_allocator();
    var target = try build_targets.load(name);
    var command = std.process.Command(a, setting("SUN_EXECUTABLE", "sun"));
    command.add_arg("--dynamic");
    command.add_arg("--force-rebuild");
    command.add_arg("-c");
    command.add_arg("-o");
    command.add_arg(target.output);
    command.add_arg("--lib-path");
    command.add_arg(setting("SUN_UI_BUILD", "build/dependencies/sun_ui/build"));
    var dependency = setting("SUN_GOBJECT_BUILD", "build/dependencies/sun_gobject/build");
    command.add_arg("--lib-path");
    command.add_arg(dependency);
    if (gtk) {
      command.add_arg(`-L${dependency}/native`);
      command.add_arg("-lsun_gobject_native");
      var pkg = std.process.Command(a, "pkg-config");
      pkg.add_arg("--libs");
      pkg.add_arg("gtk4");
      var platform = std.process.Command(a, "uname");
      platform.add_arg("-s");
      var platform_output = try platform.output();
      var darwin = platform_output.stdout().starts_with("Darwin");
      if (darwin) {
        pkg.add_arg("librsvg-2.0");
      }
      var output = try pkg.output();
      if (output.status() != 0) {
        eprint(output.stderr());
        return SystemResult.Error(Error(1, "Cannot build the editor: pkg-config could not resolve GTK development libraries. Run ./scripts/install-dependencies.sh, then retry ./build.sh. No executable or package was produced by this attempt."));
      }
      var flags = output.stdout().split_whitespace(a);
      for (var flag: ref String in flags) {
        command.add_arg(flag);
      }
      if (not darwin) {
        command.add_arg("-l:librsvg-2.so.2");
      }
    }
    command.add_arg(target.source);
    return run(command);
  }

  /** Generates the XML screen and builds the app and platform-independent tests. */
  public function build() SystemResult<void> {
    var a = make_heap_allocator();
    var mkdir = std.process.Command(a, "mkdir");
    mkdir.add_arg("-p");
    mkdir.add_arg("build");
    mkdir.add_arg("tmp");
    try run(mkdir);
    var ui = setting("SUN_UI_BUILD", "build/dependencies/sun_ui/build");
    var generator = `${ui}/sun-viewc`;
    if (not std.io.is_file(generator)) {
      return SystemResult.Error(Error(1, "Run scripts/install-dependencies.sh to download the published dependencies"));
    }
    var version = std.process.Command(a, setting("SUN_EXECUTABLE", "sun"));
    version.add_arg("--version");
    var version_output = try version.output();
    if (version_output.status() != 0) {
      return SystemResult.Error(Error(1, "Cannot identify the Sun compiler"));
    }
    var version_text = version_output.stdout().clone(a);
    version_text.append(version_output.stderr());
    var version_path = String("build/sun-version.txt");
    try std.io.write_string(version_path, version_text);
    var generate = std.process.Command(a, generator);
    generate.add_arg("src/sun_video_editor.view.xml");
    generate.add_arg("build/generated/sun_video_editor.view.sun");
    try run(generate);
    try compile("tests", false);
    return compile("sun_video_editor", true);
  }

  /** Runs media tests and the native acceptance scenario in an isolated desktop session. */
  public function test() SystemResult<void> {
    var a = make_heap_allocator();
    var tests = try build_targets.load("tests");
    var check = std.process.Command(a, tests.tests);
    check.add_arg("--test-sequential");
    try run(check);
    var app = try build_targets.load("sun_video_editor");
    var acceptance = std.process.Command(a, "sh");
    acceptance.add_arg("-eu");
    acceptance.add_arg("-c");
    var platform = std.process.Command(a, "uname");
    platform.add_arg("-s");
    var platform_output = try platform.output();
    if (platform_output.stdout().starts_with("Darwin")) {
      acceptance.add_arg("export G_DEBUG=fatal-criticals GTK_A11Y=none GSK_RENDERER=cairo; gtimeout 60s \"$1\" --self-test");
    } else {
      acceptance.add_arg("export G_DEBUG=fatal-warnings GTK_A11Y=none GSK_RENDERER=cairo; timeout 40s dbus-run-session -- xvfb-run -a -s \"-screen 0 1600x1600x24\" \"$1\" --self-test");
    }
    acceptance.add_arg("editor-acceptance");
    acceptance.add_arg(app.output);
    return run(acceptance);
  }

  /** Packages only after rebuilding and testing the standalone application. */
  public function package() SystemResult<void> {
    try build();
    try test();
    try compile("package-tool", false);
    var target = try build_targets.load("package-tool");
    var command = std.process.Command(make_heap_allocator(), target.output);
    command.add_arg("deb");
    return run(command);
  }
}

/** Dispatches standalone editor build tasks from its workspace root. */
function main(argc: i32, argv: raw_ptr<raw_ptr<i8>>) i32 {
  var a = make_heap_allocator();
  var env = std.env.Env(a);
  var args = env.args(argc, argv);
  var result: SystemResult<void> = SystemResult.Ok;
  if (args.size() == 2 and args[1].equals_literal("build")) {
    result = editor_build.build();
  } else if (args.size() == 2 and args[1].equals_literal("test")) {
    result = editor_build.test();
  } else if (args.size() == 2 and args[1].equals_literal("package")) {
    result = editor_build.package();
  } else {
    eprintln("Usage: sun src/tools/build.sun -- [build|test|package]");
    return 1;
  }
  return match result {
    SystemResult.Ok => 0,
    SystemResult.Error(error) => {
      eprintln(error.message());
      return 1;
    }
  };
}
manifest { libraries: ["stdlib.moon"], source_files: ["targets.sun"] }
