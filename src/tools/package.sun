using std;

/** Builds distribution payloads from the configured, already-tested video executable. */
module editor_package {

  /** Runs a packaging utility and reports its output on failure. */
  function capture(command: ref std.process.Command) String throws {
    var output = command.output();
    if (output.status() != 0) {
      std.io.eprint(output.stderr());
      throw Error(output.status(), "Packaging command failed");
    }
    return output.stdout().clone(make_heap_allocator());
  }

  /** Installs one file and creates its parent directories with an explicit mode. */
  function install_file(source: String, destination: String, executable: bool) void throws {
    var command = std.process.Command(make_heap_allocator(), "install");

    command.add_arg("-D");
    command.add_arg("-m");
    command.add_arg(executable ? "755" : "644");
    command.add_arg(source);
    command.add_arg(destination);
    var output = capture(command);
    return;
  }

  /** Reads one Debian changelog field without duplicating package metadata. */
  function field(name: static_ptr<u8>) String throws {
    var command = std.process.Command(make_heap_allocator(), "dpkg-parsechangelog");

    command.add_arg("-S");
    command.add_arg(name);
    var result = capture(command);
    result.trim();
    return result;
  }

  /** Stages executable, desktop integration, and notices in a bounded build directory. */
  public function stage(destination: String) void throws {
    if (not destination.equals_literal("build/editor-package/root") and
      not destination.equals_literal("debian/sun-video-editor")) {
      throw Error(
        1,
        "Stage destination must be build/editor-package/root or debian/sun-video-editor"
      );
    }
    var a = make_heap_allocator();
    var target = build_targets.load("sun_video_editor");
    var helper = build_targets.load("sun_video_editor_capture");
    var helper_exists = std.io.is_file(helper.output);
    if (not std.io.is_file(target.output) or not helper_exists) {
      throw Error(1, "Build and test the video target before packaging");
    }
    var clear = std.process.Command(a, "rm");
    clear.add_arg("-rf");
    clear.add_arg("--");
    clear.add_arg(destination);
    var cleared = capture(clear);
    install_file(
      target.output.clone(a),
      `${destination}/usr/bin/sun_video_editor`,
      true
    );
    var icon_names = (String("editor screen window selection camera record cut delete")).split_whitespace(
      a
    );
    for (var icon: ref String in icon_names) {
      install_file(
        `packaging/icons/${icon}.svg`,
        `${destination}/usr/bin/sun_video_editor_capture.icons/${icon}.svg`,
        false
      );
    }
    install_file(
      helper.output.clone(a),
      `${destination}/usr/bin/sun_video_editor_capture`,
      true
    );
    install_file(
      String("packaging/sun-video-editor.desktop"),
      `${destination}/usr/share/applications/sun-video-editor.desktop`,
      false
    );
    install_file(
      String("packaging/sun-video-editor.png"),
      `${destination}/usr/share/pixmaps/sun-video-editor.png`,
      false
    );
    install_file(
      String("debian/copyright"),
      `${destination}/usr/share/doc/sun-video-editor/copyright`,
      false
    );
    var env = std.env.Env(a);
    var gtk_source = match env.get("SUN_GOBJECT_SOURCE") {
      Option.Some(value) => value.clone(a),
      Option.None => String("build/dependencies/sun_gobject")
    };
    var ui_source = match env.get("SUN_UI_SOURCE") {
      Option.Some(value) => value.clone(a),
      Option.None => String("build/dependencies/sun_ui")
    };
    install_file(
      `${ui_source}/LICENSE`,
      `${destination}/usr/share/doc/sun-video-editor/copyright.sun_ui`,
      false
    );
    install_file(
      `${gtk_source}/LICENSE`,
      `${destination}/usr/share/doc/sun-video-editor/copyright.sun_gobject`,
      false
    );
    install_file(
      String("/usr/share/doc/sun/copyright"),
      `${destination}/usr/share/doc/sun-video-editor/copyright.sun`,
      false
    );
    install_file(
      String("build/sun-version.txt"),
      `${destination}/usr/share/doc/sun-video-editor/sun-version.txt`,
      false
    );
    return;
  }

  /** Generates exact linked-library dependencies and builds a root-owned Debian archive. */
  public function deb() void throws {
    var a = make_heap_allocator();
    var architecture = std.process.Command(a, "dpkg");
    architecture.add_arg("--print-architecture");
    var arch = capture(architecture);
    arch.trim();
    if (not arch.equals_literal("amd64")) {
      throw Error(1, "The initial release supports amd64 only");
    }
    var version = field("Version");
    var name = field("Source");
    var package = `build/${name}_${version}_${arch}.deb`;
    stage(String("build/editor-package/root"));
    var target = build_targets.load("sun_video_editor");
    var dependencies = std.process.Command(a, "dpkg-shlibdeps");

    dependencies.add_arg("-O");
    dependencies.add_arg("-e");
    dependencies.add_arg(target.output);
    dependencies.add_arg("-e");
    var helper = build_targets.load("sun_video_editor_capture");
    dependencies.add_arg(helper.output);
    var variables = capture(dependencies);
    variables.append("misc:Depends=\n");
    var variables_path = String("build/editor-package/substvars");

    std.io.write_string(variables_path, variables);
    var mkdir = std.process.Command(a, "mkdir");
    mkdir.add_arg("-p");
    mkdir.add_arg("build/editor-package/root/DEBIAN");
    var created = capture(mkdir);
    var control = std.process.Command(a, "dpkg-gencontrol");
    control.add_arg("-psun-video-editor");
    control.add_arg("-Pbuild/editor-package/root");
    control.add_arg("-Tbuild/editor-package/substvars");
    control.add_arg("-fbuild/editor-package/files");
    control.add_arg("-Obuild/editor-package/root/DEBIAN/control");
    var generated = capture(control);
    var archive = std.process.Command(a, "dpkg-deb");
    archive.add_arg("--root-owner-group");
    archive.add_arg("--build");
    archive.add_arg("build/editor-package/root");
    archive.add_arg(package);
    var output = capture(archive);
    std.io.print(output);
    return;
  }
}

/** Selects an install payload or Debian archive from the workspace root. */
function main(argc: i32, argv: raw_ptr<raw_ptr<i8>>) i32 throws {
  var a = make_heap_allocator();
  var environment = std.env.Env(a);
  var args = environment.args(argc, argv);
  try {
    if (args.size() == 2 and args[1].equals_literal("deb")) {
      editor_package.deb();
    } else if (args.size() == 3 and args[1].equals_literal("stage")) {
      editor_package.stage(args[2].clone(a));
    } else {
      std.io.eprintln("Usage: sun src/tools/package.sun -- deb | stage DESTINATION");
      return 1;
    }

    return 0;
  } catch (error: std.Error) {
    std.io.eprintln(error.message());
    return 1;
  } catch (error: std.AllocationError) {
    std.io.eprintln(error.message());
    return 1;
  } catch (error: std.InvalidArgumentError) {
    std.io.eprintln(error.message());
    return 1;
  } catch (error: std.OverflowError) {
    std.io.eprintln(error.message());
    return 1;
  }
}
manifest {
  libraries: [
    "stdlib.moon"
  ], source_files: [
    "../results.sun",
    "targets.sun"
  ]
}
