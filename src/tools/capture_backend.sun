using std;

/** Coordinates permission, live selection, timing, encoding, and publication in Sun. */
module capture_backend {

  /** Validates the bounded private helper countdown argument. */
  public function delay_seconds(text: ref String) i64 throws {
    if (text.is_empty() or text.length() > 4) {
      throw Error(1, "Invalid capture delay");
    }
    var value: i64 = 0;
    for (var i: i64 = 0; i < text.length(); i += 1) {
      var digit: u8 = 0;

      try {
        var value = text.at(i);

        digit = value;
      } catch (error: std.IndexOutOfBoundsError) {
        digit = b' ';
      }

      if (digit < b'0' or digit > b'9') {
        throw Error(1, "Invalid capture delay");
      }
      value = value * 10 + _convert<i64>(digit - b'0');
    }
    if (value > 3600) {
      throw Error(1, "Capture delay exceeds one hour");
    }
    return value;
  }

  /** Owns one capture; member order ensures pipelines stop before output and session cleanup. */
  public class Capture {
    public var presenter: presenter.Options = presenter.Options();
    var portal: desktop.Portal = desktop.Portal();
    var output: desktop.Output = desktop.Output();
    var pipeline: desktop.Pipeline = desktop.Pipeline();
    var selector: desktop.Selection = desktop.Selection();
    public var video: bool;
    var area: bool;
    var window: bool;
    var cursor: bool;
    var delay: i64;
    var stage: i32 = 0;
    var clock: std.time.Instant = std.time.now();
    var previous_seconds: i64 = -1;
    public var recording: bool = false;
    public var finishing: bool = false;
    public var completed: bool = false;
    public var cancelled: bool = false;
    public var destination: String;
    public var logical_width: i32 = 0;
    public var logical_height: i32 = 0;
    public var x: i32 = 0;
    public var y: i32 = 0;
    public var width: i32 = 0;
    public var height: i32 = 0;
    var synthetic: bool = false;

    /** Stores settings without requesting permission or creating a file. */
    init(video: bool, area: bool, window: bool, cursor: bool, delay: i64) throws {
      this.destination = String("");

      this.video = video;
      this.area = area;
      this.window = window;
      this.cursor = cursor;
      this.delay = delay;
    }

    /** Stops streaming before other resource owners are destroyed. */
    deinit() {
      this.pipeline.close();
      if (this.video and not this.completed and not this.cancelled) {
        try {
          this.report_recovery();
        } catch {}
      }
      this.selector.close();
    }

    /** Preserves unfinished output and reports its location when allocation succeeds. */
    method report_recovery() void throws {
      var recovery = this.output.preserve();
      if (not recovery.is_empty()) {
        std.io.println(`Recovery: ${recovery}`);
      }
      return;
    }

    /** Begins the first asynchronous permission step. */
    public method begin() void throws {
      return this.portal.request(0, this.window, this.cursor);
    }

    /** Starts timing after permission and all selection have completed. */
    public method countdown() void {
      this.stage = 4;
      this.clock = std.time.now();
    }

    /** Reports whether the complete post-selection delay has elapsed. */
    public method countdown_ready() bool {
      return this.clock.elapsed().as_millis() >= this.delay * 1000;
    }

    /** Builds a bounded live compositor and fragmented MP4 writer, or a lossless screenshot pipeline. */
    public method description(source: ref String) String throws {
      var crop = this.width > 0 ? "videoconvert ! video/x-raw,format=RGB ! videocrop name=region ! " : "";
      var visible = this.window ? "videocrop name=window_crop ! " : "";
      var screen = `${source} ! queue name=capture_queue max-size-buffers=4 max-size-bytes=0 max-size-time=0 ! ${String(visible)}${String(crop)}videoconvert`;

      if (not this.video) {
        return `${screen} ! pngenc snapshot=true ! fdsink name=output`;
      }
      var threads = desktop.encoder_threads();
      var result = `${screen} ! identity name=screen_geometry ! presenter.sink_0 compositor name=presenter background=black sink_0::zorder=0 ! capsfilter name=canvas ! videoconvert ! video/x-raw,format=I420,colorimetry=bt709 ! videorate drop-only=true max-rate=30 ! x264enc name=encoder tune=zerolatency speed-preset=veryfast pass=qual quantizer=20 key-int-max=30 threads=${threads} ! video/x-h264,stream-format=avc,alignment=au ! queue max-size-buffers=4 max-size-bytes=0 max-size-time=0 ! mux.video_0 mp4mux name=mux fragment-duration=1000 streamable=true ! fdsink name=output`;

      if (this.presenter.camera) {
        var camera = this.synthetic ? "videotestsrc is-live=true pattern=red ! video/x-raw,width=160,height=120,framerate=30/1" : "v4l2src device=/dev/video0 do-timestamp=true";
        result.append(
          ` ${String(camera)} ! queue name=camera_queue max-size-buffers=2 max-size-bytes=0 max-size-time=0 leaky=downstream ! videoconvert ! identity name=camera_geometry ! presenter.sink_1`
        );
      }
      if (this.presenter.microphone) {
        var audio = this.synthetic ? "audiotestsrc is-live=true wave=sine" : "pulsesrc do-timestamp=true";
        result.append(
          ` ${String(audio)} ! queue name=microphone_queue max-size-buffers=32 max-size-bytes=0 max-size-time=1000000000 ! audioconvert ! audioresample ! audio/x-raw,rate=48000,channels=1 ! avenc_aac bitrate=128000 ! queue max-size-buffers=32 max-size-bytes=0 max-size-time=1000000000 ! mux.audio_0`
        );
      }
      return result;
    }

    /** Starts a stream after timing; tests can supply a synthetic source and private output directory. */
    public method start(source: ref String, directory: ref String, synthetic: bool) void throws {
      if (this.area and this.width <= 0) {
        throw Error(1, "Select an area before starting capture");
      }
      this.synthetic = synthetic;
      var remote: i32 = -1;
      var target = String("");
      var node = String("");
      if (not synthetic) {
        remote = this.portal.remote();
        target = this.portal.target(true);
        node = this.portal.target(false);
      }
      this.output.reserve(directory);
      var stamp = desktop.filename_stamp();
      var name = this.video ? "Screencast" : "Screenshot";
      var extension = this.video ? ".mp4" : ".png";
      this.destination = `${directory}/${name} ${stamp}${extension}`;
      var description = this.description(source);
      this.pipeline.configure(description, this.output, remote, target, node);
      if (this.window) {
        this.pipeline.crop_window();
      }
      if (this.width > 0) {
        this.pipeline.crop(
          this.x,
          this.y,
          this.width,
          this.height,
          this.logical_width,
          this.logical_height
        );
      }
      if (this.video) {
        this.pipeline.presenter(
          _convert<i32>(this.presenter.corner),
          _convert<i32>(this.presenter.size)
        );
      }
      this.pipeline.play();
      this.stage = 5;
      this.clock = std.time.now();
      return;
    }

    /** Finalizes an active recording; interruption before recording cancels instead. */
    public method stop() void throws {
      if (this.finishing) {
        return;
      }
      if (not this.video or not this.recording) {
        this.cancel();
        return;
      }
      this.finishing = true;
      this.clock = std.time.now();
      this.pipeline.finish();
      return;
    }

    /** Discards incomplete output through the owned resources' cleanup paths. */
    public method cancel() void throws {
      if (this.finishing) {
        this.pipeline.close();
        var recovery = this.output.preserve();
        this.cancelled = true;
        this.selector.close();
        std.io.println("Saving interrupted; retaining the recording for recovery.");
        if (not recovery.is_empty()) {
          std.io.println(`Recovery: ${recovery}`);
        }
        return;
      }
      this.cancelled = true;
      this.pipeline.close();
      this.selector.close();
      std.io.println("Capture cancelled.");

      return;
    }

    /** Handles portal revocation and source failure consistently in either delivery order. */
    public method sharing_ended() void throws {
      if (this.video and this.recording) {
        return this.stop();
      }
      throw Error(1, "Desktop sharing ended before capture completed");
    }

    /** Handles a polled pipeline event, including source failure during desktop revocation. */
    public method pipeline_event(event: i32) void throws {
      if (event == 1) {
        this.recording = true;
        std.io.println(this.video ? "Recording…" : "Taking screenshot…");
      } else if (event == 2) {
        this.pipeline.close();
        this.output.publish(this.destination);
        this.completed = true;
        std.io.println(`Saved: ${this.destination}`);
      } else if (event == 3) {
        if (this.video and this.recording) {
          this.stop();
        } else {
          throw this.pipeline.error();
        }
      }
      return;
    }

    /** Advances the Sun state machine without blocking on frames or selection input. */
    public method tick() void throws {
      if (this.completed or this.cancelled) {
        return;
      }
      if (not this.synthetic) {
        var response = this.portal.poll();
        if (response == 2) {
          this.cancel();
          return;
        }
        if (response == 3) {
          this.sharing_ended();
        }
        if (response == 1 and this.stage < 3) {
          this.stage += 1;
          if (this.stage < 3) {
            this.portal.request(this.stage, this.window, this.cursor);
          } else if (this.area) {
            var px = this.portal.geometry(0);
            var py = this.portal.geometry(1);
            this.logical_width = this.portal.geometry(2);
            this.logical_height = this.portal.geometry(3);
            std.io.println("Drag a rectangle on the screen. Release to confirm; Esc to cancel.");
            this.selector.open(px, py, this.logical_width, this.logical_height);
          } else {
            this.countdown();
          }
        }
      }
      if (this.stage == 3) {
        var selected = this.selector.poll();
        if (selected == 2) {
          this.cancel();
          return;
        }
        if (selected == 1) {
          this.x = this.selector.x;
          this.y = this.selector.y;
          this.width = this.selector.width;
          this.height = this.selector.height;
          this.countdown();
        }
      }
      if (this.stage == 4) {
        var remaining = this.delay * 1000 - this.clock.elapsed().as_millis();
        var seconds = remaining <= 0 ? 0 : (remaining + 999) / 1000;
        if (seconds != this.previous_seconds) {
          std.io.println(
            `Capture starts in ${seconds} seconds…`
          );
          this.previous_seconds = seconds;
        }
        if (this.countdown_ready()) {
          var root = desktop.media_directory(this.video);
          var subdirectory = this.video ? "Screencasts" : "Screenshots";
          var directory = `${root}/${subdirectory}`;
          var source = String(
            "pipewiresrc name=source do-timestamp=true keepalive-time=100 resend-last=true"
          );

          this.start(source, directory, false);
        }
      }
      if (this.stage == 5) {
        var event = this.pipeline.poll();
        this.pipeline_event(event);
        if (not this.completed and this.finishing and this.clock.elapsed().as_secs() >= 120) {
          throw Error(1, "The recording could not finish saving");
        }
        if (not this.completed and not this.finishing and (not this.video or not this.recording) and
          this.clock.elapsed().as_secs() >= 15) {
          throw Error(1, "The desktop did not produce a capture frame");
        }
      }
      return;
    }
  }
}
