using std;

/** Captures optional presenter media and combines it with a private desktop recording. */
module presenter {

  /** Holds recording-only choices shared by the platform helpers. */
  public class Options {
    public var camera: bool = false;
    public var microphone: bool = false;
    public var corner: i64 = 0;
    public var size: i64 = 1;

    /** Defaults to a medium camera inset in the lower-right corner. */
    init() {}

    /** Reports whether a presenter capture is needed. */
    public method enabled() bool {
      return this.camera or this.microphone;
    }
  }

  /** Accepts the legacy protocol or validates all recording-only choices before opening devices. */
  public function options(args: ref Vec<String>) SystemResult<Options> {
    var result = Options();
    if (args.size() == 5) {
      return SystemResult.Ok(result);
    }
    if (args.size() != 9 or
      (not args[5].equals_literal("camera") and not args[5].equals_literal("no-camera")) or
      (not args[6].equals_literal("microphone") and not args[6].equals_literal("no-microphone"))) {
      return SystemResult.Error(Error(1, "Invalid presenter settings"));
    }
    result.camera = args[5].equals_literal("camera");
    result.microphone = args[6].equals_literal("microphone");
    result.corner = match args[7].parse_i64() {
      Option.Some(value) => value,
      Option.None => -1
    };
    result.size = match args[8].parse_i64() {
      Option.Some(value) => value,
      Option.None => -1
    };
    if (result.corner < 0 or result.corner > 3 or result.size < 0 or result.size > 2 or
      (result.enabled() and not args[1].equals_literal("record"))) {
      return SystemResult.Error(Error(1, "Invalid presenter settings"));
    }
    return SystemResult.Ok(result);
  }

  /** Builds an inset constrained to the chosen fraction of both desktop dimensions. */
  public function overlay(settings: ref Options) String {
    var fraction = settings.size == 0 ? "0.20" : (settings.size == 1 ? "0.30" : "0.40");
    var x = settings.corner == 0 or settings.corner == 2 ? "W-w" : "0";
    var y = settings.corner < 2 ? "H-h" : "0";
    return `[0:v]split[screen][reference];[1:v]setpts=PTS-STARTPTS[camera];[camera][reference]scale=w=rw*${String(fraction)}:h=rh*${String(fraction)}:force_original_aspect_ratio=decrease:force_divisible_by=2:reset_sar=1[inset];[screen][inset]overlay=x=${String(x)}:y=${String(y)}:eof_action=repeat:format=auto[v]`;
  }

  /** Adds conservative WebM encoding settings without consuming all available CPU cores. */
  public function video_encoding(command: ref std.process.Command) void {
    command.add_arg("-c:v");
    command.add_arg("libvpx-vp9");
    command.add_arg("-deadline");
    command.add_arg("realtime");
    command.add_arg("-cpu-used");
    command.add_arg("6");
    command.add_arg("-crf");
    command.add_arg("24");
    command.add_arg("-b:v");
    command.add_arg("0");
    command.add_arg("-threads");
    command.add_arg("1");
    command.add_arg("-pix_fmt");
    command.add_arg("yuv420p");
  }

  /** Owns device capture, composition, and private files; destruction cancels and removes them. */
  public class Recording {
    public var settings: Options = Options();
    public var directory: String = String("");
    public var screen: String = String("");
    public var result: String = String("");
    var media: String = String("");
    var recorder: video.Process = video.Process();
    var encoder: video.Process = video.Process();
    var clock: std.time.Instant = std.time.now();
    var media_time: i64 = -1;
    var offset: f64 = 0.0;
    var stopping: bool = false;
    var composing: bool = false;
    public var completed: bool = false;

    /** Creates an inactive owner without opening recording devices. */
    init() {}

    /** Stops processes before removing their unpublished files. */
    deinit() {
      this.close();
    }

    /** Releases devices and files before a parent removes its containing directory. */
    public method close() void {
      this.recorder.stop();
      this.encoder.stop();
      if (not this.directory.is_empty()) {
        ignore_error(std.io.remove_file(this.media));
        ignore_error(std.io.remove_file(this.screen));
        ignore_error(std.io.remove_file(this.result));
        ignore_error(std.io.remove_dir(this.directory));
        this.directory = String("");
      }
    }

    /** Starts devices once, after selection and countdown, using a private directory beside output. */
    public method prepare(root: ref String, macos: bool, synthetic: bool) SystemResult<void> {
      if (not this.settings.enabled() or not this.directory.is_empty()) {
        return SystemResult.Ok;
      }
      var a = make_heap_allocator();
      var mkdir = std.process.Command(a, "mkdir");
      mkdir.add_arg("-p");
      mkdir.add_arg(root);
      try video.capture(mkdir);
      var reserve = std.process.Command(a, "mktemp");
      reserve.add_arg("-d");
      reserve.add_arg(`${root}/.sun-presenter-XXXXXX`);
      this.directory = try video.capture(reserve);
      this.media = `${this.directory}/presenter.mkv`;
      this.screen = `${this.directory}/screen.webm`;
      this.result = `${this.directory}/result.webm`;
      var command = std.process.Command(a, "ffmpeg");
      command.add_arg("-nostdin");
      command.add_arg("-hide_banner");
      command.add_arg("-loglevel");
      command.add_arg("error");
      command.add_arg("-n");
      command.add_arg("-stats_period");
      command.add_arg("0.05");
      command.add_arg("-progress");
      command.add_arg("pipe:1");
      if (synthetic) {
        if (this.settings.camera) {
          command.add_arg("-re");
          command.add_arg("-f");
          command.add_arg("lavfi");
          command.add_arg("-i");
          command.add_arg("color=c=red:s=160x120:r=30");
        }
        if (this.settings.microphone) {
          command.add_arg("-re");
          command.add_arg("-f");
          command.add_arg("lavfi");
          command.add_arg("-i");
          command.add_arg("sine=frequency=440:sample_rate=48000");
        }
      } else if (macos) {
        command.add_arg("-f");
        command.add_arg("avfoundation");
        if (this.settings.camera) {
          command.add_arg("-framerate");
          command.add_arg("30");
        }
        command.add_arg("-i");
        var camera = this.settings.camera ? "default" : "none";
        var microphone = this.settings.microphone ? "default" : "none";
        command.add_arg(`${String(camera)}:${String(microphone)}`);
      } else {
        if (this.settings.camera) {
          command.add_arg("-thread_queue_size");
          command.add_arg("512");
          command.add_arg("-f");
          command.add_arg("v4l2");
          command.add_arg("-framerate");
          command.add_arg("30");
          command.add_arg("-i");
          command.add_arg("/dev/video0");
        }
        if (this.settings.microphone) {
          command.add_arg("-thread_queue_size");
          command.add_arg("512");
          command.add_arg("-f");
          command.add_arg("pulse");
          command.add_arg("-i");
          command.add_arg("default");
        }
      }
      if (this.settings.camera) {
        command.add_arg("-c:v");
        command.add_arg("libx264");
        command.add_arg("-preset");
        command.add_arg("ultrafast");
        command.add_arg("-tune");
        command.add_arg("zerolatency");
        command.add_arg("-crf");
        command.add_arg("18");
        command.add_arg("-threads");
        command.add_arg("1");
      }
      if (this.settings.microphone) {
        command.add_arg("-c:a");
        command.add_arg("pcm_s16le");
        command.add_arg("-af");
        command.add_arg("aresample=async=1:first_pts=0");
      }
      command.add_arg(this.media);
      try this.recorder.start(command);
      this.clock = std.time.now();
      return SystemResult.Ok;
    }

    /** Polls devices and reports unavailable or disconnected inputs without silently losing a track. */
    public method poll() SystemResult<void> {
      if (this.directory.is_empty()) {
        return SystemResult.Ok;
      }
      try this.recorder.tick();
      var lines = this.recorder.text.split(make_heap_allocator(), b'\n');
      for (var line: ref String in lines) {
        if (line.starts_with("out_time_us=")) {
          var value = match line.substr(make_heap_allocator(), 12, line.length() - 12) {
            AccessResult.Ok(value) => value,
            AccessResult.OutOfBounds(_) => String("")
          };
          match value.parse_i64() {
            Option.Some(time) => {
              this.media_time = time;
            },
            Option.None => {}
          };
        }
      }
      if (this.recorder.text.ends_with("\n")) {
        this.recorder.text = String("");
      }
      if (not this.recorder.running and not this.stopping) {
        return SystemResult.Error(
          Error(
            1,
            `Camera or microphone capture stopped. Check device access and permissions: ${this.recorder.diagnostics}`
          )
        );
      }
      if (this.media_time < 0 and this.clock.elapsed().as_secs() > 30) {
        return SystemResult.Error(
          Error(1, "Camera or microphone did not start. Check device permissions.")
        );
      }
      if (this.stopping and this.recorder.running and this.clock.elapsed().as_secs() > 15) {
        return SystemResult.Error(Error(1, "Camera or microphone did not finish saving"));
      }
      if (this.stopping and not this.recorder.running and this.recorder.status != 0 and
        this.recorder.status != 255) {
        return SystemResult.Error(
          Error(1, `Camera or microphone recording failed: ${this.recorder.diagnostics}`)
        );
      }
      return SystemResult.Ok;
    }

    /** Waits for real presenter frames before starting desktop capture. */
    public method ready() bool {
      return not this.settings.enabled() or this.media_time >= 0;
    }

    /** Aligns presenter time to the first desktop recording frame. */
    public method mark_screen() void {
      this.offset = this.media_time > 0 ? _convert<f64>(this.media_time) / 1000000.0 : 0.0;
    }

    /** Requests a trailer once, keeping the event loop responsive during shutdown. */
    public method stop() void {
      if (not this.stopping) {
        this.stopping = true;
        this.clock = std.time.now();
        this.recorder.interrupt();
      }
    }

    /** Composes only finalized inputs; callers publish the result after this reports completion. */
    public method compose(screen: ref String) SystemResult<void> {
      try this.poll();
      if (this.recorder.running) {
        return SystemResult.Ok;
      }
      if (not this.composing) {
        var command = std.process.Command(make_heap_allocator(), "ffmpeg");
        command.add_arg("-nostdin");
        command.add_arg("-hide_banner");
        command.add_arg("-loglevel");
        command.add_arg("error");
        command.add_arg("-n");
        command.add_arg("-i");
        command.add_arg(screen);
        command.add_arg("-ss");
        command.add_arg(`${this.offset}`);
        command.add_arg("-i");
        command.add_arg(this.media);
        if (this.settings.camera) {
          command.add_arg("-filter_complex_threads");
          command.add_arg("1");
          command.add_arg("-filter_complex");
          command.add_arg(overlay(this.settings));
          command.add_arg("-map");
          command.add_arg("[v]");
        } else {
          command.add_arg("-map");
          command.add_arg("0:v:0");
        }
        video_encoding(command);
        if (this.settings.microphone) {
          command.add_arg("-map");
          command.add_arg("1:a:0");
          command.add_arg("-af");
          command.add_arg("aresample=async=1:first_pts=0,apad");
          command.add_arg("-c:a");
          command.add_arg("libopus");
          command.add_arg("-b:a");
          command.add_arg("128k");
          command.add_arg("-shortest");
        } else {
          command.add_arg("-an");
        }
        command.add_arg(this.result);
        try this.encoder.start(command);
        this.composing = true;
        this.clock = std.time.now();
      }
      try this.encoder.tick();
      if (not this.encoder.running) {
        if (this.encoder.status != 0) {
          return SystemResult.Error(
            Error(1, `Cannot compose presenter recording: ${this.encoder.diagnostics}`)
          );
        }
        this.completed = true;
      } else if (this.clock.elapsed().as_secs() > 300) {
        return SystemResult.Error(Error(1, "Presenter composition timed out"));
      }
      return SystemResult.Ok;
    }
  }
}
