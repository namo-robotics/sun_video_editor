using std;

/** Validates camera and microphone settings shared by the native live recorders. */
module presenter {

  /** Holds recording-only choices shared by the platform helpers. */
  public class Options {
    public var camera: bool = false;
    public var microphone: bool = false;
    public var corner: i64 = 0;
    public var size: i64 = 1;

    /** Defaults to a medium camera inset in the lower-right corner. */
    init() {}

    /** Reports whether a presenter capture is needed. */
    public method enabled() bool {
      return this.camera or this.microphone;
    }
  }

  /** Accepts the legacy protocol or validates all recording-only choices before opening devices. */
  public function options(args: ref Vec<String>) SystemResult<Options> {
    var result = Options();
    if (args.size() == 5) {
      return SystemResult.Ok(result);
    }
    if (args.size() != 9 or
      (not args[5].equals_literal("camera") and not args[5].equals_literal("no-camera")) or
      (not args[6].equals_literal("microphone") and not args[6].equals_literal("no-microphone"))) {
      return SystemResult.Error(Error(1, "Invalid presenter settings"));
    }
    result.camera = args[5].equals_literal("camera");
    result.microphone = args[6].equals_literal("microphone");
    result.corner = match args[7].parse_i64() {
      Option.Some(value) => value,
      Option.None => -1
    };
    result.size = match args[8].parse_i64() {
      Option.Some(value) => value,
      Option.None => -1
    };
    if (result.corner < 0 or result.corner > 3 or result.size < 0 or result.size > 2 or
      (result.enabled() and not args[1].equals_literal("record"))) {
      return SystemResult.Error(Error(1, "Invalid presenter settings"));
    }
    return SystemResult.Ok(result);
  }
}
