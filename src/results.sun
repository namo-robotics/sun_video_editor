/** Provides explicitly allocated, checked string copies. */
public module sun_video_editor_results {

  /** Copies a byte range or throws on invalid bounds or allocation failure. */
  public function substring(
    text: const ref std.String,
    allocator: const ref std.HeapAllocator,
    start: i64,
    count: i64
  ) std.String throws {
    if (start < 0 or count < 0 or start > text.length() or count > text.length() - start) {
      throw std.IndexOutOfBoundsError(start);
    }
    return text.substr(allocator, start, count);
  }
}
