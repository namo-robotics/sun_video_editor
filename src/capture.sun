using std;

/** Owns capture settings and the asynchronous desktop capture helper. */
module screencast {

  /** Validates a bounded, whole-second countdown without accepting shell syntax. */
  public function delay_seconds(text: const ref String) i64 throws {
    if (text.is_empty() or text.length() > 4) {
      throw Error(1, "Enter a whole number of seconds from 0 to 3600");
    }
    var value: i64 = 0;
    for (var i: i64 = 0; i < text.length(); i += 1) {
      var digit: u8 = 0;

      try {
        var value = text.at(i);

        digit = value;
      } catch (error: std.IndexOutOfBoundsError) {
        digit = b' ';
      }

      if (digit < b'0' or digit > b'9') {
        throw Error(1, "Enter a whole number of seconds from 0 to 3600");
      }
      value = value * 10 + _convert<i64>(digit - b'0');
    }
    if (value > 3600) {
      throw Error(1, "Delay cannot exceed 3600 seconds");
    }
    return value;
  }

  /** Finds the companion helper beside an explicit executable path or a PATH entry. */
  public function helper_path(executable: const ref String) String throws {
    var candidate = `${executable}_capture`;
    if (std.io.is_file(candidate)) {
      return candidate;
    }
    var a = make_heap_allocator();
    var env = std.env.Env(a);
    match env.get("PATH") {
      Option.Some(path) => {
        var directories = path.split(a, b':');
        for (var directory: ref String in directories) {
          var installed = `${directory}/${executable}_capture`;

          if (std.io.is_file(installed)) {
            return installed;
          }
        }
      },
      Option.None => {}
    };
    return candidate;
  }

  /** Preserves bounded helper errors, including crash diagnostics and multiline encoder failures. */
  public function helper_failure(
    status: i32,
    output: const ref String,
    diagnostics: const ref String
  ) String throws {
    var a = make_heap_allocator();
    var message = String("");
    var lines = output.split(a, b'\n');
    for (var line: ref String in lines) {
      if (line.starts_with("Capture failed:")) {
        message = line.clone(a);
      } else if (not message.is_empty() and not line.is_empty()) {
        message.append("\n");
        message.append(line);
      }
    }
    if (message.is_empty()) {
      var detail = diagnostics.clone(a);
      detail.trim();
      if (detail.is_empty()) {
        message = `Capture failed: helper exited unexpectedly (status ${status}). Rebuild or reinstall Sun Video Editor.`;
      } else {
        message = `Capture failed (status ${status}): ${detail}`;
      }
    }
    if (message.length() > 2048) {
      try {
        var value = sun_video_editor_results.substring(message, a, 0, 2048);
        message = value;
      } catch (error: std.IndexOutOfBoundsError) {
        message = String("Capture failed");
      }

      message.append("…");
    }
    for (var line: ref String in lines) {
      if (line.starts_with("Recovery:") and not message.contains(line)) {
        message.append("\n");
        message.append(line);
      }
    }
    return message;
  }

  /** Keeps capture lifetime separate from the editor's conversion jobs. */
  public class Capture {
    public var process: video.Process;
    public var copy_process: video.Process;
    var copy_temporary: String;
    var copy_destination: String;
    public var helper: String;
    public var delay: String;
    public var kind: i64 = 0;
    public var source: i64 = 0;
    public var cursor: bool = true;
    public var camera: bool = false;
    public var microphone: bool = false;
    public var corner: i64 = 0;
    public var camera_size: i64 = 1;
    public var recording: bool = false;
    public var stopping: bool = false;
    public var message: String;
    public var saved: String;
    public var preview: video.Job;
    public var preview_position: i64 = 0;
    public var preview_start: i64 = 0;
    public var preview_end: i64 = 0;
    var preview_path: String;
    var cancelled: bool = false;
    var observed: i64 = 0;

    /** Cancels an owned capture and gives it time to close its portal and remove partial output. */
    deinit() {
      this.copy_process.stop();
      this.cleanup_copy();
      if (this.process.running) {
        this.process.cancel();
        var start = std.time.now();
        while (this.process.running and start.elapsed().as_millis() < 1800) {
          try {
            this.process.tick();
          } catch {}
          std.time.sleep(std.time.create_duration_millis(10));
        }
        this.process.stop();
      }
    }

    /** Removes only this save operation's private partial file. */
    method cleanup_copy() void {
      if (not this.copy_temporary.is_empty()) {
        try {
          std.io.remove_file(this.copy_temporary);
        } catch {}
        this.copy_temporary.clear();
      }
    }

    /** Copies a completed capture asynchronously; the save chooser confirms replacements. */
    public method save_copy(source: ref String, destination: const ref String) void throws {
      if (this.copy_process.running or source.is_empty() or not std.io.is_file(source)) {
        throw Error(1, "The captured file is unavailable or a save is already running");
      }
      var a = make_heap_allocator();
      this.copy_destination = destination.clone(a);
      var suffix = source.ends_with(".png") ? ".png" : (source.ends_with(".mp4") ? ".mp4" : ".webm");
      if (not this.copy_destination.ends_with(suffix)) {
        throw Error(
          1,
          `Keep the ${suffix} extension when saving this capture`
        );
      }
      if (this.copy_destination.equals(source)) {
        this.message = String("Capture is already saved at that location.");
        return;
      }
      var reserve = std.process.Command(a, "mktemp");
      reserve.add_arg("--");
      reserve.add_arg(
        `${this.copy_destination}.sun-save-XXXXXX`
      );
      this.copy_temporary = video.capture(reserve);
      var command = std.process.Command(a, "cp");
      command.add_arg("--");
      command.add_arg(source);
      command.add_arg(this.copy_temporary);
      try {
        this.copy_process.start(command);
      } catch (error: std.Error) {
        this.cleanup_copy();
        throw error;
      }
      this.message = String("Saving a copy…");
      return;
    }

    /** Publishes a complete copy atomically, preserving the original capture on failure. */
    method tick_copy() bool throws {
      if (not this.copy_process.running) {
        return false;
      }
      try {
        this.copy_process.tick();
      } catch (error: std.Error) {
        this.copy_process.stop();
        this.cleanup_copy();
        this.message = (error.message()).clone(make_heap_allocator());
        return true;
      }
      if (not this.copy_process.running) {
        if (this.copy_process.status == 0) {
          try {
            std.io.rename_file(this.copy_temporary, this.copy_destination);
            this.message = `Saved copy: ${this.copy_destination}`;
          } catch (error: std.Error) {
            this.message = (error.message()).clone(make_heap_allocator());
          }
        } else {
          this.message = `Save failed: ${this.copy_process.diagnostics}`;
        }
        this.cleanup_copy();
        return true;
      }
      return false;
    }

    /** Starts native source selection; the helper counts down after selection. */
    public method start() void throws {
      var seconds = delay_seconds(this.delay);
      if (not std.io.is_file(this.helper)) {
        throw Error(
          1,
          "Capture helper is missing. Rebuild or reinstall Sun Video Editor."
        );
      }
      var a = make_heap_allocator();
      var command = std.process.Command(a, this.helper);
      command.add_arg(this.kind == 0 ? "screenshot" : "record");
      command.add_arg(this.source == 2 ? "area" : (this.source == 0 ? "screen" : "window"));
      command.add_arg(`${seconds}`);
      command.add_arg(this.cursor ? "cursor" : "hidden");
      command.add_arg(this.kind == 1 and this.camera ? "camera" : "no-camera");
      command.add_arg(this.kind == 1 and this.microphone ? "microphone" : "no-microphone");
      command.add_arg(`${this.corner}`);
      command.add_arg(`${this.camera_size}`);
      this.process.start(command);
      this.observed = 0;
      this.recording = false;
      this.stopping = false;
      this.cancelled = false;
      this.saved = String("");
      this.preview = video.Job();
      this.preview_path = String("");
      this.preview_position = 0;
      this.preview_start = 0;
      this.preview_end = 0;
      this.message = String("Choose a source in the desktop permission dialog…");
      return;
    }

    /** Finalizes a recording without terminating the encoder before its trailer is written. */
    public method finish() void throws {
      if (this.recording and not this.stopping) {
        this.process.interrupt();
        this.stopping = true;

        this.message = String("Saving recording…");
      }

      return;
    }

    /** Cancels selection, countdown, or capture and discards unfinished output. */
    public method cancel() void throws {
      this.process.cancel();
      this.message = String(
        this.stopping ? "Stopping saving; retaining partial recording…" : "Capture cancelled."
      );
      this.stopping = true;
      this.cancelled = true;

      return;
    }

    /** Probes a completed recording for inline playback without changing the editor state. */
    public method tick_preview() bool throws {
      if (this.process.running or this.kind != 1 or this.saved.is_empty()) {
        return false;
      }
      var changed = false;
      if (not this.preview_path.equals(this.saved)) {
        this.preview_path = this.saved.clone(make_heap_allocator());
        this.preview_position = 0;
        this.preview_start = 0;
        this.preview_end = 0;
        try {
          this.preview.probe(this.saved);
        } catch (error: std.Error) {
          this.preview.fail(error);
        }
        changed = true;
      }
      var mode = this.preview.mode;
      if (mode != 0) {
        try {
          this.preview.tick();
        } catch (error: std.Error) {
          this.preview.fail(error);
        }
        if (this.preview.mode == 0) {
          if (this.preview.ready) {
            this.preview_end = _convert<i64>(this.preview.media.duration * 1000000.0);
          }
          changed = true;
        }
      }
      return changed;
    }

    /** Reads helper progress and completion without blocking GTK event dispatch. */
    public method tick() bool throws {
      var copy_changed = this.tick_copy();
      if (not this.process.running) {
        var preview_changed = this.tick_preview();
        return copy_changed or preview_changed;
      }
      this.process.tick();
      var changed = false;
      if (this.process.text.length() != this.observed and this.process.text.ends_with("\n")) {
        this.observed = this.process.text.length();
        var lines = this.process.text.split(make_heap_allocator(), b'\n');
        for (var line: ref String in lines) {
          if (line.equals_literal("Recording…")) {
            this.recording = true;
          }
          if (not line.is_empty()) {
            this.message = line.clone(make_heap_allocator());
          }
          if (line.starts_with("Saved: ")) {
            try {
              var value = sun_video_editor_results.substring(
                line,
                make_heap_allocator(),
                7,
                line.length() - 7
              );
              this.saved = value;
            } catch (error: std.IndexOutOfBoundsError) {
              this.saved = String("");
            }
          }
        }
        changed = true;
      }
      if (not this.process.running) {
        this.recording = false;
        if (this.process.status != 0 and not this.cancelled) {
          this.message = helper_failure(
            this.process.status,
            this.process.text,
            this.process.diagnostics
          );
          std.io.eprintln(this.process.diagnostics);
        }
        changed = true;
      }
      var preview_changed = this.tick_preview();
      return changed or preview_changed;
    }

    /** Initializes owned storage and reports allocation failure. */
    init() throws {
      this.preview = video.Job();

      this.copy_process = video.Process();

      this.process = video.Process();

      this.copy_temporary = String("");
      this.copy_destination = String("");
      this.helper = String("build/sun_video_editor_capture");
      this.delay = String("0");
      this.message = String("Ready to capture.");
      this.saved = String("");
      this.preview_path = String("");
    }
  }
}
