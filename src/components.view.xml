<Views module="editor_parts">
  <!-- A capture choice keeps selection colors and interaction states in the shared theme. -->
  <Component name="ChoiceButton">
    <Param name="text" type="String" />
    <Param name="action" type="i64" />
    <Param name="enabled" type="bool" />
    <Param name="selected" type="bool" />
    <Param name="width" type="i32" />
    <Param name="fontSize" type="i32" />
    <Button text="{text}" action="{action}" enabled="{enabled}" width="{width}" height="64" fontSize="{fontSize}" styleResource="{String(selected ? &quot;selectedChoice&quot; : &quot;choice&quot;)}" />
  </Component>
  <Component name="Panel">
    <Param name="column" type="i32" />
    <Param name="expandX" type="bool" />
    <Content name="header" />
    <Content name="body" />
    <Column column="{column}" spacing="12" expandX="{expandX}" expandY="true" styleResource="panel">
      <Slot name="header" />
      <Slot name="body" />
    </Column>
  </Component>
  <Component name="Section">
    <Param name="text" type="String" />
    <Param name="expandX" type="bool" />
    <Label text="{text}" styleResource="section" horizontal="Start" expandX="{expandX}" />
  </Component>
  <Component name="LabeledField">
    <Param name="text" type="String" />
    <Content name="body" />
    <Label text="{text}" horizontal="Start" />
    <Slot name="body" />
  </Component>
</Views>
