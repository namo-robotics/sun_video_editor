{
  "root": true,
  "entrypoints": [
    {
      "name": "sun_video_editor",
      "path": "src/main.sun",
      "type": "binary",
      "export": true,
      "resources": [
        {
          "path": "packaging/icons",
          "destination": "sun_video_editor_capture.icons"
        }
      ],
      "build": [
        "scripts/generate_view.sh",
        "scripts/build_editor.sh"
      ]
    },
    {
      "name": "editor_tests",
      "path": "tests/main.sun",
      "type": "binary",
      "export": false,
      "build": [
        "scripts/generate_view.sh",
        "scripts/build_editor.sh"
      ]
    },
    {
      "name": "editor_build",
      "path": "src/tools/build.sun",
      "type": "binary",
      "export": false
    },
    {
      "name": "editor_package_tool",
      "path": "src/tools/package.sun",
      "type": "binary",
      "export": false,
      "build": [
        "scripts/build_tool.sh"
      ]
    },
    {
      "name": "sun_video_editor_capture",
      "path": "src/tools/capture.sun",
      "type": "binary",
      "export": true,
      "enabled": {
        "default": false,
        "target": {
          "x86_64-linux-gnu": true,
          "x86_64-linux-musl": true
        }
      },
      "build": [
        "scripts/build_capture.sh"
      ]
    },
    {
      "name": "capture_tests",
      "path": "tests/capture_backend.sun",
      "type": "binary",
      "export": false,
      "enabled": {
        "default": false,
        "target": {
          "x86_64-linux-gnu": true,
          "x86_64-linux-musl": true
        }
      },
      "build": [
        "scripts/build_capture.sh"
      ]
    },
    {
      "name": "sun_video_editor_capture",
      "path": "src/tools/capture_macos.sun",
      "type": "binary",
      "export": true,
      "enabled": {
        "default": false,
        "target": {
          "arm64-apple-darwin": true
        }
      },
      "build": [
        "scripts/build_capture_macos.sh"
      ]
    }
  ],
  "package_id": "namo-robotics/sun_video_editor",
  "dependencies": [
    {
      "target": {
        "x86_64-linux-gnu": {
          "git": "git@github.com:namo-robotics/sun_ui.git",
          "version": "main",
          "packages": {
            "namo-robotics/sun_ui": {
              "entrypoints": [
                "sun_ui",
                "sun_ui_gtk",
                "sun_viewc"
              ]
            }
          }
        },
        "arm64-apple-darwin": {
          "git": "git@github.com:namo-robotics/sun_ui.git",
          "version": "main",
          "packages": {
            "namo-robotics/sun_ui": {
              "entrypoints": [
                "sun_ui",
                "sun_ui_gtk",
                "sun_viewc"
              ]
            }
          }
        }
      }
    },
    {
      "target": {
        "x86_64-linux-gnu": {
          "git": "git@github.com:namo-robotics/sun_gobject.git",
          "version": "main",
          "packages": {
            "namo-robotics/sun_gobject": {
              "entrypoints": [
                "sun_gobject",
                "sun_gtk",
                "sun_capture"
              ]
            }
          }
        },
        "arm64-apple-darwin": {
          "git": "git@github.com:namo-robotics/sun_gobject.git",
          "version": "main",
          "packages": {
            "namo-robotics/sun_gobject": {
              "entrypoints": [
                "sun_gobject",
                "sun_gtk"
              ]
            }
          }
        }
      }
    },
    {
      "target": {
        "arm64-apple-darwin": {
          "git": "git@github.com:namo-robotics/sun_apple.git",
          "version": "main",
          "packages": {
            "namo-robotics/sun_apple": {
              "entrypoints": [
                "sun_apple"
              ]
            }
          }
        }
      }
    }
  ]
}
