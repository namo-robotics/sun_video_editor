{
  "root": true,
  "entrypoints": [
    {
      "name": "sun_video_editor",
      "path": "src/main.sun",
      "type": "binary",
      "export": true,
      "build": [
        "scripts/generate_view.sh",
        "scripts/build_editor.sh"
      ]
    },
    {
      "name": "editor_tests",
      "path": "tests/main.sun",
      "type": "binary",
      "export": false,
      "build": [
        "scripts/generate_view.sh",
        "scripts/build_editor.sh"
      ]
    },
    {
      "name": "editor_build",
      "path": "src/tools/build.sun",
      "type": "binary",
      "export": false
    },
    {
      "name": "editor_package_tool",
      "path": "src/tools/package.sun",
      "type": "binary",
      "export": false,
      "build": [
        "scripts/build_tool.sh"
      ]
    },
    {
      "name": "sun_video_editor_capture",
      "path": "src/tools/capture.sun",
      "type": "binary",
      "export": true,
      "enabled": {
        "default": false,
        "target": {
          "x86_64-linux-gnu": true,
          "x86_64-linux-musl": true
        }
      },
      "build": [
        "scripts/build_capture.sh"
      ]
    },
    {
      "name": "capture_tests",
      "path": "tests/capture_backend.sun",
      "type": "binary",
      "export": false,
      "enabled": {
        "default": false,
        "target": {
          "x86_64-linux-gnu": true,
          "x86_64-linux-musl": true
        }
      },
      "build": [
        "scripts/build_capture.sh"
      ]
    },
    {
      "name": "sun_video_editor_capture",
      "path": "src/tools/capture_macos.sun",
      "type": "binary",
      "export": true,
      "enabled": {
        "default": false,
        "target": {
          "arm64-apple-darwin": true
        }
      },
      "build": [
        "scripts/build_capture_macos.sh"
      ]
    }
  ],
  "package_id": "namo-robotics/sun_video_editor",
  "dependencies": [
    {
      "target": {
        "x86_64-linux-gnu": {
          "package": "namo-robotics/sun_ui",
          "url": "https://github.com/namo-robotics/sun_ui/releases/download/dev/sun_ui-x86_64-linux-gnu.sun.tar.gz"
        },
        "arm64-apple-darwin": {
          "package": "namo-robotics/sun_ui",
          "url": "https://github.com/namo-robotics/sun_ui/releases/download/dev/sun_ui-arm64-apple-darwin.sun.tar.gz"
        }
      }
    },
    {
      "target": {
        "x86_64-linux-gnu": {
          "package": "namo-robotics/sun_gobject",
          "url": "https://github.com/namo-robotics/sun_gobject/releases/download/dev/sun_gobject-x86_64-linux-gnu.sun.tar.gz"
        },
        "arm64-apple-darwin": {
          "package": "namo-robotics/sun_gobject",
          "url": "https://github.com/namo-robotics/sun_gobject/releases/download/dev/sun_gobject-arm64-apple-darwin.sun.tar.gz"
        }
      }
    },
    {
      "target": {
        "arm64-apple-darwin": {
          "package": "namo-robotics/sun_apple",
          "url": "https://github.com/namo-robotics/sun_apple/releases/download/dev/sun_apple-arm64-apple-darwin.sun.tar.gz"
        }
      }
    }
  ],
  "exports": [
    {
      "path": "packaging/icons",
      "destination": "bin/sun_video_editor_capture.icons"
    }
  ]
}
