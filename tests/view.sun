using std;

/** Checks the converter's reusable view without creating native widgets or media jobs. */
module sun_video_editor {

  /** Combines appearance validation and assertion failures. */
  enum ViewResult { Ok, Assertion(std.test.AssertionError), System(Error) }

  /** Preserves action availability and the shared palette across the export lifecycle. */
  test_function reusable_converter_states() ViewResult {
    for (var stage: i32 = 0; stage < 4; stage += 1) {
      var state = State();
      state.page = 1;
      state.job.ready = stage > 0;
      state.job.media.duration = 10.0;
      state.job.loaded = String("clip.mp4");
      state.job.mode = stage == 2 ? 2 : 0;
      state.job.percent = stage == 3 ? 100 : 0;
      var description = view(state);
      try std.test.assert(description.construction_error.is_empty());
      try description.resources.validate();
      try std.test.assert_eq(description.theme.normal.foreground, 0xdce6f4);
      try std.test.assert_eq(description.theme.normal.font_size, 14);
      var field = try description.resources.style(1, String("field"));
      try std.test.assert_eq(field.normal.background, 0x23334b);
      try std.test.assert_eq(field.normal.padding, 8);
      try std.test.assert_eq(field.disabled.foreground, 0x6c8098);
      var primary = try description.resources.style(1, String("primary"));
      try std.test.assert_eq(primary.normal.background, 0x73e2cb);
      try std.test.assert_eq(primary.normal.padding, 10);
      var controls: i64 = 0;
      for (var i: i64 = 0; i < description.elements.size(); i += 1) {
        var node = description.elements[i];
        try std.test.assert(node.parent < i);
        if (node.action == 0) {
          continue;
        }
        controls += 1;
        var enabled = state.job.mode == 0;
        if (node.action == 3 or node.action == 4 or node.action == 11 or node.action == 16) {
          enabled = enabled and state.job.ready;
        }
        if (node.action == 12) {
          enabled = state.job.mode != 0;
          try std.test.assert(node.visible == enabled);
        }
        try std.test.assert(node.enabled == enabled);
        for (var previous: i64 = 0; previous < i; previous += 1) {
          try std.test.assert(description.elements[previous].action != node.action);
        }
      }
      try std.test.assert_eq(controls, 15);
      var again = view(state);
      try std.test.assert_eq(description.elements.size(), again.elements.size());
      for (var i: i64 = 0; i < description.elements.size(); i += 1) {
        try std.test.assert(description.elements[i].key.equals(again.elements[i].key));
      }
    }
  }

  /** Disables GIF audio without losing the user's video audio preference. */
  test_function gif_audio_availability() ViewResult {
    var state = State();
    state.page = 1;
    for (var format: i64 = 5; format >= 0; format -= 5) {
      state.settings.format = format;
      var description = view(state);
      var found = false;
      for (var i: i64 = 0; i < description.elements.size(); i += 1) {
        var node = description.elements[i];
        if (node.action == 8) {
          found = true;
          try std.test.assert(node.enabled == (format != 5));
          try std.test.assert(node.checked == (format != 5));
        }
      }
      try std.test.assert(found and state.settings.audio);
    }
  }

  /** Displays abnormal helper exits and keeps multiline device errors instead of blaming permissions. */
  test_function capture_failure_diagnostics() ViewResult {
    var empty = String("");
    var crash = String("pointer being freed was not allocated\n");
    var message = screencast.helper_failure(134, empty, crash);
    try std.test.assert(message.contains("134") and message.contains("pointer being freed"));
    var output = String("Recording…\nCapture failed: Camera unavailable\nDevice is busy\n");
    message = screencast.helper_failure(1, output, crash);
    try std.test.assert(
      message.contains("Camera unavailable") and message.contains("Device is busy")
    );
    try std.test.assert(not message.contains("pointer being freed"));
    message = screencast.helper_failure(9, empty, empty);
    try std.test.assert(message.contains("9") and message.contains("exited unexpectedly"));
    var verbose = String("");
    for (var i: i64 = 0; i < 3000; i += 1) {
      verbose.append("x");
    }
    message = screencast.helper_failure(1, empty, verbose);
    try std.test.assert(message.length() < 2100);
  }

  /** Accepts whole-second delays and rejects malformed or unbounded countdowns. */
  test_function capture_delay_validation() ViewResult {
    try std.test.assert_eq(try screencast.delay_seconds(String("0")), 0);
    try std.test.assert_eq(try screencast.delay_seconds(String("3600")), 3600);
    var invalid = String("-1 1.5 3601 99999 nope").split_whitespace(make_heap_allocator());
    invalid.push(String(""));
    for (var value: ref String in invalid) {
      match screencast.delay_seconds(value) {
        SystemResult.Ok(_) => {
          try std.test.assert(false);
        },
        SystemResult.Error(_) => {}
      };
    }
  }

  /** Save as copies both capture types without changing the preview or the original file. */
  test_function capture_save_copy() ViewResult {
    var fixture = try video_fixtures.Fixture();
    var a = make_heap_allocator();
    for (var kind: i64 = 0; kind < 2; kind += 1) {
      var capture = screencast.Capture();
      var source = fixture.path(kind == 0 ? "original.png" : "original.webm");
      var target = fixture.path(kind == 0 ? "copy with spaces.png" : "copy with spaces.webm");
      var contents = String("capture bytes");
      try std.io.write_string(source, contents);
      capture.saved = source.clone(a);
      try capture.save_copy(source, target);
      var deadline = std.time.now();
      while (capture.copy_process.running and deadline.elapsed().as_secs() < 5) {
        var changed = try capture.tick();
        std.time.sleep(std.time.create_duration_millis(10));
      }
      try std.test.assert(not capture.copy_process.running);
      var saved = try std.io.read_to_string(a, target);
      try std.test.assert(saved.equals(contents));
      try std.test.assert(capture.saved.equals(source) and std.io.is_file(source));
      try std.test.assert(capture.message.starts_with("Saved copy:"));
      var invalid = fixture.path("missing-dir/copy.png");
      match capture.save_copy(source, invalid) {
        SystemResult.Ok => {
          try std.test.assert(false);
        },
        SystemResult.Error(_) => {}
      };
      try std.test.assert(std.io.is_file(source));
    }
  }
}
