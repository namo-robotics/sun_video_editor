using std;

/** Tests presenter composition with generated media, without requesting camera or microphone access. */
module presenter_tests {

  /** Preserves both assertions and process failures. */
  enum TestResult { Ok, Assertion(std.test.AssertionError), System(Error) }

  /** Rejects invalid positions, sizes, and screenshot device requests before device access. */
  test_function arguments() TestResult {
    var args = String("capture record screen 0 cursor camera microphone 0 1").split_whitespace(
      make_heap_allocator()
    );
    var settings = try presenter.options(args);
    try std.test.assert(
      settings.camera and settings.microphone and settings.corner == 0 and settings.size == 1
    );
    for (var field: i64 = 0; field < 3; field += 1) {
      var invalid = String(
        field == 0 ? "capture record screen 0 cursor camera microphone 4 1" : (field == 1 ? "capture record screen 0 cursor camera microphone 0 3" : "capture screenshot screen 0 cursor camera microphone 0 1")
      ).split_whitespace(
        make_heap_allocator()
      );
      match presenter.options(invalid) {
        SystemResult.Ok(_) => {
          try std.test.fail("Accepted invalid presenter options");
        },
        SystemResult.Error(_) => {}
      };
    }
    return TestResult.Ok;
  }
}
