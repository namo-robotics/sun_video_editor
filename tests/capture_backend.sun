using std;

/** Exercises real synthetic-frame encoding and the Sun capture lifecycle without desktop access. */
module capture_tests {

  /** Runs a tool and returns its trimmed standard output, preserving diagnostics on failure. */
  function command(command: ref std.process.Command) String throws {
    var output = command.output();
    if (output.status() != 0) {
      throw Error(
        output.status(),
        output.stderr().clone(make_heap_allocator())
      );
    }
    var result = output.stdout().clone(make_heap_allocator());
    result.trim();
    return result;
  }

  /** Runs one bounded capture, verifies codec and dimensions, and checks partial-file cleanup. */
  function encode(
    video: bool,
    cancel: bool,
    crop: bool,
    scaled: bool,
    revoked: bool,
    width: i32,
    height: i32,
    window: bool
  ) void throws {
    var a = make_heap_allocator();
    var stamp = desktop.filename_stamp();
    var directory = `build/capture_tests-output/${stamp}`;
    var destination = String("");
    if (true) {
      var capture = capture_backend.Capture(video, crop, window, true, 0);
      if (crop) {
        capture.logical_width = scaled ? 160 : width;
        capture.logical_height = scaled ? 120 : height;
        capture.x = scaled ? 10 : 13;
        capture.y = scaled ? 20 : 27;
        capture.width = scaled ? 50 : 137;
        capture.height = scaled ? 30 : 91;
      }
      var source = `videotestsrc is-live=true name=source ! video/x-raw,width=${width},height=${height},framerate=30/1`;

      capture.start(source, directory, true);
      destination = capture.destination.clone(a);
      var start = std.time.now();
      while (not capture.completed and not capture.cancelled and start.elapsed().as_secs() < 8) {
        capture.tick();
        if (video and capture.recording and start.elapsed().as_millis() > 600 and
          not capture.finishing) {
          if (cancel) {
            capture.cancel();
          } else if (revoked) {
            capture.sharing_ended();
            capture.sharing_ended();
          } else {
            capture.stop();
          }
        }
        std.time.sleep(std.time.create_duration_millis(2));
      }
      if (not cancel and not capture.completed) {
        throw Error(1, "Synthetic capture did not finish");
      }
    }
    if (cancel) {
      if (std.io.is_file(destination)) {
        throw Error(1, "Cancellation published output");
      }
    } else {
      var probe = std.process.Command(a, "ffprobe");
      probe.add_arg("-v");
      probe.add_arg("error");
      probe.add_arg("-show_entries");
      probe.add_arg("stream=codec_name,width,height");
      probe.add_arg("-of");
      probe.add_arg("csv=p=0");
      probe.add_arg(destination);
      var actual = command(probe);
      var codec = video ? "h264" : "png";
      var expected_width = crop ? (scaled ? 100 : 137) : width;
      var expected_height = crop ? (scaled ? 60 : 91) : height;
      if (video) {
        expected_width = (expected_width + 1) / 2 * 2;
        expected_height = (expected_height + 1) / 2 * 2;
      }
      var expected = `${codec},${expected_width},${expected_height}`;

      if (not actual.equals(expected)) {
        throw Error(
          1,
          `Expected ${expected}, received ${actual}`
        );
      }
    }
    var leftovers = std.process.Command(a, "find");
    leftovers.add_arg(directory);
    leftovers.add_arg("-name");
    leftovers.add_arg(".sun-capture-*");
    var found = command(leftovers);
    if (not found.is_empty()) {
      throw Error(1, "Capture leaked a private output file");
    }
    return;
  }

  /** Window streams without padding retain their exact size through both output formats. */
  test_function window_capture() {
    encode(false, false, false, false, false, 321, 241, true);
    encode(true, false, false, false, false, 321, 241, true);
    return;
  }

  /** A single frame produces a readable lossless screenshot. */
  test_function screenshot() {
    encode(false, false, false, false, false, 320, 240, false);
    return;
  }

  /** Stopping drains the encoder and writes a readable WebM trailer. */
  test_function recording() {
    encode(true, false, false, false, false, 320, 240, false);
    return;
  }

  /** The Linux pipeline publishes the combined recording only after both encoders finish. */
  test_function presenter_recording() {
    var capture = capture_backend.Capture(true, false, false, true, 0);
    capture.presenter.camera = true;
    capture.presenter.microphone = true;
    var directory = String("build/capture-presenter-tests");
    var clock = std.time.now();
    var source = String(
      "videotestsrc is-live=true name=source ! video/x-raw,width=320,height=240,framerate=30/1"
    );

    capture.start(source, directory, true);
    clock = std.time.now();
    while (not capture.completed and clock.elapsed().as_secs() < 20) {
      capture.tick();
      if (capture.recording and not capture.finishing and clock.elapsed().as_millis() > 800) {
        capture.stop();
        std.test.assert(not std.io.is_file(capture.destination));
      }
      std.time.sleep(std.time.create_duration_millis(5));
    }
    std.test.assert(capture.completed);
    var probe = std.process.Command(make_heap_allocator(), "ffprobe");

    probe.add_arg("-v");
    probe.add_arg("error");
    probe.add_arg("-show_entries");
    probe.add_arg("stream=codec_name,width,height");
    probe.add_arg("-of");
    probe.add_arg("csv=p=0");
    probe.add_arg(capture.destination);
    var streams = command(probe);
    std.test.assert(streams.contains("h264,320,240") and streams.contains("aac"));
    return;
  }

  /** Repeated portal revocation finalizes the recording only once. */
  test_function revoked_recording() {
    encode(true, false, false, false, true, 320, 240, false);
    return;
  }

  /** Cancellation never publishes a partial recording. */
  test_function cancellation() {
    encode(true, true, false, false, false, 320, 240, false);
    return;
  }

  /** Odd region dimensions survive PNG encoding without padding or scaling. */
  test_function area_screenshot() {
    encode(false, false, true, false, false, 320, 240, false);
    return;
  }

  /** Odd video regions receive at most one padding pixel for H.264 encoding. */
  test_function area_recording() {
    encode(true, false, true, false, false, 320, 240, false);
    return;
  }

  /** Logical monitor coordinates scale to physical stream pixels. */
  test_function scaled_area() {
    encode(false, false, true, true, false, 320, 240, false);
    return;
  }

  /** Cancelling a cropped recording removes its private file. */
  test_function area_cancellation() {
    encode(true, true, true, false, false, 320, 240, false);
    return;
  }

  /** High-resolution screenshots retain source dimensions. */
  test_function screenshot_4k() {
    encode(false, false, false, false, false, 3840, 2160, false);
    return;
  }

  /** Full-HD recordings preserve the source resolution. */
  test_function recording_full_hd() {
    encode(true, false, false, false, false, 1920, 1080, false);
    return;
  }

  /** Compares decoded captures against deterministic full-resolution reference pixels. */
  test_function pixel_fidelity() {
    var a = make_heap_allocator();
    for (var mode = 0; mode < 2; mode += 1) {
      var stamp = desktop.filename_stamp();
      var directory = `build/capture_tests-output/${stamp}`;
      var width = mode == 0 ? 3840 : 1920;
      var height = mode == 0 ? 2160 : 1080;
      var reference = desktop.Output();
      reference.reserve(directory);
      var raw = `${directory}/reference.raw`;
      var conversion = "";
      var pipeline = desktop.Pipeline();
      var empty = String("");
      var description = `videotestsrc name=source pattern=checkers-8 num-buffers=1 ! video/x-raw,format=RGB,width=${width},height=${height},framerate=30/1 ! ${conversion}fdsink name=output`;

      pipeline.configure(description, reference, -1, empty, empty);
      pipeline.play();
      var start = std.time.now();
      var done = false;
      while (not done and start.elapsed().as_secs() < 8) {
        done = pipeline.poll() == 2;
        std.time.sleep(std.time.create_duration_millis(2));
      }
      std.test.assert(done);
      pipeline.close();
      reference.publish(raw);
      var capture = capture_backend.Capture(mode == 1, false, false, true, 0);
      var source = `videotestsrc name=source pattern=checkers-8 is-live=true ! video/x-raw,format=RGB,width=${width},height=${height},framerate=30/1`;

      capture.start(source, directory, true);
      start = std.time.now();
      while (not capture.completed and start.elapsed().as_secs() < 8) {
        capture.tick();
        if (mode == 1 and capture.recording and start.elapsed().as_millis() > 600) {
          capture.stop();
        }
        std.time.sleep(std.time.create_duration_millis(2));
      }
      std.test.assert(capture.completed);
      var compare = std.process.Command(a, "ffmpeg");
      compare.add_arg("-v");
      compare.add_arg("info");
      compare.add_arg("-f");
      compare.add_arg("rawvideo");
      compare.add_arg("-pixel_format");
      compare.add_arg("rgb24");
      compare.add_arg("-framerate");
      compare.add_arg("30");
      compare.add_arg("-video_size");
      compare.add_arg(`${width}x${height}`);
      compare.add_arg("-i");
      compare.add_arg(raw);
      compare.add_arg("-i");
      compare.add_arg(capture.destination);
      compare.add_arg("-filter_complex_threads");
      compare.add_arg("1");
      compare.add_arg("-lavfi");
      // Compare recordings after their intentional chroma subsampling, using the encoder's matrix.
      compare.add_arg(
        mode == 0 ? "[0:v]format=gbrp[reference];[1:v]format=gbrp[captured];[reference][captured]ssim" : "[0:v]scale=out_color_matrix=bt709:out_range=tv,format=yuv420p[reference];[1:v]format=yuv420p[captured];[reference][captured]ssim"
      );
      compare.add_arg("-frames:v");
      compare.add_arg("1");
      compare.add_arg("-threads");
      compare.add_arg("1");
      compare.add_arg("-f");
      compare.add_arg("null");
      compare.add_arg("-");
      var result = compare.output();
      std.test.assert_eq(result.status(), 0);
      var diagnostic = result.stderr().clone(a);
      if (mode == 0) {
        var decoded = `${directory}/decoded.rgb`;
        var decode = std.process.Command(a, "ffmpeg");
        decode.add_arg("-v");
        decode.add_arg("error");
        decode.add_arg("-i");
        decode.add_arg(capture.destination);
        decode.add_arg("-frames:v");
        decode.add_arg("1");
        decode.add_arg("-pix_fmt");
        decode.add_arg("rgb24");
        decode.add_arg("-threads");
        decode.add_arg("1");
        decode.add_arg("-f");
        decode.add_arg("rawvideo");
        decode.add_arg(decoded);
        command(decode);
        var identical = std.process.Command(a, "cmp");
        identical.add_arg(raw);
        identical.add_arg(decoded);
        command(identical);
        std.test.assert(diagnostic.contains("All:1.000000"), "PNG changed the source pixels");
      } else {
        var faithful = diagnostic.contains("All:0.99") or diagnostic.contains("All:0.98") or
          diagnostic.contains("All:0.97") or diagnostic.contains("All:1.000000");
        if (not faithful) {
          std.io.eprintln(diagnostic);
        }
        std.test.assert(faithful, "Recording lost source detail");
      }
    }
    return;
  }

  /** Finalizes a recording when source failure and portal closure arrive in either order. */
  function interrupted_recording(error_first: bool) void throws {
    var stamp = desktop.filename_stamp();
    var directory = `build/capture_tests-output/${stamp}`;
    var capture = capture_backend.Capture(true, false, false, true, 0);
    var source = String("videotestsrc is-live=true name=source");

    capture.start(source, directory, true);
    var start = std.time.now();
    while (not capture.completed and start.elapsed().as_secs() < 8) {
      capture.tick();
      if (capture.recording and not capture.finishing and start.elapsed().as_millis() > 500) {
        if (error_first) {
          capture.pipeline_event(3);
          capture.sharing_ended();
        } else {
          capture.sharing_ended();
          capture.pipeline_event(3);
        }
      }
      std.time.sleep(std.time.create_duration_millis(2));
    }
    std.test.assert(capture.completed);
    return;
  }

  /** A source error before portal closure still drains the encoder. */
  test_function source_error_before_close() {
    interrupted_recording(true);
    return;
  }

  /** A late source error cannot interrupt already requested finalization. */
  test_function source_error_after_close() {
    interrupted_recording(false);
    return;
  }

  /** Runs until a native pipeline error propagates, bounding a broken test fixture. */
  function await_error(capture: ref capture_backend.Capture) void throws {
    var start = std.time.now();
    while (not capture.completed and start.elapsed().as_secs() < 8) {
      capture.tick();
      std.time.sleep(std.time.create_duration_millis(2));
    }
    return;
  }

  /** An error downstream of the desktop source cannot publish incomplete output. */
  test_function output_error() {
    var stamp = desktop.filename_stamp();
    var directory = `build/capture_tests-output/${stamp}`;
    var capture = capture_backend.Capture(true, false, false, true, 0);
    var source = String("videotestsrc is-live=true name=source ! identity error-after=15");

    capture.start(source, directory, true);

    var operation_completed_6 = false;
    try {
      await_error(capture);
      operation_completed_6 = true;
      std.test.fail("Pipeline error did not propagate");
    } catch (error: std.Error) {
      if (operation_completed_6) {
        throw;
      }
    }

    std.test.assert(not capture.completed);
    var published = std.io.is_file(capture.destination);
    std.test.assert(not published);
    return;
  }

  /** Delay validation rejects malformed, negative, and excessive arguments. */
  test_function delays() {
    var invalid = String("-1");

    var operation_completed_5 = false;
    try {
      capture_backend.delay_seconds(invalid);
      operation_completed_5 = true;
      std.test.fail("Accepted negative delay");
    } catch (error: std.Error) {
      if (operation_completed_5) {
        throw;
      }
    }

    invalid = String("3601");

    var operation_completed_4 = false;
    try {
      capture_backend.delay_seconds(invalid);
      operation_completed_4 = true;
      std.test.fail("Accepted excessive delay");
    } catch (error: std.Error) {
      if (operation_completed_4) {
        throw;
      }
    }

    invalid = String("1;true");

    var operation_completed_3 = false;
    try {
      capture_backend.delay_seconds(invalid);
      operation_completed_3 = true;
      std.test.fail("Accepted nonnumeric delay");
    } catch (error: std.Error) {
      if (operation_completed_3) {
        throw;
      }
    }

    var capture = capture_backend.Capture(false, false, false, true, 1);
    capture.countdown();
    if (capture.countdown_ready() or not capture.destination.is_empty()) {
      std.test.fail("Countdown started capture early");
    }
    std.time.sleep(std.time.create_duration_millis(1050));
    if (not capture.countdown_ready()) {
      std.test.fail("Countdown did not expire");
    }
    return;
  }

  /** An area cannot start a pipeline or reserve a file before selection. */
  test_function selection_required() {
    var capture = capture_backend.Capture(false, true, false, true, 0);
    var source = String("videotestsrc name=source");
    var directory = String("build/capture-unselected");

    var operation_completed_2 = false;
    try {
      capture.start(source, directory, true);
      operation_completed_2 = true;
      std.test.fail("Captured without selection");
    } catch (error: std.Error) {
      if (operation_completed_2) {
        throw;
      }
    }

    if (not capture.destination.is_empty()) {
      std.test.fail("Reserved output before selection");
    }
    return;
  }

  /** Error recovery retains an owned partial file while ordinary cancellation still removes it. */
  test_function recovery_retains_partial_output() {
    var path = String("");
    if (true) {
      var output = desktop.Output();
      var directory = String("build/capture-recovery-tests");
      output.reserve(directory);
      path = output.preserve();
      var content = String("recoverable fragments");
      std.io.write_string(path, content);
    }
    var saved = std.io.read_to_string(make_heap_allocator(), path);
    std.test.assert(saved.equals_literal("recoverable fragments"));
    std.io.remove_file(path);
    return;
  }

  /** Publication cannot replace an existing destination and cleanup removes the private file. */
  test_function publication_collision() {
    var stamp = desktop.filename_stamp();
    var directory = `build/capture_tests-output/${stamp}`;
    var output = desktop.Output();
    output.reserve(directory);
    var destination = `${directory}/existing.png`;
    var original = String("keep me");
    std.io.write_string(destination, original);

    var operation_completed_1 = false;
    try {
      output.publish(destination);
      operation_completed_1 = true;
      std.test.fail("Replaced existing output");
    } catch (error: std.Error) {
      if (operation_completed_1) {
        throw;
      }
    }

    var contents = std.io.read_to_string(make_heap_allocator(), destination);
    if (not contents.equals(original)) {
      std.test.fail("Existing output changed");
    }
    return;
  }
}

/** Provides the executable whose companion runs the capture test functions. */
function main() i32 {
  return 0;
}
manifest {
  libraries: [
    "stdlib.moon",
    "${namo-robotics/sun_gobject}/lib/sun_capture.moon"
  ],
  source_files: [
    "../src/results.sun",
    "../src/tools/capture_backend.sun",
    "../src/tools/recording.sun",
    "../src/process.sun"
  ]
}
