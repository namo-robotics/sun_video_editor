using std;

/** Exercises real synthetic-frame encoding and the Sun capture lifecycle without desktop access. */
module capture_tests {

  /** Runs a tool and returns its trimmed standard output, preserving diagnostics on failure. */
  function command(command: ref std.process.Command) SystemResult<String> {
    var output = try command.output();
    if (output.status() != 0) {
      return SystemResult.Error(
        try Error(
          output.status(),
          try output.stderr().clone(make_heap_allocator())
        )
      );
    }
    var result = try output.stdout().clone(make_heap_allocator());
    result.trim();
    return SystemResult.Ok(result);
  }

  /** Runs one bounded capture, verifies codec and dimensions, and checks partial-file cleanup. */
  function encode(
    video: bool,
    cancel: bool,
    crop: bool,
    scaled: bool,
    revoked: bool,
    width: i32,
    height: i32,
    window: bool
  ) SystemResult<void> {
    var a = make_heap_allocator();
    var stamp = try desktop.filename_stamp();
    var directory = try `build/capture_tests-output/${stamp}`;
    var destination = try String("");
    if (true) {
      var capture = try capture_backend.Capture(video, crop, window, true, 0);
      if (crop) {
        capture.logical_width = scaled ? 160 : width;
        capture.logical_height = scaled ? 120 : height;
        capture.x = scaled ? 10 : 13;
        capture.y = scaled ? 20 : 27;
        capture.width = scaled ? 50 : 137;
        capture.height = scaled ? 30 : 91;
      }
      var source = try `videotestsrc is-live=true name=source ! video/x-raw,width=${width},height=${height},framerate=30/1`;

      try capture.start(source, directory, true);
      destination = try capture.destination.clone(a);
      var start = std.time.now();
      while (not capture.completed and not capture.cancelled and start.elapsed().as_secs() < 8) {
        try capture.tick();
        if (video and capture.recording and start.elapsed().as_millis() > 600 and
          not capture.finishing) {
          if (cancel) {
            try capture.cancel();
          } else if (revoked) {
            try capture.sharing_ended();
            try capture.sharing_ended();
          } else {
            try capture.stop();
          }
        }
        std.time.sleep(std.time.create_duration_millis(2));
      }
      if (not cancel and not capture.completed) {
        return SystemResult.Error(Error(1, "Synthetic capture did not finish"));
      }
    }
    if (cancel) {
      if (try std.io.is_file(destination)) {
        return SystemResult.Error(Error(1, "Cancellation published output"));
      }
    } else {
      var probe = try std.process.Command(a, "ffprobe");
      try probe.add_arg("-v");
      try probe.add_arg("error");
      try probe.add_arg("-show_entries");
      try probe.add_arg("stream=codec_name,width,height");
      try probe.add_arg("-of");
      try probe.add_arg("csv=p=0");
      try probe.add_arg(destination);
      var actual = try command(probe);
      var codec = video ? "h264" : "png";
      var expected_width = crop ? (scaled ? 100 : 137) : width;
      var expected_height = crop ? (scaled ? 60 : 91) : height;
      if (video) {
        expected_width = (expected_width + 1) / 2 * 2;
        expected_height = (expected_height + 1) / 2 * 2;
      }
      var expected = try `${codec},${expected_width},${expected_height}`;

      if (not actual.equals(expected)) {
        return SystemResult.Error(
          try Error(
            1,
            try `Expected ${expected}, received ${actual}`
          )
        );
      }
    }
    var leftovers = try std.process.Command(a, "find");
    try leftovers.add_arg(directory);
    try leftovers.add_arg("-name");
    try leftovers.add_arg(".sun-capture-*");
    var found = try command(leftovers);
    if (not found.is_empty()) {
      return SystemResult.Error(Error(1, "Capture leaked a private output file"));
    }
    return SystemResult.Ok;
  }

  /** Window streams without padding retain their exact size through both output formats. */
  test_function window_capture() std.test.AssertionResult<void> {
    try encode(false, false, false, false, false, 321, 241, true);
    try encode(true, false, false, false, false, 321, 241, true);
    return std.test.AssertionResult.Ok;
  }

  /** A single frame produces a readable lossless screenshot. */
  test_function screenshot() std.test.AssertionResult<void> {
    try encode(false, false, false, false, false, 320, 240, false);
    return std.test.AssertionResult.Ok;
  }

  /** Stopping drains the encoder and writes a readable WebM trailer. */
  test_function recording() std.test.AssertionResult<void> {
    try encode(true, false, false, false, false, 320, 240, false);
    return std.test.AssertionResult.Ok;
  }

  /** The Linux pipeline publishes the combined recording only after both encoders finish. */
  test_function presenter_recording() std.test.AssertionResult<void> {
    var capture = try capture_backend.Capture(true, false, false, true, 0);
    capture.presenter.camera = true;
    capture.presenter.microphone = true;
    var directory = try String("build/capture-presenter-tests");
    var clock = std.time.now();
    var source = try String(
      "videotestsrc is-live=true name=source ! video/x-raw,width=320,height=240,framerate=30/1"
    );

    try capture.start(source, directory, true);
    clock = std.time.now();
    while (not capture.completed and clock.elapsed().as_secs() < 20) {
      try capture.tick();
      if (capture.recording and not capture.finishing and clock.elapsed().as_millis() > 800) {
        try capture.stop();
        try std.test.assert(not try std.io.is_file(capture.destination));
      }
      std.time.sleep(std.time.create_duration_millis(5));
    }
    try std.test.assert(capture.completed);
    var probe = try std.process.Command(make_heap_allocator(), "ffprobe");

    try probe.add_arg("-v");
    try probe.add_arg("error");
    try probe.add_arg("-show_entries");
    try probe.add_arg("stream=codec_name,width,height");
    try probe.add_arg("-of");
    try probe.add_arg("csv=p=0");
    try probe.add_arg(capture.destination);
    var streams = try command(probe);
    try std.test.assert(streams.contains("h264,320,240") and streams.contains("aac"));
    return std.test.AssertionResult.Ok;
  }

  /** Repeated portal revocation finalizes the recording only once. */
  test_function revoked_recording() std.test.AssertionResult<void> {
    try encode(true, false, false, false, true, 320, 240, false);
    return std.test.AssertionResult.Ok;
  }

  /** Cancellation never publishes a partial recording. */
  test_function cancellation() std.test.AssertionResult<void> {
    try encode(true, true, false, false, false, 320, 240, false);
    return std.test.AssertionResult.Ok;
  }

  /** Odd region dimensions survive PNG encoding without padding or scaling. */
  test_function area_screenshot() std.test.AssertionResult<void> {
    try encode(false, false, true, false, false, 320, 240, false);
    return std.test.AssertionResult.Ok;
  }

  /** Odd video regions receive at most one padding pixel for H.264 encoding. */
  test_function area_recording() std.test.AssertionResult<void> {
    try encode(true, false, true, false, false, 320, 240, false);
    return std.test.AssertionResult.Ok;
  }

  /** Logical monitor coordinates scale to physical stream pixels. */
  test_function scaled_area() std.test.AssertionResult<void> {
    try encode(false, false, true, true, false, 320, 240, false);
    return std.test.AssertionResult.Ok;
  }

  /** Cancelling a cropped recording removes its private file. */
  test_function area_cancellation() std.test.AssertionResult<void> {
    try encode(true, true, true, false, false, 320, 240, false);
    return std.test.AssertionResult.Ok;
  }

  /** High-resolution screenshots retain source dimensions. */
  test_function screenshot_4k() std.test.AssertionResult<void> {
    try encode(false, false, false, false, false, 3840, 2160, false);
    return std.test.AssertionResult.Ok;
  }

  /** Full-HD recordings preserve the source resolution. */
  test_function recording_full_hd() std.test.AssertionResult<void> {
    try encode(true, false, false, false, false, 1920, 1080, false);
    return std.test.AssertionResult.Ok;
  }

  /** Compares decoded captures against deterministic full-resolution reference pixels. */
  test_function pixel_fidelity() std.test.AssertionResult<void> {
    var a = make_heap_allocator();
    for (var mode = 0; mode < 2; mode += 1) {
      var stamp = try desktop.filename_stamp();
      var directory = try `build/capture_tests-output/${stamp}`;
      var width = mode == 0 ? 3840 : 1920;
      var height = mode == 0 ? 2160 : 1080;
      var reference = desktop.Output();
      try reference.reserve(directory);
      var raw = try `${directory}/reference.raw`;
      var conversion = "";
      var pipeline = desktop.Pipeline();
      var empty = try String("");
      var description = try `videotestsrc name=source pattern=checkers-8 num-buffers=1 ! video/x-raw,format=RGB,width=${width},height=${height},framerate=30/1 ! ${conversion}fdsink name=output`;

      try pipeline.configure(description, reference, -1, empty, empty);
      try pipeline.play();
      var start = std.time.now();
      var done = false;
      while (not done and start.elapsed().as_secs() < 8) {
        done = try pipeline.poll() == 2;
        std.time.sleep(std.time.create_duration_millis(2));
      }
      try std.test.assert(done);
      pipeline.close();
      try reference.publish(raw);
      var capture = try capture_backend.Capture(mode == 1, false, false, true, 0);
      var source = try `videotestsrc name=source pattern=checkers-8 is-live=true ! video/x-raw,format=RGB,width=${width},height=${height},framerate=30/1`;

      try capture.start(source, directory, true);
      start = std.time.now();
      while (not capture.completed and start.elapsed().as_secs() < 8) {
        try capture.tick();
        if (mode == 1 and capture.recording and start.elapsed().as_millis() > 600) {
          try capture.stop();
        }
        std.time.sleep(std.time.create_duration_millis(2));
      }
      try std.test.assert(capture.completed);
      var compare = try std.process.Command(a, "ffmpeg");
      try compare.add_arg("-v");
      try compare.add_arg("info");
      try compare.add_arg("-f");
      try compare.add_arg("rawvideo");
      try compare.add_arg("-pixel_format");
      try compare.add_arg("rgb24");
      try compare.add_arg("-framerate");
      try compare.add_arg("30");
      try compare.add_arg("-video_size");
      try compare.add_arg(try `${width}x${height}`);
      try compare.add_arg("-i");
      try compare.add_arg(raw);
      try compare.add_arg("-i");
      try compare.add_arg(capture.destination);
      try compare.add_arg("-filter_complex_threads");
      try compare.add_arg("1");
      try compare.add_arg("-lavfi");
      // Compare recordings after their intentional chroma subsampling, using the encoder's matrix.
      try compare.add_arg(
        mode == 0 ? "[0:v]format=gbrp[reference];[1:v]format=gbrp[captured];[reference][captured]ssim" : "[0:v]scale=out_color_matrix=bt709:out_range=tv,format=yuv420p[reference];[1:v]format=yuv420p[captured];[reference][captured]ssim"
      );
      try compare.add_arg("-frames:v");
      try compare.add_arg("1");
      try compare.add_arg("-threads");
      try compare.add_arg("1");
      try compare.add_arg("-f");
      try compare.add_arg("null");
      try compare.add_arg("-");
      var result = try compare.output();
      try std.test.assert_eq(result.status(), 0);
      var diagnostic = try result.stderr().clone(a);
      if (mode == 0) {
        var decoded = try `${directory}/decoded.rgb`;
        var decode = try std.process.Command(a, "ffmpeg");
        try decode.add_arg("-v");
        try decode.add_arg("error");
        try decode.add_arg("-i");
        try decode.add_arg(capture.destination);
        try decode.add_arg("-frames:v");
        try decode.add_arg("1");
        try decode.add_arg("-pix_fmt");
        try decode.add_arg("rgb24");
        try decode.add_arg("-threads");
        try decode.add_arg("1");
        try decode.add_arg("-f");
        try decode.add_arg("rawvideo");
        try decode.add_arg(decoded);
        try command(decode);
        var identical = try std.process.Command(a, "cmp");
        try identical.add_arg(raw);
        try identical.add_arg(decoded);
        try command(identical);
        try std.test.assert(diagnostic.contains("All:1.000000"), "PNG changed the source pixels");
      } else {
        var faithful = diagnostic.contains("All:0.99") or diagnostic.contains("All:0.98") or
          diagnostic.contains("All:0.97") or diagnostic.contains("All:1.000000");
        if (not faithful) {
          std.io.eprintln(diagnostic);
        }
        try std.test.assert(faithful, "Recording lost source detail");
      }
    }
    return std.test.AssertionResult.Ok;
  }

  /** Finalizes a recording when source failure and portal closure arrive in either order. */
  function interrupted_recording(error_first: bool) std.test.AssertionResult<void> {
    var stamp = try desktop.filename_stamp();
    var directory = try `build/capture_tests-output/${stamp}`;
    var capture = try capture_backend.Capture(true, false, false, true, 0);
    var source = try String("videotestsrc is-live=true name=source");

    try capture.start(source, directory, true);
    var start = std.time.now();
    while (not capture.completed and start.elapsed().as_secs() < 8) {
      try capture.tick();
      if (capture.recording and not capture.finishing and start.elapsed().as_millis() > 500) {
        if (error_first) {
          try capture.pipeline_event(3);
          try capture.sharing_ended();
        } else {
          try capture.sharing_ended();
          try capture.pipeline_event(3);
        }
      }
      std.time.sleep(std.time.create_duration_millis(2));
    }
    try std.test.assert(capture.completed);
    return std.test.AssertionResult.Ok;
  }

  /** A source error before portal closure still drains the encoder. */
  test_function source_error_before_close() std.test.AssertionResult<void> {
    try interrupted_recording(true);
    return std.test.AssertionResult.Ok;
  }

  /** A late source error cannot interrupt already requested finalization. */
  test_function source_error_after_close() std.test.AssertionResult<void> {
    try interrupted_recording(false);
    return std.test.AssertionResult.Ok;
  }

  /** Runs until a native pipeline error propagates, bounding a broken test fixture. */
  function await_error(capture: ref capture_backend.Capture) SystemResult<void> {
    var start = std.time.now();
    while (not capture.completed and start.elapsed().as_secs() < 8) {
      try capture.tick();
      std.time.sleep(std.time.create_duration_millis(2));
    }
    return SystemResult.Ok;
  }

  /** An error downstream of the desktop source cannot publish incomplete output. */
  test_function output_error() std.test.AssertionResult<void> {
    var stamp = try desktop.filename_stamp();
    var directory = try `build/capture_tests-output/${stamp}`;
    var capture = try capture_backend.Capture(true, false, false, true, 0);
    var source = try String("videotestsrc is-live=true name=source ! identity error-after=15");

    try capture.start(source, directory, true);
    match await_error(capture) {
      SystemResult.Ok => {
        try std.test.fail("Pipeline error did not propagate");
      },
      SystemResult.Error(_) => {},
      SystemResult.Allocation(error) => {
        return std.test.AssertionResult.Allocation(error);
      },
      SystemResult.InvalidArgument(error) => {
        return std.test.AssertionResult.InvalidArgument(error);
      },
      SystemResult.Overflow(error) => {
        return std.test.AssertionResult.Overflow(error);
      }
    };
    try std.test.assert(not capture.completed);
    var published = try std.io.is_file(capture.destination);
    try std.test.assert(not published);
    return std.test.AssertionResult.Ok;
  }

  /** Delay validation rejects malformed, negative, and excessive arguments. */
  test_function delays() std.test.AssertionResult<void> {
    var invalid = try String("-1");
    match capture_backend.delay_seconds(invalid) {
      SystemResult.Ok(_) => {
        try std.test.fail("Accepted negative delay");
      },
      SystemResult.Error(_) => {},
      SystemResult.Allocation(error) => {
        return std.test.AssertionResult.Allocation(error);
      },
      SystemResult.InvalidArgument(error) => {
        return std.test.AssertionResult.InvalidArgument(error);
      },
      SystemResult.Overflow(error) => {
        return std.test.AssertionResult.Overflow(error);
      }
    };
    invalid = try String("3601");
    match capture_backend.delay_seconds(invalid) {
      SystemResult.Ok(_) => {
        try std.test.fail("Accepted excessive delay");
      },
      SystemResult.Error(_) => {},
      SystemResult.Allocation(error) => {
        return std.test.AssertionResult.Allocation(error);
      },
      SystemResult.InvalidArgument(error) => {
        return std.test.AssertionResult.InvalidArgument(error);
      },
      SystemResult.Overflow(error) => {
        return std.test.AssertionResult.Overflow(error);
      }
    };
    invalid = try String("1;true");
    match capture_backend.delay_seconds(invalid) {
      SystemResult.Ok(_) => {
        try std.test.fail("Accepted nonnumeric delay");
      },
      SystemResult.Error(_) => {},
      SystemResult.Allocation(error) => {
        return std.test.AssertionResult.Allocation(error);
      },
      SystemResult.InvalidArgument(error) => {
        return std.test.AssertionResult.InvalidArgument(error);
      },
      SystemResult.Overflow(error) => {
        return std.test.AssertionResult.Overflow(error);
      }
    };
    var capture = try capture_backend.Capture(false, false, false, true, 1);
    capture.countdown();
    if (capture.countdown_ready() or not capture.destination.is_empty()) {
      try std.test.fail("Countdown started capture early");
    }
    std.time.sleep(std.time.create_duration_millis(1050));
    if (not capture.countdown_ready()) {
      try std.test.fail("Countdown did not expire");
    }
    return std.test.AssertionResult.Ok;
  }

  /** An area cannot start a pipeline or reserve a file before selection. */
  test_function selection_required() std.test.AssertionResult<void> {
    var capture = try capture_backend.Capture(false, true, false, true, 0);
    var source = try String("videotestsrc name=source");
    var directory = try String("build/capture-unselected");
    match capture.start(source, directory, true) {
      SystemResult.Ok => {
        try std.test.fail("Captured without selection");
      },
      SystemResult.Error(_) => {},
      SystemResult.Allocation(error) => {
        return std.test.AssertionResult.Allocation(error);
      },
      SystemResult.InvalidArgument(error) => {
        return std.test.AssertionResult.InvalidArgument(error);
      },
      SystemResult.Overflow(error) => {
        return std.test.AssertionResult.Overflow(error);
      }
    };
    if (not capture.destination.is_empty()) {
      try std.test.fail("Reserved output before selection");
    }
    return std.test.AssertionResult.Ok;
  }

  /** Error recovery retains an owned partial file while ordinary cancellation still removes it. */
  test_function recovery_retains_partial_output() std.test.AssertionResult<void> {
    var path = try String("");
    if (true) {
      var output = desktop.Output();
      var directory = try String("build/capture-recovery-tests");
      try output.reserve(directory);
      path = try output.preserve();
      var content = try String("recoverable fragments");
      try std.io.write_string(path, content);
    }
    var saved = try std.io.read_to_string(make_heap_allocator(), path);
    try std.test.assert(saved.equals_literal("recoverable fragments"));
    try std.io.remove_file(path);
    return std.test.AssertionResult.Ok;
  }

  /** Publication cannot replace an existing destination and cleanup removes the private file. */
  test_function publication_collision() std.test.AssertionResult<void> {
    var stamp = try desktop.filename_stamp();
    var directory = try `build/capture_tests-output/${stamp}`;
    var output = desktop.Output();
    try output.reserve(directory);
    var destination = try `${directory}/existing.png`;
    var original = try String("keep me");
    try std.io.write_string(destination, original);
    match output.publish(destination) {
      SystemResult.Ok => {
        try std.test.fail("Replaced existing output");
      },
      SystemResult.Error(_) => {},
      SystemResult.Allocation(error) => {
        return std.test.AssertionResult.Allocation(error);
      },
      SystemResult.InvalidArgument(error) => {
        return std.test.AssertionResult.InvalidArgument(error);
      },
      SystemResult.Overflow(error) => {
        return std.test.AssertionResult.Overflow(error);
      }
    };
    var contents = try std.io.read_to_string(make_heap_allocator(), destination);
    if (not contents.equals(original)) {
      try std.test.fail("Existing output changed");
    }
    return std.test.AssertionResult.Ok;
  }
}

/** Provides the executable whose companion runs the capture test functions. */
function main() i32 {
  return 0;
}
manifest {
  libraries: [
    "stdlib.moon",
    "${namo-robotics/sun_gobject}/lib/sun_capture.moon"
  ],
  source_files: [
    "../src/results.sun",
    "../src/tools/capture_backend.sun",
    "../src/tools/recording.sun",
    "../src/process.sun"
  ]
}
