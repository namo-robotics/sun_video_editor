using std;

/** Checks real media conversion, path safety, cancellation, and invalid input handling. */
module video_tests {

  /** Propagates assertion failures and system diagnostics from media tests. */
  enum TestResult<T> { Ok(T), Assertion(std.test.AssertionError), System(Error) }

  /** Enforces the released tool versions required by the distribution packages. */
  test_function required_tool_versions() TestResult<void> {
    try std.test.assert(
      try video.supported_tool_version(
        try String("ffmpeg version 8.0.1-3ubuntu2 Copyright")
      )
    );
    try std.test.assert(
      try video.supported_tool_version(
        try String("ffprobe version 9.1 Copyright")
      )
    );
    try std.test.assert(
      not (try video.supported_tool_version(
        try String("ffmpeg version 7.1.5 Copyright")
      ))
    );
    try std.test.assert(
      not (try video.supported_tool_version(
        try String("ffprobe version N-12345-gabcdef")
      ))
    );
    try std.test.assert(
      not (try video.supported_tool_version(
        try String("ffmpeg version invalid")
      ))
    );
    try std.test.assert(
      not (try video.supported_tool_version(
        try String("unknown version 8.0")
      ))
    );
    return TestResult.Ok;
  }

  /** Resolves symlinks and missing output paths while preserving literal filenames. */
  test_function absolute_paths() TestResult<void> {
    var a = make_heap_allocator();
    var fixture = try video_fixtures.Fixture();
    var input = try video.absolute(fixture.input);
    var alias = fixture.path("alias.mov");
    var link = try std.process.Command(a, "ln");
    try link.add_arg("-s");
    try link.add_arg(input);
    try link.add_arg(alias);
    try video.capture(link);
    var resolved = try video.absolute(alias);
    try std.test.assert(resolved.equals(input));
    var output = fixture.path("missing/../output $name; 'clip'.mp4");
    var directory = try video.absolute(fixture.directory);
    try directory.append("/output $name; 'clip'.mp4");
    var destination = try video.absolute(output);
    try std.test.assert(destination.equals(directory));
    try std.test.assert(not std.io.is_file(destination));
    return TestResult.Ok;
  }

  /** Checks strict time parsing and rejects invalid trim ranges before encoding. */
  test_function time_validation() TestResult<void> {
    var time = try String("01:02:03.5");
    try std.test.assert_eq(try video.seconds(time), 3723.5);
    var invalid = (try String("-1|nan|1:60|1::2|1.2:03|1.2.3|inf")).split(
      make_heap_allocator(),
      b'|'
    );
    for (var value: ref String in invalid) {
      match video.seconds(value) {
        SystemResult.Error(_) => {},
        SystemResult.Ok(_) => {
          try std.test.assert(false, "invalid time accepted");
        }
      };
    }
    var settings = video.Settings();
    var media = video.Media();
    media.duration = 4.0;
    settings.start = try String("3");
    settings.end = try String("2");
    match video.trim_length(settings, media) {
      SystemResult.Error(_) => {},
      SystemResult.Ok(_) => {
        try std.test.assert(false);
      }
    };
    settings.end = try String("5");
    match video.trim_length(settings, media) {
      SystemResult.Error(_) => {},
      SystemResult.Ok(_) => {
        try std.test.assert(false);
      }
    };
    return TestResult.Ok;
  }

  /** Rejects overlapping kept sections and totals valid sections in source order. */
  test_function kept_section_validation() TestResult<void> {
    var settings = video.Settings();
    var media = video.Media();
    media.duration = 4.0;
    try settings.sections.push(
      video.Section(
        2,
        try String("3"),
        try String("4")
      )
    );

    try settings.sections.push(
      video.Section(
        1,
        try String("0"),
        try String("1")
      )
    );

    try std.test.assert_eq(try video.trim_length(settings, media), 2.0);
    var ordered = try video.kept_intervals(settings, media);
    try std.test.assert_eq(ordered[0].start, 0.0);
    try std.test.assert_eq(ordered[1].start, 3.0);
    settings.sections[1].end = try String("3.5");
    match video.trim_length(settings, media) {
      SystemResult.Error(_) => {},
      SystemResult.Ok(_) => {
        try std.test.assert(false, "overlapping sections accepted");
      }
    };
    settings.sections[1].end = try String("0");
    match video.trim_length(settings, media) {
      SystemResult.Error(_) => {},
      SystemResult.Ok(_) => {
        try std.test.assert(false, "empty section accepted");
      }
    };
    return TestResult.Ok;
  }

  /** Decodes one tiny RGB frame so an export can be checked for the correct source section. */
  function sample_color(path: const ref String, time: static_ptr<u8>) SystemResult<String> {
    var command = try std.process.Command(make_heap_allocator(), "ffmpeg");

    var flags = (try String("-v error -ss")).split_whitespace(
      make_heap_allocator()
    );
    for (var flag: ref String in flags) {
      try command.add_arg(flag);
    }
    try command.add_arg(time);
    try command.add_arg("-i");
    try command.add_arg(path);
    try command.add_arg("-frames:v");
    try command.add_arg("1");
    try command.add_arg("-vf");
    try command.add_arg("scale=2:2,format=rgb24");
    try command.add_arg("-threads");
    try command.add_arg("1");
    try command.add_arg("-f");
    try command.add_arg("rawvideo");
    try command.add_arg("pipe:1");
    var output = try command.output();
    if (output.status() != 0) {
      return SystemResult.Error(Error(1, "Cannot sample exported frame"));
    }
    return SystemResult.Ok(
      try output.stdout().clone(make_heap_allocator())
    );
  }

  /** Exports nonadjacent colored sections across all formats and checks video order and audio duration. */
  test_function joined_sections_export() TestResult<void> {
    var a = make_heap_allocator();
    var fixture = try video_fixtures.Fixture();
    var source = fixture.path("colored.mp4");
    var generate = try std.process.Command(a, "ffmpeg");
    var flags = (try String("-v error -f lavfi -i")).split_whitespace(
      a
    );
    for (var flag: ref String in flags) {
      try generate.add_arg(flag);
    }
    try generate.add_arg(
      "color=red:s=64x64:r=24:d=2[r];color=blue:s=64x64:r=24:d=2[b];[r][b]concat=n=2:v=1:a=0"
    );
    try generate.add_arg("-f");
    try generate.add_arg("lavfi");
    try generate.add_arg("-i");
    try generate.add_arg("sine=frequency=440:duration=4");
    try generate.add_arg("-c:v");
    try generate.add_arg("libx264");
    try generate.add_arg("-threads");
    try generate.add_arg("2");
    try generate.add_arg("-c:a");
    try generate.add_arg("aac");
    try generate.add_arg(source);
    try video.capture(generate);
    var job = video.Job();
    try job.probe(source);
    try video_fixtures.finish(job);
    var settings = video.Settings();
    settings.input = try source.clone(a);
    try settings.sections.push(
      video.Section(
        2,
        try String("3"),
        try String("4")
      )
    );

    try settings.sections.push(
      video.Section(
        1,
        try String("0"),
        try String("1")
      )
    );

    for (var format: i64 = 0; format < 6; format += 1) {
      settings.format = format;
      settings.output = try `${fixture.directory}/joined${String(video.extension(format))}`;
      try job.convert(settings);
      try video_fixtures.finish(job);
      try std.test.assert_eq(job.percent, 100);
      var probe = try video.probe_command(settings.output);
      var result = try video.parse_probe(try video.capture(probe));
      try std.test.assert(result.duration >= 1.9 and result.duration <= 2.2);
      try std.test.assert(result.audio.equals_literal("none") == (format == 5));
      var first = try sample_color(settings.output, "0.5");
      var last = try sample_color(settings.output, "1.5");
      try std.test.assert(first.length() >= 3 and last.length() >= 3);
      var red = match first.at(0) {
        AccessResult.Ok(value) => value,
        AccessResult.OutOfBounds(_) => 0
      };
      var blue = match last.at(2) {
        AccessResult.Ok(value) => value,
        AccessResult.OutOfBounds(_) => 0
      };
      try std.test.assert(
        red > 200 and blue > 200,
        "export did not join kept source sections in order"
      );
    }
    settings.format = 0;
    settings.audio = false;
    settings.output = fixture.path("joined-silent.mp4");
    try job.convert(settings);
    try video_fixtures.finish(job);
    var silent = try video.probe_command(settings.output);
    var result = try video.parse_probe(try video.capture(silent));
    try std.test.assert(result.audio.equals_literal("none"));
    return TestResult.Ok;
  }

  /** Reads fractional frame rates and falls back safely when metadata is unavailable. */
  test_function frame_rate_metadata() TestResult<void> {
    var fractional = try String(
      "{\"format\":{\"duration\":\"4\"},\"streams\":[{\"codec_type\":\"video\",\"width\":320,\"height\":240,\"avg_frame_rate\":\"30000/1001\"}]}"
    );

    var media = try video.parse_probe(fractional);
    try std.test.assert_eq(media.frame_rate_num, 30000);
    try std.test.assert_eq(media.frame_rate_den, 1001);
    var fallback = try String(
      "{\"format\":{\"duration\":\"4\"},\"streams\":[{\"codec_type\":\"video\",\"width\":320,\"height\":240,\"avg_frame_rate\":\"0/0\",\"r_frame_rate\":\"24/1\"}]}"
    );

    var nominal = try video.parse_probe(fallback);
    try std.test.assert_eq(nominal.frame_rate_num, 24);
    try std.test.assert_eq(nominal.frame_rate_den, 1);
    var invalid = try String(
      "{\"format\":{\"duration\":\"4\"},\"streams\":[{\"codec_type\":\"video\",\"width\":320,\"height\":240,\"avg_frame_rate\":\"-1/1\",\"r_frame_rate\":\"999999999999/1\"}]}"
    );

    var unknown = try video.parse_probe(invalid);
    try std.test.assert_eq(unknown.frame_rate_num, 0);
    return TestResult.Ok;
  }

  /** Rejects HDR and missing metadata rather than producing an incorrect SDR conversion. */
  test_function metadata_validation() TestResult<void> {
    var hdr = try String(
      "{\"format\":{\"duration\":\"4\",\"size\":\"100\"},\"streams\":[{\"codec_type\":\"video\",\"width\":320,\"height\":240,\"color_transfer\":\"smpte2084\"}]}"
    );

    match video.parse_probe(hdr) {
      SystemResult.Error(_) => {},
      SystemResult.Ok(_) => {
        try std.test.assert(false);
      }
    };
    var bad = try String("{}");
    match video.parse_probe(bad) {
      SystemResult.Error(_) => {},
      SystemResult.Ok(_) => {
        try std.test.assert(false);
      }
    };
    return TestResult.Ok;
  }

  /** Converts a trimmed MOV to MP4, checks media properties, then exports a silent MOV. */
  test_function conversion_and_audio() TestResult<void> {
    var a = make_heap_allocator();
    var fixture = try video_fixtures.Fixture();
    var job = video.Job();
    try job.probe(fixture.input);
    try video_fixtures.finish(job);
    try std.test.assert(job.ready and job.media.width == 320 and job.media.height == 240);
    try std.test.assert(job.media.audio.equals_literal("aac"));
    var settings = video.Settings();
    settings.input = try fixture.input.clone(a);
    settings.output = fixture.path("trimmed $out; file.mp4");
    settings.start = try String("0.5");
    settings.end = try String("2.5");
    settings.resolution = 3;
    try job.convert(settings);
    try video_fixtures.finish(job);
    try std.test.assert_eq(job.percent, 100);
    try std.test.assert(job.output_size > 0 and job.output_size < job.media.size);
    var result = video.Job();
    try result.probe(settings.output);
    try video_fixtures.finish(result);
    try std.test.assert(result.media.duration >= 1.9 and result.media.duration <= 2.1);
    try std.test.assert_eq(result.media.width, 320);
    try std.test.assert_eq(result.media.height, 240);
    try std.test.assert(
      result.media.codec.equals_literal("h264") and result.media.audio.equals_literal("aac")
    );
    settings.input = try settings.output.clone(a);
    settings.output = fixture.path("silent.mov");
    settings.format = 1;
    settings.audio = false;
    settings.start = try String("0");
    settings.end = try String("");
    try result.convert(settings);
    try video_fixtures.finish(result);
    var silent = video.Job();
    try silent.probe(settings.output);
    try video_fixtures.finish(silent);
    try std.test.assert(silent.media.audio.equals_literal("none"));
    settings.input = try settings.output.clone(a);
    settings.output = fixture.path("silent-to-mp4.mp4");
    settings.format = 0;
    settings.audio = true;
    try silent.convert(settings);
    try video_fixtures.finish(silent);
    try std.test.assert(std.io.exists(settings.output));
    return TestResult.Ok;
  }

  /** Encodes every format and quality level, checking real codecs, audio, and trim duration. */
  test_function formats_and_quality() TestResult<void> {
    var a = make_heap_allocator();
    var fixture = try video_fixtures.Fixture();
    var job = video.Job();
    try job.probe(fixture.input);
    try video_fixtures.finish(job);
    var settings = video.Settings();
    settings.input = try fixture.input.clone(a);
    settings.start = try String("0.5");
    settings.end = try String("1.5");
    for (var format: i64 = 0; format < 6; format += 1) {
      var largest: i64 = 0;
      settings.format = format;
      for (var quality: i64 = 0; quality < 5; quality += 1) {
        settings.quality = quality;
        settings.audio = quality != 4;
        settings.output = fixture.path("preset");
        try settings.output.append(try `-${format}-${quality}`);

        try settings.output.append(video.extension(format));
        try job.convert(settings);
        try video_fixtures.finish(job);
        try std.test.assert_eq(job.percent, 100);
        if (quality == 0) {
          largest = job.output_size;
        }
        if (quality == 3) {
          try std.test.assert(
            job.output_size < largest,
            "compression reduces fixture size with audio retained"
          );
        }
        var result = video.Job();
        try result.probe(settings.output);
        try video_fixtures.finish(result);
        try std.test.assert(result.media.duration >= 0.9 and result.media.duration <= 1.3);
        var codec = try String(
          format == 5 ? "gif" : (format == 2 ? "vp9" : (format == 4 ? "mpeg4" : "h264"))
        );

        var audio = try String(
          quality == 4 or format == 5 ? "none" : (format == 2 ? "opus" : (format == 4 ? "mp3" : "aac"))
        );

        try std.test.assert(result.media.codec.equals(codec));
        try std.test.assert(result.media.audio.equals(audio));
        try std.test.assert_eq(result.media.width, 320);
        try std.test.assert_eq(result.media.height, 240);
        if (format == 5) {
          var frames = try std.process.Command(a, "ffprobe");
          try frames.add_arg("-v");
          try frames.add_arg("error");
          try frames.add_arg("-ignore_loop");
          try frames.add_arg("1");
          try frames.add_arg("-count_frames");
          try frames.add_arg("-select_streams");
          try frames.add_arg("v:0");
          try frames.add_arg("-show_entries");
          try frames.add_arg("stream=nb_read_frames");
          try frames.add_arg("-of");
          try frames.add_arg("default=noprint_wrappers=1:nokey=1");
          try frames.add_arg(settings.output);
          var count = try video.capture(frames);
          var expected = quality == 0 ? 30 : (quality == 1 ? 24 : (quality == 2 ? 20 : (quality ==
            3 ? 15 : 10)));
          var number = match count.parse_i64() {
            Option.Some(value) => value,
            Option.None => 0
          };
          try std.test.assert_eq(number, expected);
        }
      }
    }
    return TestResult.Ok;
  }

  /** Keeps directory names intact and rejects unsupported preset values before encoding. */
  test_function format_paths_and_validation() TestResult<void> {
    var path = try String("/videos.mp4/clip.webm");
    var changed = try video.output_path(path, 3);
    try std.test.assert(changed.equals_literal("/videos.mp4/clip.mkv"));
    path = try String("/videos.mp4/clip");
    changed = try video.output_path(path, 4);
    try std.test.assert(changed.equals_literal("/videos.mp4/clip.avi"));
    changed = try video.output_path(changed, 5);
    try std.test.assert(changed.equals_literal("/videos.mp4/clip.gif"));
    changed = try video.output_path(changed, 0);
    try std.test.assert(changed.equals_literal("/videos.mp4/clip.mp4"));
    path = try String("");
    changed = try video.output_path(path, 2);
    try std.test.assert(changed.is_empty());
    var settings = video.Settings();
    var media = video.Media();
    media.duration = 4.0;
    for (var i: i64 = 0; i < 3; i += 1) {
      settings.format = i == 0 ? 6 : 0;
      settings.quality = i == 1 ? 5 : 2;
      settings.resolution = i == 2 ? 5 : 0;
      match video.trim_length(settings, media) {
        SystemResult.Error(_) => {},
        SystemResult.Ok(_) => {
          try std.test.assert(false, "invalid preset accepted");
        }
      };
    }
    return TestResult.Ok;
  }

  /** Preserves existing files and the source, including an alternative hard-link path. */
  test_function destination_protection() TestResult<void> {
    var a = make_heap_allocator();
    var fixture = try video_fixtures.Fixture();
    var job = video.Job();
    try job.probe(fixture.input);
    try video_fixtures.finish(job);
    var settings = video.Settings();
    settings.input = try fixture.input.clone(a);
    settings.output = fixture.path("existing.mp4");
    var sentinel = try String("keep this file");
    try std.io.write_string(settings.output, sentinel);
    match job.convert(settings) {
      SystemResult.Error(_) => {},
      SystemResult.Ok => {
        try std.test.assert(false);
      }
    };
    var retained = try std.io.read_to_string(a, settings.output);
    try std.test.assert(retained.equals(sentinel));
    settings.overwrite = true;
    try job.convert(settings);
    try video_fixtures.finish(job);
    try std.test.assert(job.output_size > 0);
    var alias = fixture.path("alias.mp4");
    var link = try std.process.Command(a, "ln");
    try link.add_arg(fixture.input);
    try link.add_arg(alias);
    try video.capture(link);
    settings.output = alias;
    match job.convert(settings) {
      SystemResult.Error(_) => {},
      SystemResult.Ok => {
        try std.test.assert(false);
      }
    };
    settings.output = try fixture.input.clone(a);
    settings.format = 1;
    match job.convert(settings) {
      SystemResult.Error(_) => {},
      SystemResult.Ok => {
        try std.test.assert(false);
      }
    };
    return TestResult.Ok;
  }

  /** Cancels real work and verifies that partial exports and child processes do not survive. */
  test_function cancellation_and_failure() TestResult<void> {
    var a = make_heap_allocator();
    var fixture = try video_fixtures.Fixture();
    var job = video.Job();
    try job.probe(fixture.input);
    try video_fixtures.finish(job);
    var settings = video.Settings();
    settings.input = try fixture.input.clone(a);
    settings.output = fixture.path("cancelled.mp4");
    try job.convert(settings);
    job.cancel();
    try video_fixtures.finish(job);
    try std.test.assert(
      job.cancelled and not job.process.running and not std.io.exists(settings.output)
    );
    var before = try std.io.read_dir(a, fixture.directory);
    try std.test.assert_eq(before.size(), 1);
    var corrupt = try String("not a video");
    try std.io.write_string(fixture.input, corrupt);
    try job.convert(settings);
    match video_fixtures.finish(job) {
      SystemResult.Error(error) => {
        job.fail(error);
      },
      SystemResult.Ok => {
        try std.test.assert(false, "corrupt source unexpectedly converted");
      }
    };
    try std.test.assert(not std.io.exists(settings.output) and not job.process.running);
    var after = try std.io.read_dir(a, fixture.directory);
    try std.test.assert_eq(after.size(), 1);
    return TestResult.Ok;
  }

  /** Checks display rotation and downscaling against metadata of actual encoded outputs. */
  test_function rotation_and_resizing() TestResult<void> {
    var a = make_heap_allocator();
    var fixture = try video_fixtures.Fixture();
    var rotated = fixture.path("rotated.mov");
    var remux = try std.process.Command(a, "ffmpeg");
    try remux.add_arg("-v");
    try remux.add_arg("error");
    try remux.add_arg("-display_rotation");
    try remux.add_arg("90");
    try remux.add_arg("-i");
    try remux.add_arg(fixture.input);
    try remux.add_arg("-c");
    try remux.add_arg("copy");
    try remux.add_arg(rotated);
    try video.capture(remux);
    var job = video.Job();
    try job.probe(rotated);
    try video_fixtures.finish(job);
    var settings = video.Settings();
    settings.input = rotated;
    settings.output = fixture.path("upright.mp4");
    try job.convert(settings);
    try video_fixtures.finish(job);
    var upright = video.Job();
    try upright.probe(settings.output);
    try video_fixtures.finish(upright);
    try std.test.assert_eq(upright.media.width, 240);
    try std.test.assert_eq(upright.media.height, 320);
    var large = fixture.path("large.mov");
    var enlarge = try std.process.Command(a, "ffmpeg");
    try enlarge.add_arg("-v");
    try enlarge.add_arg("error");
    try enlarge.add_arg("-i");
    try enlarge.add_arg(fixture.input);
    try enlarge.add_arg("-t");
    try enlarge.add_arg("1");
    try enlarge.add_arg("-vf");
    try enlarge.add_arg("scale=1280:960");
    try enlarge.add_arg("-threads");
    try enlarge.add_arg("2");
    try enlarge.add_arg("-filter_threads");
    try enlarge.add_arg("1");
    try enlarge.add_arg(large);
    try video.capture(enlarge);
    try job.probe(large);
    try video_fixtures.finish(job);
    settings.input = large;
    settings.output = fixture.path("smaller.mp4");
    settings.resolution = 3;
    try job.convert(settings);
    try video_fixtures.finish(job);
    var smaller = video.Job();
    try smaller.probe(settings.output);
    try video_fixtures.finish(smaller);
    try std.test.assert_eq(smaller.media.width, 720);
    try std.test.assert_eq(smaller.media.height, 540);
    settings.resolution = 4;
    settings.output = fixture.path("480.mp4");
    try job.convert(settings);
    try video_fixtures.finish(job);
    try smaller.probe(settings.output);
    try video_fixtures.finish(smaller);
    try std.test.assert_eq(smaller.media.width, 480);
    try std.test.assert_eq(smaller.media.height, 360);
    settings.format = 5;
    settings.output = fixture.path("480.gif");
    try job.convert(settings);
    try video_fixtures.finish(job);
    try smaller.probe(settings.output);
    try video_fixtures.finish(smaller);
    try std.test.assert_eq(smaller.media.width, 480);
    try std.test.assert_eq(smaller.media.height, 360);
    settings.format = 0;
    settings.resolution = 1;
    settings.output = fixture.path("2160.mp4");
    try job.convert(settings);
    try video_fixtures.finish(job);
    try smaller.probe(settings.output);
    try video_fixtures.finish(smaller);
    try std.test.assert_eq(smaller.media.width, 1280);
    try std.test.assert_eq(smaller.media.height, 960);
    return TestResult.Ok;
  }

  /** Stops and reaps an in-flight child and cleans partial files when its owner leaves scope. */
  test_function shutdown_and_publication_race() TestResult<void> {
    var a = make_heap_allocator();
    var fixture = try video_fixtures.Fixture();
    var settings = video.Settings();
    settings.input = try fixture.input.clone(a);
    settings.output = fixture.path("shutdown.mp4");
    if (true) {
      var job = video.Job();
      try job.probe(fixture.input);
      try video_fixtures.finish(job);
      try job.convert(settings);
    }
    try std.test.assert(not std.io.exists(settings.output));
    var files = try std.io.read_dir(a, fixture.directory);
    try std.test.assert_eq(files.size(), 1);
    var job = video.Job();
    try job.probe(fixture.input);
    try video_fixtures.finish(job);
    try job.convert(settings);
    var sentinel = try String("created while conversion was running");

    try std.io.write_string(settings.output, sentinel);
    match video_fixtures.finish(job) {
      SystemResult.Error(error) => {
        job.fail(error);
      },
      SystemResult.Ok => {
        try std.test.assert(false, "existing output was overwritten without consent");
      }
    };
    var retained = try std.io.read_to_string(a, settings.output);
    try std.test.assert(retained.equals(sentinel));
    var after = try std.io.read_dir(a, fixture.directory);
    try std.test.assert_eq(after.size(), 2);
    return TestResult.Ok;
  }
}
