using std;

/** Checks real media conversion, path safety, cancellation, and invalid input handling. */
module video_tests {

  /** Propagates assertion failures and system diagnostics from media tests. */
  enum TestResult<T> { Ok(T), Assertion(std.test.AssertionError), System(Error) }

  /** Enforces the released tool versions required by the distribution packages. */
  test_function required_tool_versions() TestResult<void> {
    try std.test.assert(video.supported_tool_version(String("ffmpeg version 8.0.1-3ubuntu2 Copyright")));
    try std.test.assert(video.supported_tool_version(String("ffprobe version 9.1 Copyright")));
    try std.test.assert(not video.supported_tool_version(String("ffmpeg version 7.1.5 Copyright")));
    try std.test.assert(not video.supported_tool_version(String("ffprobe version N-12345-gabcdef")));
    try std.test.assert(not video.supported_tool_version(String("ffmpeg version invalid")));
    try std.test.assert(not video.supported_tool_version(String("unknown version 8.0")));
    return TestResult.Ok;
  }

  /** Checks strict time parsing and rejects invalid trim ranges before encoding. */
  test_function time_validation() TestResult<void> {
    var time = String("01:02:03.5");
    try std.test.assert_eq(try video.seconds(time), 3723.5);
    var invalid = String("-1|nan|1:60|1::2|1.2:03|1.2.3|inf").split(make_heap_allocator(), b'|');
    for (var value: ref String in invalid) {
      match video.seconds(value) {
        SystemResult.Error(_) => {},
        SystemResult.Ok(_) => {
          try std.test.assert(false, "invalid time accepted");
        }
      };
    }
    var settings = video.Settings();
    var media = video.Media();
    media.duration = 4.0;
    settings.start = String("3");
    settings.end = String("2");
    match video.trim_length(settings, media) {
      SystemResult.Error(_) => {},
      SystemResult.Ok(_) => {
        try std.test.assert(false);
      }
    };
    settings.end = String("5");
    match video.trim_length(settings, media) {
      SystemResult.Error(_) => {},
      SystemResult.Ok(_) => {
        try std.test.assert(false);
      }
    };
    return TestResult.Ok;
  }

  /** Rejects HDR and missing metadata rather than producing an incorrect SDR conversion. */
  test_function metadata_validation() TestResult<void> {
    var hdr = String("{\"format\":{\"duration\":\"4\",\"size\":\"100\"},\"streams\":[{\"codec_type\":\"video\",\"width\":320,\"height\":240,\"color_transfer\":\"smpte2084\"}]}");
    match video.parse_probe(hdr) {
      SystemResult.Error(_) => {},
      SystemResult.Ok(_) => {
        try std.test.assert(false);
      }
    };
    var bad = String("{}");
    match video.parse_probe(bad) {
      SystemResult.Error(_) => {},
      SystemResult.Ok(_) => {
        try std.test.assert(false);
      }
    };
    return TestResult.Ok;
  }

  /** Converts a trimmed MOV to MP4, checks media properties, then exports a silent MOV. */
  test_function conversion_and_audio() TestResult<void> {
    var a = make_heap_allocator();
    var fixture = try video_fixtures.Fixture();
    var job = video.Job();
    try job.probe(fixture.input);
    try video_fixtures.finish(job);
    try std.test.assert(job.ready and job.media.width == 320 and job.media.height == 240);
    try std.test.assert(job.media.audio.equals_literal("aac"));
    var settings = video.Settings();
    settings.input = fixture.input.clone(a);
    settings.output = fixture.path("trimmed $out; file.mp4");
    settings.start = String("0.5");
    settings.end = String("2.5");
    settings.resolution = 3;
    try job.convert(settings);
    try video_fixtures.finish(job);
    try std.test.assert_eq(job.percent, 100);
    try std.test.assert(job.output_size > 0 and job.output_size < job.media.size);
    var result = video.Job();
    try result.probe(settings.output);
    try video_fixtures.finish(result);
    try std.test.assert(result.media.duration >= 1.9 and result.media.duration <= 2.1);
    try std.test.assert_eq(result.media.width, 320);
    try std.test.assert_eq(result.media.height, 240);
    try std.test.assert(result.media.codec.equals_literal("h264") and result.media.audio.equals_literal("aac"));
    settings.input = settings.output.clone(a);
    settings.output = fixture.path("silent.mov");
    settings.format = 1;
    settings.audio = false;
    settings.start = String("0");
    settings.end = String("");
    try result.convert(settings);
    try video_fixtures.finish(result);
    var silent = video.Job();
    try silent.probe(settings.output);
    try video_fixtures.finish(silent);
    try std.test.assert(silent.media.audio.equals_literal("none"));
    settings.input = settings.output.clone(a);
    settings.output = fixture.path("silent-to-mp4.mp4");
    settings.format = 0;
    settings.audio = true;
    try silent.convert(settings);
    try video_fixtures.finish(silent);
    try std.test.assert(std.io.exists(settings.output));
    return TestResult.Ok;
  }

  /** Encodes every format and quality level, checking real codecs, audio, and trim duration. */
  test_function formats_and_quality() TestResult<void> {
    var a = make_heap_allocator();
    var fixture = try video_fixtures.Fixture();
    var job = video.Job();
    try job.probe(fixture.input);
    try video_fixtures.finish(job);
    var settings = video.Settings();
    settings.input = fixture.input.clone(a);
    settings.start = String("0.5");
    settings.end = String("1.5");
    for (var format: i64 = 0; format < 5; format += 1) {
      var largest: i64 = 0;
      settings.format = format;
      for (var quality: i64 = 0; quality < 5; quality += 1) {
        settings.quality = quality;
        settings.audio = quality != 4;
        settings.output = fixture.path("preset");
        settings.output.append(`-${format}-${quality}`);
        settings.output.append(video.extension(format));
        try job.convert(settings);
        try video_fixtures.finish(job);
        try std.test.assert_eq(job.percent, 100);
        if (quality == 0) {
          largest = job.output_size;
        }
        if (quality == 3) {
          try std.test.assert(job.output_size < largest, "compression reduces fixture size with audio retained");
        }
        var result = video.Job();
        try result.probe(settings.output);
        try video_fixtures.finish(result);
        try std.test.assert(result.media.duration >= 0.9 and result.media.duration <= 1.3);
        var codec = String(format == 2 ? "vp9" : (format == 4 ? "mpeg4" : "h264"));
        var audio = String(quality == 4 ? "none" : (format == 2 ? "opus" : (format == 4 ? "mp3" : "aac")));
        try std.test.assert(result.media.codec.equals(codec));
        try std.test.assert(result.media.audio.equals(audio));
        try std.test.assert_eq(result.media.width, 320);
        try std.test.assert_eq(result.media.height, 240);
      }
    }
    return TestResult.Ok;
  }

  /** Keeps directory names intact and rejects unsupported preset values before encoding. */
  test_function format_paths_and_validation() TestResult<void> {
    var path = String("/videos.mp4/clip.webm");
    var changed = video.output_path(path, 3);
    try std.test.assert(changed.equals_literal("/videos.mp4/clip.mkv"));
    path = String("/videos.mp4/clip");
    changed = video.output_path(path, 4);
    try std.test.assert(changed.equals_literal("/videos.mp4/clip.avi"));
    path = String("");
    changed = video.output_path(path, 2);
    try std.test.assert(changed.is_empty());
    var settings = video.Settings();
    var media = video.Media();
    media.duration = 4.0;
    for (var i: i64 = 0; i < 3; i += 1) {
      settings.format = i == 0 ? 5 : 0;
      settings.quality = i == 1 ? 5 : 2;
      settings.resolution = i == 2 ? 5 : 0;
      match video.trim_length(settings, media) {
        SystemResult.Error(_) => {},
        SystemResult.Ok(_) => {
          try std.test.assert(false, "invalid preset accepted");
        }
      };
    }
    return TestResult.Ok;
  }

  /** Preserves existing files and the source, including an alternative hard-link path. */
  test_function destination_protection() TestResult<void> {
    var a = make_heap_allocator();
    var fixture = try video_fixtures.Fixture();
    var job = video.Job();
    try job.probe(fixture.input);
    try video_fixtures.finish(job);
    var settings = video.Settings();
    settings.input = fixture.input.clone(a);
    settings.output = fixture.path("existing.mp4");
    var sentinel = String("keep this file");
    try std.io.write_string(settings.output, sentinel);
    match job.convert(settings) {
      SystemResult.Error(_) => {},
      SystemResult.Ok => {
        try std.test.assert(false);
      }
    };
    var retained = try std.io.read_to_string(a, settings.output);
    try std.test.assert(retained.equals(sentinel));
    settings.overwrite = true;
    try job.convert(settings);
    try video_fixtures.finish(job);
    try std.test.assert(job.output_size > 0);
    var alias = fixture.path("alias.mp4");
    var link = std.process.Command(a, "ln");
    link.add_arg(fixture.input);
    link.add_arg(alias);
    try video.capture(link);
    settings.output = alias;
    match job.convert(settings) {
      SystemResult.Error(_) => {},
      SystemResult.Ok => {
        try std.test.assert(false);
      }
    };
    settings.output = fixture.input.clone(a);
    settings.format = 1;
    match job.convert(settings) {
      SystemResult.Error(_) => {},
      SystemResult.Ok => {
        try std.test.assert(false);
      }
    };
    return TestResult.Ok;
  }

  /** Cancels real work and verifies that partial exports and child processes do not survive. */
  test_function cancellation_and_failure() TestResult<void> {
    var a = make_heap_allocator();
    var fixture = try video_fixtures.Fixture();
    var job = video.Job();
    try job.probe(fixture.input);
    try video_fixtures.finish(job);
    var settings = video.Settings();
    settings.input = fixture.input.clone(a);
    settings.output = fixture.path("cancelled.mp4");
    try job.convert(settings);
    job.cancel();
    try video_fixtures.finish(job);
    try std.test.assert(job.cancelled and not job.process.running and not std.io.exists(settings.output));
    var before = try std.io.read_dir(a, fixture.directory);
    try std.test.assert_eq(before.size(), 1);
    var corrupt = String("not a video");
    try std.io.write_string(fixture.input, corrupt);
    try job.convert(settings);
    match video_fixtures.finish(job) {
      SystemResult.Error(error) => {
        job.fail(error);
      },
      SystemResult.Ok => {
        try std.test.assert(false, "corrupt source unexpectedly converted");
      }
    };
    try std.test.assert(not std.io.exists(settings.output) and not job.process.running);
    var after = try std.io.read_dir(a, fixture.directory);
    try std.test.assert_eq(after.size(), 1);
    return TestResult.Ok;
  }

  /** Checks display rotation and downscaling against metadata of actual encoded outputs. */
  test_function rotation_and_resizing() TestResult<void> {
    var a = make_heap_allocator();
    var fixture = try video_fixtures.Fixture();
    var rotated = fixture.path("rotated.mov");
    var remux = std.process.Command(a, "ffmpeg");
    remux.add_arg("-v");
    remux.add_arg("error");
    remux.add_arg("-display_rotation");
    remux.add_arg("90");
    remux.add_arg("-i");
    remux.add_arg(fixture.input);
    remux.add_arg("-c");
    remux.add_arg("copy");
    remux.add_arg(rotated);
    try video.capture(remux);
    var job = video.Job();
    try job.probe(rotated);
    try video_fixtures.finish(job);
    var settings = video.Settings();
    settings.input = rotated;
    settings.output = fixture.path("upright.mp4");
    try job.convert(settings);
    try video_fixtures.finish(job);
    var upright = video.Job();
    try upright.probe(settings.output);
    try video_fixtures.finish(upright);
    try std.test.assert_eq(upright.media.width, 240);
    try std.test.assert_eq(upright.media.height, 320);
    var large = fixture.path("large.mov");
    var enlarge = std.process.Command(a, "ffmpeg");
    enlarge.add_arg("-v");
    enlarge.add_arg("error");
    enlarge.add_arg("-i");
    enlarge.add_arg(fixture.input);
    enlarge.add_arg("-t");
    enlarge.add_arg("1");
    enlarge.add_arg("-vf");
    enlarge.add_arg("scale=1280:960");
    enlarge.add_arg("-threads");
    enlarge.add_arg("2");
    enlarge.add_arg("-filter_threads");
    enlarge.add_arg("1");
    enlarge.add_arg(large);
    try video.capture(enlarge);
    try job.probe(large);
    try video_fixtures.finish(job);
    settings.input = large;
    settings.output = fixture.path("smaller.mp4");
    settings.resolution = 3;
    try job.convert(settings);
    try video_fixtures.finish(job);
    var smaller = video.Job();
    try smaller.probe(settings.output);
    try video_fixtures.finish(smaller);
    try std.test.assert_eq(smaller.media.width, 720);
    try std.test.assert_eq(smaller.media.height, 540);
    settings.resolution = 4;
    settings.output = fixture.path("480.mp4");
    try job.convert(settings);
    try video_fixtures.finish(job);
    try smaller.probe(settings.output);
    try video_fixtures.finish(smaller);
    try std.test.assert_eq(smaller.media.width, 480);
    try std.test.assert_eq(smaller.media.height, 360);
    settings.resolution = 1;
    settings.output = fixture.path("2160.mp4");
    try job.convert(settings);
    try video_fixtures.finish(job);
    try smaller.probe(settings.output);
    try video_fixtures.finish(smaller);
    try std.test.assert_eq(smaller.media.width, 1280);
    try std.test.assert_eq(smaller.media.height, 960);
    return TestResult.Ok;
  }

  /** Stops and reaps an in-flight child and cleans partial files when its owner leaves scope. */
  test_function shutdown_and_publication_race() TestResult<void> {
    var a = make_heap_allocator();
    var fixture = try video_fixtures.Fixture();
    var settings = video.Settings();
    settings.input = fixture.input.clone(a);
    settings.output = fixture.path("shutdown.mp4");
    if (true) {
      var job = video.Job();
      try job.probe(fixture.input);
      try video_fixtures.finish(job);
      try job.convert(settings);
    }
    try std.test.assert(not std.io.exists(settings.output));
    var files = try std.io.read_dir(a, fixture.directory);
    try std.test.assert_eq(files.size(), 1);
    var job = video.Job();
    try job.probe(fixture.input);
    try video_fixtures.finish(job);
    try job.convert(settings);
    var sentinel = String("created while conversion was running");
    try std.io.write_string(settings.output, sentinel);
    match video_fixtures.finish(job) {
      SystemResult.Error(error) => {
        job.fail(error);
      },
      SystemResult.Ok => {
        try std.test.assert(false, "existing output was overwritten without consent");
      }
    };
    var retained = try std.io.read_to_string(a, settings.output);
    try std.test.assert(retained.equals(sentinel));
    var after = try std.io.read_dir(a, fixture.directory);
    try std.test.assert_eq(after.size(), 2);
    return TestResult.Ok;
  }
}
