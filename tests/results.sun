using std;

/** Checks byte-range copies independently of GTK and media tools. */
module result_checks {

  /** Copies UTF-8 bytes and accepts an empty range at the end of the input. */
  test_function substring_valid_ranges() {
    var a = make_heap_allocator();
    var text = String("aéz");
    var middle = sun_video_editor_results.substring(text, a, 1, 2);
    std.test.assert(middle.equals_literal("é"));
    var empty = sun_video_editor_results.substring(text, a, text.length(), 0);
    std.test.assert(empty.is_empty());
  }

  /** Rejects negative, oversized, and overflowing ranges before copying bytes. */
  test_function substring_invalid_ranges() {
    var a = make_heap_allocator();
    var text = String("abc");
    for (var i: i64 = 0; i < 4; i += 1) {
      var start: i64 = i == 0 ? -1 : (i == 2 ? 4 : 1);
      var count: i64 = i == 1 ? -1 : (i == 3 ? 9223372036854775807 : 0);
      var rejected = false;
      try {
        sun_video_editor_results.substring(text, a, start, count);
      } catch (error: IndexOutOfBoundsError) {
        rejected = true;
      }
      std.test.assert(rejected, "Invalid range accepted");
    }
  }
}
